// Auto-generated by GTA5 Mission Pipeline — MinigameServices hub — DO NOT EDIT
// Shared companion for all generated minigames. Deterministic content: every
// minigame write emits this same file, so repeated installs are idempotent.
//
// SHVDN3 compiles each raw .cs into its own assembly, so this hub never
// references minigame classes directly — it couples through their .ini files
// on disk (any scripts/*.ini with a [Minigame] section is a leaderboard entry).
//
// F9 toggles a leaderboard overlay of every installed minigame's best score.

using System;
using System.Collections.Generic;
using System.IO;
using System.Windows.Forms;
using GTA;
using GTA.Native;

public class MinigameServices : Script
{
    private struct Entry
    {
        public string Name; public string Metric; public string Label; public int Best;
    }

    private bool _overlayOpen = false;
    private readonly List<Entry> _entries = new List<Entry>();

    public MinigameServices()
    {
        Tick    += OnTick;
        KeyDown += OnKeyDown;
    }

    private void OnKeyDown(object sender, KeyEventArgs e)
    {
        if (e.KeyCode != Keys.F9) return;
        _overlayOpen = !_overlayOpen;
        if (_overlayOpen) ScanMinigames();
    }

    private void ScanMinigames()
    {
        _entries.Clear();
        try
        {
            foreach (string path in Directory.GetFiles("scripts", "*.ini"))
            {
                try
                {
                    var ini = ScriptSettings.Load(path);
                    string name = ini.GetValue("Minigame", "Name", "");
                    if (string.IsNullOrEmpty(name)) continue;   // not a minigame ini
                    _entries.Add(new Entry
                    {
                        Name   = name,
                        Metric = ini.GetValue("Minigame", "Metric", "points"),
                        Label  = ini.GetValue("Minigame", "Label", "SCORE"),
                        Best   = ini.GetValue("Scores", "Best", 0),
                    });
                }
                catch
                {
                    // Unreadable ini — skip it, keep scanning.
                }
            }
            _entries.Sort((a, b) => string.CompareOrdinal(a.Name, b.Name));
        }
        catch
        {
            // scripts/ dir unreadable — overlay just shows the empty message.
        }
    }

    private void OnTick(object sender, EventArgs e)
    {
        if (!_overlayOpen) return;

        float rowH = 0.036f;
        int rows = Math.Max(1, _entries.Count);
        DrawRect(0.50f, 0.36f + rows * rowH * 0.5f, 0.46f, 0.10f + rows * rowH, 18, 18, 26, 225);
        DrawRect(0.50f, 0.30f, 0.46f, 0.05f, 120, 60, 160, 235);
        DrawText("MINIGAME LEADERBOARD", 0.50f, 0.282f, 0.62f, 255, 255, 255, 255, true);

        if (_entries.Count == 0)
        {
            DrawText("~c~No minigames installed (no [Minigame] .ini found).",
                0.50f, 0.36f, 0.36f, 200, 200, 200, 255, true);
        }
        else
        {
            for (int i = 0; i < _entries.Count; i++)
            {
                float y = 0.345f + i * rowH;
                DrawText("~w~" + _entries[i].Name, 0.30f, y, 0.38f, 255, 255, 255, 255, false);
                DrawText("~y~" + _entries[i].Label + ": ~w~" + _entries[i].Best
                    + " ~c~(" + _entries[i].Metric + ")",
                    0.60f, y, 0.38f, 255, 220, 120, 255, false);
            }
        }
        DrawText("F9 close", 0.50f, 0.345f + rows * rowH + 0.02f, 0.28f, 170, 170, 170, 255, true);
    }

    private static void DrawRect(float x, float y, float w, float h, int r, int g, int b, int a)
    {
        Function.Call(Hash.DRAW_RECT, x, y, w, h, r, g, b, a);
    }

    private static void DrawText(string text, float x, float y, float scale,
        int r, int g, int b, int a, bool center)
    {
        Function.Call(Hash.SET_TEXT_FONT, 0);
        Function.Call(Hash.SET_TEXT_SCALE, 0.0f, scale);
        Function.Call(Hash.SET_TEXT_COLOUR, r, g, b, a);
        Function.Call(Hash.SET_TEXT_CENTRE, center ? 1 : 0);
        Function.Call(Hash.SET_TEXT_WRAP, 0.0f, 1.0f);
        Function.Call(Hash.SET_TEXT_OUTLINE);
        Function.Call(Hash.BEGIN_TEXT_COMMAND_DISPLAY_TEXT, "STRING");
        Function.Call(Hash.ADD_TEXT_COMPONENT_SUBSTRING_PLAYER_NAME, text);
        Function.Call(Hash.END_TEXT_COMMAND_DISPLAY_TEXT, x, y);
    }
}
