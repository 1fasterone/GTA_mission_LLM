// Actor-owned stat modifiers. Generated by the deterministic composer.
using System;
using System.Collections.Generic;
using UnityEngine;
public sealed class StatModifier : MonoBehaviour
{
    private struct Entry {
        public string stat;
        public float magnitude, start, duration;
        public bool decay;
    }
    private readonly List<Entry> entries = new List<Entry>();
    private readonly HashSet<string> supported = new HashSet<string>(StringComparer.Ordinal);
    public void Support(string stat) { supported.Add(stat); }
    public void ApplyItem(float magnitude, string stat) { Apply(stat, magnitude); }
    // Additive fractions: 0.5 is +50%. Zero duration lasts for this actor's lifetime.
    public bool Apply(string stat, float magnitude, float duration = 0f, bool decay = false)
    {
        if (stat == null || !supported.Contains(stat) ||
            float.IsNaN(magnitude) || float.IsInfinity(magnitude) ||
            float.IsNaN(duration) || float.IsInfinity(duration) || duration < 0f ||
            (decay && duration == 0f)) {
            Debug.LogWarning("[stat.abstain] Unsupported stat or invalid modifier: " + stat, this);
            return false;
        }
        entries.Add(new Entry { stat = stat, magnitude = magnitude,
            start = Time.time, duration = duration, decay = decay });
        return true;
    }
    public float Read(string stat)
    {
        float total = 0f;
        for (int i = entries.Count - 1; i >= 0; --i) {
            var e = entries[i];
            float age = Mathf.Max(0f, Time.time - e.start);
            if (e.duration > 0f && age >= e.duration) { entries.RemoveAt(i); continue; }
            if (e.stat == stat) total += e.magnitude * (e.decay ? 1f - age / e.duration : 1f);
        }
        return total;
    }
}
