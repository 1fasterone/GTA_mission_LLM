// Auto-generated by Unity Project Pipeline — DO NOT EDIT
// Drives a rigged model's bones from the vehicle's motion. This is the reusable
// "bone driver" every mechanical base plugs into — it is convention-driven by
// bone NAME, so any new base whose rigger uses these role names is covered with
// no extra code:
//     Wheel.*            -> spin about the axle (front wheels also steer)
//     steer/handlebar/fork -> yaw with the steering input
//     prop/rotor/blade   -> continuous spin from throttle
// Humanoid skeletons carry none of these names, so the driver stands itself down
// on them (they are animated by the Unity Humanoid Animator instead).
//
// State source is HYBRID: if an IVehicleState is found on this object or a parent
// (the player's controller), its exact values are used; otherwise the driver
// derives speed from the Rigidbody/transform and steering from the input axis, so
// spawned traffic/enemies animate too.
using System.Collections.Generic;
using UnityEngine;

[DisallowMultipleComponent]
public class VehicleBoneDriver : MonoBehaviour
{
    [Tooltip("Max visual steer angle (degrees) at full steering input.")]
    [SerializeField] private float visualSteerAngle = 28f;
    [Tooltip("Propeller/rotor RPM at full throttle.")]
    [SerializeField] private float propRpmAtFullThrottle = 1800f;
    [Tooltip("Fallback wheel radius (m) when no IVehicleState supplies one.")]
    [SerializeField] private float wheelRadiusFallback = 0.4f;

    private IVehicleState _state;
    private Rigidbody _rb;
    private Transform _root;
    private Vector3 _lastPos;

    private class Driven
    {
        public Transform bone;
        public Quaternion restLocalRelRoot;   // rest rotation relative to the vehicle root
        public bool isWheel, isFront, isSteer, isProp;
        public float spin;                     // accumulated spin (deg)
    }
    private readonly List<Driven> _bones = new List<Driven>();

    private void Start()
    {
        _root = transform;
        _state = GetComponentInParent<IVehicleState>();
        _rb = GetComponentInParent<Rigidbody>();
        _lastPos = _root.position;

        foreach (var t in GetComponentsInChildren<Transform>(true))
        {
            // Only skinned BONES, never the mesh objects (those carry a Renderer);
            // rotating a mesh transform as well as its bone would double-move it.
            if (t.GetComponent<Renderer>() != null) continue;

            string n = t.name.ToLowerInvariant();
            var d = new Driven
            {
                bone = t,
                restLocalRelRoot = Quaternion.Inverse(_root.rotation) * t.rotation,
            };
            if (n.StartsWith("wheel"))
            {
                d.isWheel = true;
                d.isFront = n.Contains(".f") || n.Contains("front") || n.StartsWith("wheelf");
                _bones.Add(d);
            }
            else if (n.Contains("steer") || n.Contains("handlebar") || n.Contains("fork"))
            {
                d.isSteer = true;
                _bones.Add(d);
            }
            else if (n.Contains("prop") || n.Contains("rotor") || n.Contains("blade"))
            {
                d.isProp = true;
                _bones.Add(d);
            }
        }

        // No driveable bones (e.g. a humanoid) -> let the Animator own it.
        if (_bones.Count == 0) enabled = false;
    }

    private float ForwardSpeed()
    {
        if (_state != null) return _state.ForwardSpeed;
        if (_rb != null) return Vector3.Dot(_rb.linearVelocity, _root.forward);
        Vector3 d = _root.position - _lastPos;
        _lastPos = _root.position;
        return Vector3.Dot(d, _root.forward) / Mathf.Max(Time.deltaTime, 1e-4f);
    }

    private float Steer()
    {
        if (_state != null) return Mathf.Clamp(_state.SteerNormalized, -1f, 1f);
        return Mathf.Clamp(Input.GetAxis("Horizontal"), -1f, 1f);
    }

    private float Throttle()
    {
        if (_state != null) return Mathf.Clamp01(_state.ThrottleNormalized);
        return Mathf.Clamp01(Mathf.Abs(ForwardSpeed()) * 0.2f);
    }

    // LateUpdate: run after any Animator/controller so bone writes hold this frame.
    private void LateUpdate()
    {
        float speed    = ForwardSpeed();
        float steerDeg = Steer() * visualSteerAngle;
        float dt       = Time.deltaTime;
        float radius   = (_state != null && _state.WheelRadius > 0.01f)
                       ? _state.WheelRadius : wheelRadiusFallback;
        float spinDeg  = (speed / (2f * Mathf.PI * Mathf.Max(0.05f, radius))) * 360f * dt;
        float propDeg  = Throttle() * propRpmAtFullThrottle * 6f * dt;   // rpm*360/60

        Vector3 right = _root.right, up = _root.up, fwd = _root.forward;

        foreach (var d in _bones)
        {
            Quaternion baseWorld = _root.rotation * d.restLocalRelRoot;

            if (d.isWheel)
            {
                d.spin += spinDeg;
                Quaternion steerQ = d.isFront
                    ? Quaternion.AngleAxis(steerDeg, up) : Quaternion.identity;
                Vector3 axle = steerQ * right;                       // axle follows the steer
                d.bone.rotation = Quaternion.AngleAxis(d.spin, axle) * steerQ * baseWorld;
            }
            else if (d.isSteer)
            {
                d.bone.rotation = Quaternion.AngleAxis(steerDeg, up) * baseWorld;
            }
            else if (d.isProp)
            {
                d.spin += propDeg;
                d.bone.rotation = Quaternion.AngleAxis(d.spin, fwd) * baseWorld;
            }
        }
    }
}
