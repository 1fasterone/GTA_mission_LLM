        q.transform.SetParent(parent, false);
        q.transform.localScale    = size;
        q.transform.localPosition = localPos;
        var r = q.GetComponent<Renderer>();
        if (r != null) r.sharedMaterial = UiMaterial(sh, c);
        return q.transform;
    }

    /// <summary>A world-space caption. TextMesh rather than a Canvas: the board
    /// IS world space, so the text has to live on the card and move with it.</summary>
    private static void UiLabel(Transform parent, string text, float width, float z, Color c)
    {
        if (string.IsNullOrEmpty(text)) return;
        var go = new GameObject("Label");
        go.transform.SetParent(parent, false);
        go.transform.localPosition = new Vector3(0f, 0f, z);
        var tm = go.AddComponent<TextMesh>();
        tm.text          = text;
        tm.characterSize = 0.08f;
        tm.fontSize      = 72;
        tm.anchor        = TextAnchor.MiddleCenter;
        tm.alignment     = TextAlignment.Center;
        tm.color         = c;
        // Fit the caption to the card rather than letting it run off the edge:
        // a label wider than the thing it names reads as a rendering fault.
        var mr = go.GetComponent<MeshRenderer>();
        if (mr != null)
        {
            float w = mr.bounds.size.x;
            if (w > 0.001f && w > width * 0.86f)
                go.transform.localScale = Vector3.one * (width * 0.86f / w);
        }
    }

    /// <summary>"FolderContainers" → "Folder Containers", and the instance
    /// index appended when a group has more than one, so a board of six commits
    /// is six DISTINCT cards rather than the same word six times.</summary>
    private static string UiCaption(string groupName, int index, int count)
    {
        if (string.IsNullOrEmpty(groupName)) return "";
        var sb = new System.Text.StringBuilder(groupName.Length + 8);
        for (int i = 0; i < groupName.Length; i++)
        {
            char ch = groupName[i];
            if (i > 0 && char.IsUpper(ch) && !char.IsUpper(groupName[i - 1])) sb.Append(' ');
            if (ch == '_' || ch == '-') sb.Append(' '); else sb.Append(ch);
        }
        string label = sb.ToString().Trim();
        return count > 1 ? label + " " + (index + 1) : label;
    }

    /// <summary>Build one board control. `element` is the vocabulary from
    /// src/unity_layout_archetype.ui_element_of — the same table that decided
    /// this group's cell in the layout, so a group laid out as a panel is
    /// built as one.</summary>
    private GameObject BuildUIElement(string name, string element, string groupName,
                                      int index, int count, float scale,
                                      Color color, Shader sh)
    {
        var root = new GameObject(name);
        var t = root.transform;

        // Body / border / ink, derived from the group's own palette colour so
        // the board is this project's palette rather than a generic grey.
        Color body   = color;
        Color border = Color.Lerp(color, Color.white, 0.42f);
        Color ink    = color.grayscale > 0.5f ? new Color(0.10f, 0.11f, 0.14f)
                                              : new Color(0.96f, 0.97f, 1f);
        float w = 1f, h = 1f;
        bool  caption = true;

        switch (element)
        {
            case "window":
                // Body, a title bar across the top, an inset content well.
                w = 1.6f; h = 1.1f;
                UiPlate(t, "Body",  new Vector3(w, h, UiCardDepth), Vector3.zero, body, sh);
                UiPlate(t, "TitleBar",
                        new Vector3(w - UiBorderWidth * 2f, 0.17f, UiCardDepth * 0.9f),
                        new Vector3(0f, h * 0.5f - 0.115f, -UiCardDepth * 0.35f), border, sh);
                UiPlate(t, "Well",
                        new Vector3(w - 0.14f, h - 0.34f, UiCardDepth * 0.6f),
                        new Vector3(0f, -0.07f, -UiCardDepth * 0.2f),
                        Color.Lerp(body, Color.black, 0.35f), sh);
                break;
            case "panel":
                w = 1.25f; h = 1.0f;
                UiPlate(t, "Body", new Vector3(w, h, UiCardDepth), Vector3.zero, body, sh);
                UiPlate(t, "Header",
                        new Vector3(w - UiBorderWidth * 2f, 0.13f, UiCardDepth * 0.9f),
                        new Vector3(0f, h * 0.5f - 0.09f, -UiCardDepth * 0.35f), border, sh);
                break;
            case "list":
                // A body plus real rows — a list with no rows is a rectangle.
                w = 1.15f; h = 1.15f;
                UiPlate(t, "Body", new Vector3(w, h, UiCardDepth), Vector3.zero, body, sh);
                for (int r = 0; r < 4; r++)
                    UiPlate(t, "Row" + r,
                            new Vector3(w - 0.18f, 0.11f, UiCardDepth * 0.55f),
                            new Vector3(0f, h * 0.5f - 0.19f - r * 0.24f, -UiCardDepth * 0.3f),
                            Color.Lerp(body, border, r % 2 == 0 ? 0.55f : 0.3f), sh);
                break;
            case "button":
                // Raised face inside a recessed rim — the shape that says
                // "press me" without a single word of instruction.
                w = 0.95f; h = 0.42f;
                UiPlate(t, "Rim",  new Vector3(w, h, UiCardDepth * 0.7f), Vector3.zero,
                        Color.Lerp(body, Color.black, 0.3f), sh);
                UiPlate(t, "Face",
                        new Vector3(w - UiBorderWidth * 2f, h - UiBorderWidth * 2f, UiCardDepth),
                        new Vector3(0f, 0f, -UiCardDepth * 0.3f), border, sh);
                break;
            case "icon":
                // A rounded-feeling tile: a plate, a smaller contrasting mark.
                w = 0.6f; h = 0.6f;
                UiPlate(t, "Tile", new Vector3(w, h, UiCardDepth), Vector3.zero, body, sh);
                UiPlate(t, "Mark", new Vector3(w * 0.44f, h * 0.44f, UiCardDepth * 1.2f),
                        new Vector3(0f, 0f, -UiCardDepth * 0.4f), border, sh);
                caption = false;   // an icon grid captioned six times is noise
                break;
            case "label":
                // Text only. A label with a plate behind it is a card.
                w = 1.1f; h = 0.3f;
                break;
            default:   // "card" and anything the table has no shape for
                w = 0.95f; h = 1.25f;
                UiPlate(t, "Border", new Vector3(w, h, UiCardDepth * 0.8f), Vector3.zero, border, sh);
                UiPlate(t, "Body",
                        new Vector3(w - UiBorderWidth * 2f, h - UiBorderWidth * 2f, UiCardDepth),
                        new Vector3(0f, 0f, -UiCardDepth * 0.25f), body, sh);
                break;
        }

        if (caption)
            UiLabel(t, UiCaption(groupName, index, count), w, -UiCardDepth, ink);
        else if (element == "label")
            UiLabel(t, UiCaption(groupName, index, count), w, 0f, border);

        // ONE collider, on the root, covering the whole element — what the
        // pointer picks and what the interactable/trigger micros require.
        var bc = root.AddComponent<BoxCollider>();
        bc.size   = new Vector3(w, h, Mathf.Max(UiCardDepth * 2f, 0.12f));
        bc.center = Vector3.zero;
        return root;
    }
{% endif %}

    // A weapon entity is the player's HELD gun, not scenery. Left in the world
    // it spawns as an unreachable prop somewhere on the map and the player
    // appears empty-handed. Parent it to the first-person eye at a viewmodel
    // offset (down-right of centre) so it reads as held. No-op when there is no
    // player eye to mount on, so a dropped-weapon pickup stays where it spawned.
    private void MountIfWeapon(GameObject go, string kind)
    {
        if (go == null || kind != "weapon") return;
        // Pick the Player-tagged object that actually has an eye to mount on —
        // FindWithTag returns an arbitrary match when a prop shares the tag,
        // and mounting to scenery leaves the player empty-handed.
        Transform mount = null;
        foreach (var cand in GameObject.FindGameObjectsWithTag("Player"))
        {
            if (cand == null) continue;
            var e = cand.transform.Find("Eye");
            if (e != null) { mount = e; break; }
        }
        if (mount == null) return;
        go.transform.SetParent(mount, false);
        go.transform.localPosition = new Vector3(0.28f, -0.22f, 0.45f);
        go.transform.localRotation = Quaternion.identity;
        // Colliders on a viewmodel sit inside the player's own capsule and
        // would otherwise absorb the player's own aim raycast.
        foreach (var c in go.GetComponentsInChildren<Collider>()) c.enabled = false;
    }

{% if has_tiled_paths %}
    // Straight segments laid along curved polyline chords are stretched by
    // this factor so they overlap slightly instead of gapping at corners.
    private const float TILE_OVERLAP = 1.02f;

    // Tile a path-placed group END-TO-END along its polyline (path_width > 0
    // in the schema): the resolved model is width-normalized so its cross-
    // track axis spans pathWidth meters, the instance count derives from the
    // path's arc length / tile length (the authored count is only the
    // degradation fallback), and every segment is yawed to the local path
    // tangent — a continuous road ribbon / guardrail instead of scattered
    // pieces. Deterministic: same model bounds + same path → same transforms.
    private void SpawnTiledGroup(string groupName, string kind, int count, PrimitiveType shape,
                                 float spacing, float radius, float scale, Color color,
                                 string tag, string behavior, string modelPath,
                                 Vector3[] path, Shader sh, float pathWidth{% if has_banked_paths %}, float[] banks = null{% endif %})
    {
        GameObject modelPrefab = string.IsNullOrEmpty(modelPath)
            ? null : Resources.Load<GameObject>(modelPath);

        // Tile dimensions. Forward axis = the longer horizontal axis, with a
        // bias toward local Z (the glTF→FBX convert bakes axis_forward="-Z",
        // so near-square tiles should still travel along Z); width = the
        // other horizontal axis. Primitives have no meaningful bounds — they
        // become a thin stretched ribbon (tile length 2× the width).
        float forwardDim, widthDim, minY;
        bool forwardIsX = false, isPrimitive = modelPrefab == null;
        if (isPrimitive)
        {
            forwardDim = 2f; widthDim = 1f; minY = 0f;
        }
        else if (TryMeasureBounds(modelPrefab, out var mb)
                 && mb.size.x > 0.0001f && mb.size.z > 0.0001f)
        {
            if (mb.size.z >= mb.size.x * 0.9f) { forwardDim = mb.size.z; widthDim = mb.size.x; }
            else { forwardDim = mb.size.x; widthDim = mb.size.z; forwardIsX = true; }
            minY = mb.min.y;
        }
        else
        {
            // Model exists but can't be measured — degrade to the legacy
            // even-spread placement rather than guessing tile geometry.
            SpawnGroup(groupName, kind, count, shape, "path", spacing, radius, scale,
                       color, tag, behavior, modelPath, path, sh, 0f, null);
            return;
        }

        float uniform = pathWidth / widthDim;          // width-normalize
        float tileLen = forwardDim * uniform;          // world tile length
        float arc = ArcLength(path);
        int n = Mathf.Clamp(Mathf.RoundToInt(arc / tileLen), 1, 256);
        // Stretch each tile's forward axis so n tiles exactly cover the arc
        // (slot = arc/n), plus TILE_OVERLAP to hide chord gaps on corners.
        float stretch = arc / n / tileLen * TILE_OVERLAP;

        System.Type behaviorType = null;
        if (!string.IsNullOrEmpty(behavior))
            behaviorType = System.Type.GetType(behavior + ", Assembly-CSharp") ?? System.Type.GetType(behavior);

        var parent = new GameObject(groupName).transform;
        parent.SetParent(transform, false);
        for (int i = 0; i < n; i++)
        {
            GameObject go = isPrimitive
                ? GameObject.CreatePrimitive(shape)
                : Instantiate(modelPrefab);
            go.name = groupName + "_" + i;
            go.transform.SetParent(parent);

            float t = (i + 0.5f) / n;
            Vector3 pos = PointAlongPath(path, t);
            // Tangent from a symmetric sample around the tile center; yaw-only
            // (flattened) so elevation changes don't pitch the pieces. A 90°
            // correction maps X-forward models onto LookRotation's Z-forward.
            Vector3 ahead = PointAlongPath(path, Mathf.Clamp01(t + 0.5f / n));
            Vector3 behind = PointAlongPath(path, Mathf.Clamp01(t - 0.5f / n));
            Vector3 dir = ahead - behind; dir.y = 0f;
{% if has_banked_paths %}
            // Bank = roll about the direction of travel, lerped between path
            // points ([x, y, z, bank] schema convention: negative leans the
            // surface left, positive right). Applied in the path frame BEFORE
            // the model-axis correction so the surface tilts around the track
            // line, not the model's own local axis. Unity's +Z euler raises
            // the right edge (leans left), hence the sign flip.
            float bank = BankAlongPath(path, banks, t);
            if (dir.sqrMagnitude > 0.0001f)
                go.transform.rotation =
                    Quaternion.LookRotation(dir.normalized, Vector3.up)
                    * Quaternion.Euler(0f, 0f, -bank)
                    * (forwardIsX ? Quaternion.Euler(0f, -90f, 0f) : Quaternion.identity);
{% else %}
            if (dir.sqrMagnitude > 0.0001f)
                go.transform.rotation =
                    Quaternion.LookRotation(dir.normalized, Vector3.up)
                    * (forwardIsX ? Quaternion.Euler(0f, -90f, 0f) : Quaternion.identity);
{% endif %}

            if (isPrimitive)
            {
                // Thin ribbon: full width across, low profile, slot-long.
                go.transform.localScale = new Vector3(pathWidth, 0.3f, arc / n * TILE_OVERLAP);
                pos.y += 0.17f;   // half height + z-fight lift over the ground
            }
            else
            {
                go.transform.localScale = forwardIsX
                    ? new Vector3(uniform * stretch, uniform, uniform)
                    : new Vector3(uniform, uniform, uniform * stretch);
                pos.y += -minY * uniform + 0.02f;   // ground-snap + z-fight lift
            }
            go.transform.position = pos;

            if (sh != null && isPrimitive)   // models keep their own materials
            {
                var m = new Material(sh);
                m.color = color;
                var rend = go.GetComponent<Renderer>();
                if (rend != null) rend.material = m;
            }
            if (!string.IsNullOrEmpty(tag) && tag != "Untagged")
            {
                try { go.tag = tag; } catch { /* tag not in TagManager — skip */ }
            }
            if (behaviorType != null && typeof(MonoBehaviour).IsAssignableFrom(behaviorType))
                go.AddComponent(behaviorType);
        }
    }

    // Total polyline length — the tile-count denominator. (Kept separate from
    // PointAlongPath so projects without tiled paths stay byte-identical.)
    private static float ArcLength(Vector3[] pts)
    {
        float total = 0f;
        for (int i = 1; i < pts.Length; i++) total += Vector3.Distance(pts[i - 1], pts[i]);
        return total;
    }
{% if has_banked_paths %}

    // Bank angle at arc-length parameter t — the same segment walk as
    // PointAlongPath, but lerping the per-point bank values so banking ramps
    // smoothly between authored points (a 12°-banked corner eases in/out
    // through its neighbors instead of snapping per tile). banks[i] pairs
    // with pts[i]; a null/short array reads as 0.
    private static float BankAlongPath(Vector3[] pts, float[] banks, float t)
    {
        if (banks == null || banks.Length == 0 || pts.Length < 2) return 0f;
        float B(int i) => i < banks.Length ? banks[i] : 0f;
        float total = 0f;
        for (int i = 1; i < pts.Length; i++) total += Vector3.Distance(pts[i - 1], pts[i]);
        float dist = Mathf.Clamp01(t) * total;
        for (int i = 1; i < pts.Length; i++)
        {
            float seg = Vector3.Distance(pts[i - 1], pts[i]);
            if (dist <= seg || i == pts.Length - 1)
                return Mathf.Lerp(B(i - 1), B(i), seg > 0f ? Mathf.Clamp01(dist / seg) : 0f);
            dist -= seg;
        }
        return B(pts.Length - 1);
    }
