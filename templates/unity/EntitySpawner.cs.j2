    // Empty waypoint GameObjects along a path — consumed by waypoint-following AI
    // (route runners look for a container named "Waypoints" by default).
    private void EmitWaypoints(string containerName, Vector3[] points)
    {
        if (GameObject.Find(containerName) != null) return;
        var parent = new GameObject(containerName).transform;
        parent.SetParent(transform, false);
        for (int i = 0; i < points.Length; i++)
        {
            var w = new GameObject("Waypoint_" + i);
            w.transform.SetParent(parent);
            w.transform.position = points[i];
        }
    }

    private Vector3 PointAlongPath(Vector3[] pts, float t)
    {
        if (pts.Length == 1) return pts[0];
        float total = 0f;
        for (int i = 1; i < pts.Length; i++) total += Vector3.Distance(pts[i - 1], pts[i]);
        float dist = Mathf.Clamp01(t) * total;
        for (int i = 1; i < pts.Length; i++)
        {
            float seg = Vector3.Distance(pts[i - 1], pts[i]);
            if (dist <= seg || i == pts.Length - 1)
                return Vector3.Lerp(pts[i - 1], pts[i], seg > 0f ? Mathf.Clamp01(dist / seg) : 0f);
            dist -= seg;
        }
        return pts[pts.Length - 1];
    }

    private Vector3 PlaceAt(string placement, int i, int count, float spacing, float radius)
    {
        int n = Mathf.Max(1, count);
        switch (placement)
        {
            case "line":
                return new Vector3((i - (n - 1) / 2f) * spacing, 0f, 0f);
            case "ring":
            {
                float a = i * Mathf.PI * 2f / n;
                return new Vector3(Mathf.Cos(a) * radius, 0f, Mathf.Sin(a) * radius);
            }
            case "grid":
            {
                int cols = Mathf.CeilToInt(Mathf.Sqrt(n));
                int r = i / cols, c = i % cols;
                return new Vector3((c - (cols - 1) / 2f) * spacing, 0f, r * spacing);
            }
            case "scatter":
            {
                var rnd = new System.Random(i * 7 + 1);
                return new Vector3((float)(rnd.NextDouble() * 2 - 1) * radius, 0f,
                                   (float)(rnd.NextDouble() * 2 - 1) * radius);
            }
            default:
                return Vector3.zero;
        }
    }
