            foreach (var c3d in go.GetComponentsInChildren<Collider>()) SafeDestroy(c3d);
            if (go.GetComponent<Collider2D>() == null) go.AddComponent<BoxCollider2D>();
{% endif %}
            Vector3 pos;
            if (bakedPositions != null && i < bakedPositions.Length)
            {
                // Precomputed by src/unity_layout.py (pipeline Step 5) — already
                // includes this group's packed world-space region offset and,
                // for "scatter", deterministic non-overlapping jitter. Takes
                // priority over PlaceAt()'s runtime formulas whenever present.
                pos = bakedPositions[i];
                pos.y += pivotOffsetY * finalScale;
{% if has_baked_yaws %}
                // Baked facing (e.g. a start grid aligned to the race
                // direction) — yaw-only, with the same X-forward model
                // correction SpawnTiledGroup applies to road tiles.
                if (bakedYaws != null && i < bakedYaws.Length)
                    go.transform.rotation = Quaternion.Euler(
                        0f, bakedYaws[i] + (modelForwardIsX ? -90f : 0f), 0f);
{% endif %}
            }
