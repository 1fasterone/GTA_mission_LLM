    private static Material UiMaterial(Shader sh, Color c)
    {
        var m = new Material(sh != null ? sh : Shader.Find("Universal Render Pipeline/Lit"));
        m.color = c;
        if (m.HasProperty("_BaseColor")) m.SetColor("_BaseColor", c);
        if (m.HasProperty("_Smoothness")) m.SetFloat("_Smoothness", 0.15f);
        return m;
    }

    /// <summary>One flat plate, parented and coloured. Colliders are stripped:
    /// the finished element carries exactly one, on its root, so the pointer
