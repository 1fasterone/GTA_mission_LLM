    private void BuildGround2D(float length, Shader sh)
    {
        var ground = new GameObject("Ground");
        ground.transform.SetParent(transform, false);
        ground.transform.position = new Vector3(length * 0.5f, -1f, 0f);
        var col = ground.AddComponent<BoxCollider2D>();
        col.size = new Vector2(length + 28f, 2f);
        var vis = GameObject.CreatePrimitive(PrimitiveType.Cube);
        var c3 = vis.GetComponent<Collider>(); if (c3 != null) SafeDestroy(c3);
        vis.transform.SetParent(ground.transform, false);
        vis.transform.localScale = new Vector3(length + 28f, 2f, 1f);
        Apply2DColor(vis, sh, new Color(0.20f, 0.20f, 0.23f));
    }

    private void PlaceRow2D(string groupName, int count, float scale, string modelPath,
                            Color color, string tag, bool backdrop, float courseLen, Shader sh,
                            float tiltDeg = 0f)
    {
        // Load order: sprite_animator's OWN generated bank (Sprites/<name>/idle/
        // frame_00 → Texture2D) → modelPath's resolved 2D sprite/3D model prefab
        // → primitive cube. Checked FIRST and by groupName, not modelPath: the
        // sprite_animator micro (Player/Rivals) writes its bank AFTER
        // entity_model_paths is baked into this file (compose emits micros once
        // Step 6 has already rendered EntitySpawner.cs), so modelPath can never
        // know that bank exists — confirmed live, 2026-08-31, a genre="racing"
        // Rivals entity resolved a 3D "Models/Kenney/Vehicle/race" model_hint
        // path despite 15 real generated rival sprite frames sitting unused
        // right next to it. Resources.Load returns null harmlessly for any
        // entity with no bank (PineTrees, RoadSegments, ...), falling straight
        // through to the existing modelPath chain below — purely additive.
        // Sprite textures import with Unity's default settings, so the Sprite
        // itself is built at runtime — no TextureImporter .meta authoring needed.
        Sprite sprite = null;
        GameObject modelPrefab = null;
        var genTex = Resources.Load<Texture2D>("Sprites/" + groupName + "/idle/frame_00");
        if (genTex != null)
            sprite = Sprite.Create(genTex, new Rect(0f, 0f, genTex.width, genTex.height),
                                   new Vector2(0.5f, 0.5f), Mathf.Max(1f, genTex.height));
        else if (!string.IsNullOrEmpty(modelPath))
        {
            var tex = Resources.Load<Texture2D>(modelPath);
            if (tex != null)
                sprite = Sprite.Create(tex, new Rect(0f, 0f, tex.width, tex.height),
                                       new Vector2(0.5f, 0.5f), Mathf.Max(1f, tex.height)); // ~1 unit tall
            else
                modelPrefab = Resources.Load<GameObject>(modelPath);
        }
        var parent = new GameObject(groupName).transform;
        parent.SetParent(transform, false);
        int n = Mathf.Max(1, count);
        for (int i = 0; i < n; i++)
        {
            GameObject go;
            if (sprite != null)
            {
                go = new GameObject(groupName + "_" + i);
                var sr = go.AddComponent<SpriteRenderer>();
                sr.sprite = sprite;
                if (backdrop) sr.sortingOrder = -10;
            }
            else
            {
                go = modelPrefab != null ? Instantiate(modelPrefab) : GameObject.CreatePrimitive(PrimitiveType.Cube);
            }
            go.name = groupName + "_" + i;
            go.transform.SetParent(parent);
            go.transform.localScale = Vector3.one * scale;
            go.transform.position = new Vector3((i + 1) * (courseLen / (n + 1)),
                                                backdrop ? 3.5f : scale * 0.5f,
                                                backdrop ? 8f : 0f);
            // Ramps/sloped props: a Z rotation here is followed correctly by
            // the BoxCollider2D added below, giving a real sloped collision
            // surface (not just a sloped-looking sprite) — the same technique
            // any 2D platformer ramp uses. 0f (default) leaves upright props
            // untouched.
            if (!backdrop && tiltDeg != 0f)
                go.transform.rotation = Quaternion.Euler(0f, 0f, tiltDeg);
            foreach (var cc in go.GetComponentsInChildren<Collider>()) SafeDestroy(cc);
            if (!backdrop && go.GetComponent<Collider2D>() == null) go.AddComponent<BoxCollider2D>();
            if (sprite == null && modelPrefab == null) Apply2DColor(go, sh, color);
            if (!backdrop && !string.IsNullOrEmpty(tag) && tag != "Untagged") { try { go.tag = tag; } catch { } }
        }
    }

    private void PlacePlayerStart2D()
    {
        var p = GameObject.FindWithTag("Player");
        if (p != null) p.transform.position = new Vector3(0f, 2.5f, 0f);
    }
{% elif game_type == "2d_topdown" %}

    // ── 2D top-down archetype builders ────────────────────────────────────────
    // No ground/gravity concept (free 2-axis Rigidbody2D movement) — entity
    // groups scatter/grid/ring/line across an open X/Y arena instead of a
    // side-scroller's single-lane course.
    private void BuildTopDown2D(Shader sh)
    {
{% if scene_entity_map %}
        var _scene = SceneManager.GetActiveScene().name;
{% endif %}
{% for e in entities %}
{% set role = e.kind|lower %}
{% set epath = entity_model_paths.get(e.name, "") %}
{% if role != "player" and not epath.startswith("skip:") and not epath.startswith("fx:") %}
        {{ 'if (GroupActive(_scene, "' ~ e.name ~ '")) ' if scene_entity_map else '' }}PlaceGroup2DTopDown("{{ e.name }}", {{ e.count }}, "{{ e.placement }}", {{ "%.2f"|format(e.spacing) }}f, {{ "%.2f"|format(e.radius) }}f, {{ "%.2f"|format(e.scale) }}f, "{{ entity_model_paths.get(e.name, "") }}", new Color({{ "%.3f"|format(palette_rgb[e.color_role].r) }}f, {{ "%.3f"|format(palette_rgb[e.color_role].g) }}f, {{ "%.3f"|format(palette_rgb[e.color_role].b) }}f), "{{ e.tag }}", sh);
{% endif %}
{% endfor %}
        PlacePlayerStart2DTopDown();
    }

    private void PlaceGroup2DTopDown(string groupName, int count, string placement, float spacing,
                                     float radius, float scale, string modelPath, Color color,
                                     string tag, Shader sh)
    {
        // Same sprite_animator-bank -> modelPath -> model -> primitive load
        // order as PlaceRow2D — see that method's own comment for why the
        // bank has to be checked by groupName, ahead of modelPath, rather
        // than folded into entity_model_paths.
        Sprite sprite = null;
        GameObject modelPrefab = null;
        var genTex = Resources.Load<Texture2D>("Sprites/" + groupName + "/idle/frame_00");
        if (genTex != null)
            sprite = Sprite.Create(genTex, new Rect(0f, 0f, genTex.width, genTex.height),
                                   new Vector2(0.5f, 0.5f), Mathf.Max(1f, genTex.height));
        else if (!string.IsNullOrEmpty(modelPath))
        {
            var tex = Resources.Load<Texture2D>(modelPath);
            if (tex != null)
                sprite = Sprite.Create(tex, new Rect(0f, 0f, tex.width, tex.height),
                                       new Vector2(0.5f, 0.5f), Mathf.Max(1f, tex.height));
            else
                modelPrefab = Resources.Load<GameObject>(modelPath);
        }
        var parent = new GameObject(groupName).transform;
        parent.SetParent(transform, false);
        int n = Mathf.Max(1, count);
        for (int i = 0; i < n; i++)
        {
            GameObject go;
            if (sprite != null)
            {
                go = new GameObject(groupName + "_" + i);
                go.AddComponent<SpriteRenderer>().sprite = sprite;
            }
            else
            {
                go = modelPrefab != null ? Instantiate(modelPrefab) : GameObject.CreatePrimitive(PrimitiveType.Cube);
            }
            go.name = groupName + "_" + i;
            go.transform.SetParent(parent);
            go.transform.localScale = Vector3.one * scale;
            go.transform.position = PlaceAt2DTopDown(placement, i, n, spacing, radius);
            foreach (var cc in go.GetComponentsInChildren<Collider>()) SafeDestroy(cc);
            if (go.GetComponent<Collider2D>() == null) go.AddComponent<BoxCollider2D>();
            if (sprite == null && modelPrefab == null) Apply2DColor(go, sh, color);
            if (!string.IsNullOrEmpty(tag) && tag != "Untagged") { try { go.tag = tag; } catch { } }
        }
    }

    // Same placement vocabulary as PlaceAt() but projected onto the X/Y
    // physics plane (Rigidbody2D moves in X/Y) instead of X/Z.
    private Vector3 PlaceAt2DTopDown(string placement, int i, int count, float spacing, float radius)
    {
        int n = Mathf.Max(1, count);
        switch (placement)
        {
            case "line":
                return new Vector3((i - (n - 1) / 2f) * spacing, 0f, 0f);
            case "ring":
            {
                float a = i * Mathf.PI * 2f / n;
                return new Vector3(Mathf.Cos(a) * radius, Mathf.Sin(a) * radius, 0f);
            }
            case "grid":
            {
                int cols = Mathf.CeilToInt(Mathf.Sqrt(n));
                int r = i / cols, c = i % cols;
                return new Vector3((c - (cols - 1) / 2f) * spacing, (r - (Mathf.CeilToInt((float)n / cols) - 1) / 2f) * spacing, 0f);
            }
            case "scatter":
            {
                var rnd = new System.Random(i * 7 + 1);
                return new Vector3((float)(rnd.NextDouble() * 2 - 1) * radius,
                                   (float)(rnd.NextDouble() * 2 - 1) * radius, 0f);
            }
            default:
                return Vector3.zero;
        }
    }

    private void PlacePlayerStart2DTopDown()
    {
        var p = GameObject.FindWithTag("Player");
        if (p != null) p.transform.position = Vector3.zero;
    }
{% endif %}

    private void Apply2DColor(GameObject go, Shader sh, Color color)
    {
        if (sh == null) return;
        var rend = go.GetComponent<Renderer>();
        if (rend != null) { var m = new Material(sh); m.color = color; rend.material = m; }
    }
{% endif %}
