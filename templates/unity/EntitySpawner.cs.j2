    private void BuildGround2D(float length, Shader sh)
    {
        var ground = new GameObject("Ground");
        ground.transform.SetParent(transform, false);
        ground.transform.position = new Vector3(length * 0.5f, -1f, 0f);
        var col = ground.AddComponent<BoxCollider2D>();
        col.size = new Vector2(length + 28f, 2f);
        var vis = GameObject.CreatePrimitive(PrimitiveType.Cube);
        var c3 = vis.GetComponent<Collider>(); if (c3 != null) Destroy(c3);
        vis.transform.SetParent(ground.transform, false);
        vis.transform.localScale = new Vector3(length + 28f, 2f, 1f);
        Apply2DColor(vis, sh, new Color(0.20f, 0.20f, 0.23f));
    }

    private void PlaceRow2D(string groupName, int count, float scale, string modelPath,
                            Color color, string tag, bool backdrop, float courseLen, Shader sh)
    {
        // Load order: 2D sprite (Sprites/... path → Texture2D) → 3D model prefab
        // → primitive cube. Sprite textures import with Unity's default settings,
        // so the Sprite itself is built at runtime — no TextureImporter .meta
        // authoring needed.
        Sprite sprite = null;
        GameObject modelPrefab = null;
        if (!string.IsNullOrEmpty(modelPath))
        {
            var tex = Resources.Load<Texture2D>(modelPath);
            if (tex != null)
                sprite = Sprite.Create(tex, new Rect(0f, 0f, tex.width, tex.height),
                                       new Vector2(0.5f, 0.5f), Mathf.Max(1f, tex.height)); // ~1 unit tall
            else
                modelPrefab = Resources.Load<GameObject>(modelPath);
        }
        var parent = new GameObject(groupName).transform;
        parent.SetParent(transform, false);
        int n = Mathf.Max(1, count);
        for (int i = 0; i < n; i++)
        {
            GameObject go;
            if (sprite != null)
            {
                go = new GameObject(groupName + "_" + i);
                var sr = go.AddComponent<SpriteRenderer>();
                sr.sprite = sprite;
                if (backdrop) sr.sortingOrder = -10;
            }
            else
            {
                go = modelPrefab != null ? Instantiate(modelPrefab) : GameObject.CreatePrimitive(PrimitiveType.Cube);
            }
            go.name = groupName + "_" + i;
            go.transform.SetParent(parent);
            go.transform.localScale = Vector3.one * scale;
            go.transform.position = new Vector3((i + 1) * (courseLen / (n + 1)),
                                                backdrop ? 3.5f : scale * 0.5f,
                                                backdrop ? 8f : 0f);
            foreach (var cc in go.GetComponentsInChildren<Collider>()) Destroy(cc);
            if (!backdrop && go.GetComponent<Collider2D>() == null) go.AddComponent<BoxCollider2D>();
            if (sprite == null && modelPrefab == null) Apply2DColor(go, sh, color);
            if (!backdrop && !string.IsNullOrEmpty(tag) && tag != "Untagged") { try { go.tag = tag; } catch { } }
        }
    }

    private void PlacePlayerStart2D()
