        var p = GameObject.FindWithTag("Player");
        if (p != null) p.transform.position = new Vector3(0f, 2.5f, 0f);
    }

    private void Apply2DColor(GameObject go, Shader sh, Color color)
    {
        if (sh == null) return;
        var rend = go.GetComponent<Renderer>();
        if (rend != null) { var m = new Material(sh); m.color = color; rend.material = m; }
    }
