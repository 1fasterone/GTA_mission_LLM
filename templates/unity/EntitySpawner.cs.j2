            ? null : Resources.Load<GameObject>(modelPath);
{% endif %}

        var parent = new GameObject(groupName).transform;
        parent.SetParent(transform, false);
{% if game_type not in ("2D", "2d_topdown") %}
        // Measure the model ONCE (not per-instance): a uniform bounds-fit
        // factor (Sketchfab-sourced models only, fitSize==0 elsewhere), the
        // XZ footprint (drives spacing so neighbors don't overlap), and the
        // pivot's vertical offset from the mesh base (drives ground-snap —
        // imported FBX pivots vary; a primitive's default center pivot keeps
        // today's `scale * 0.5f` heuristic exactly).
        float fitFactor = 1f, footprintXZ = 1f, pivotOffsetY = 0.5f;
        // Collider box in UNSCALED model units (the transform's localScale
        // scales it) — measured below, defaulted to a person-sized box for the
        // primitive fallback.
        Vector3 colSize = Vector3.one, colCenter = new Vector3(0f, 0.5f, 0f);
{% if has_baked_yaws %}
        bool modelForwardIsX = false;
{% endif %}
        if (modelPrefab != null && TryMeasureBounds(modelPrefab, out var _mb))
        {
            float maxDim = Mathf.Max(_mb.size.x, Mathf.Max(_mb.size.y, _mb.size.z));
            if (fitSize > 0f && maxDim > 0.0001f) fitFactor = fitSize / maxDim;
{% if has_clamped_entities %}
            // Negative fitSize = shrink-only ceiling of -fitSize meters
            // (kind_sizes.json clamp_sizes, any catalog source) — a
            // well-scaled asset stays at 1, nothing is ever enlarged.
            else if (fitSize < 0f && maxDim > 0.0001f)
                fitFactor = Mathf.Min(1f, -fitSize / maxDim);
{% endif %}
            footprintXZ = Mathf.Max(_mb.size.x, _mb.size.z);
            pivotOffsetY = -_mb.min.y;
            colSize   = _mb.size;
            colCenter = _mb.center;
            if (IsSurfaceKind(kind))
            {
                // A road/track/bridge is something you travel ON. Colliding
                // with its whole bounding volume puts everything spawned above
                // it — the player included — INSIDE the collider, so collide
                // with a thin slab at its base instead: wheels and feet rest
                // on the surface and the space above it stays clear.
                float slab = Mathf.Min(_mb.size.y, 0.5f);
                colSize   = new Vector3(_mb.size.x, slab, _mb.size.z);
                colCenter = new Vector3(_mb.center.x, _mb.min.y + slab * 0.5f, _mb.center.z);
            }
{% if has_baked_yaws %}
            // Same forward-axis heuristic as SpawnTiledGroup: a model
            // clearly longer on X than Z (beyond the 0.9 bias toward Z)
            // travels along its X axis — its baked yaw needs the -90°
            // LookRotation correction so it faces down the track.
            modelForwardIsX = _mb.size.z < _mb.size.x * 0.9f;
{% endif %}
        }
        float finalScale = fitFactor * scale;
