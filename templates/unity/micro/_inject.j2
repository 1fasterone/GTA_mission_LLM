{# Shared injection macros for LLM-authored prompt-specific C# fragments.
   Imported by each generator's main MonoBehaviour template:
     {% import "_inject.j2" as inject %}
   The format here matches the controller's hand-tuned inline layout so output
   is consistent across every generator. #}

{% macro usings(s) -%}
{% for u in s.extra_usings %}
using {{ u }};
{%- endfor %}
{%- endmacro %}

{# One field declaration, split into parts so a generator that needs its own
   loop, indentation or attribute placement can reuse the DECLARATION TEXT
   without copying it. That text is what carried both injection defects found
   so far — an unescaped quote inside [Tooltip("…")] (CS1003) and an invalid
   `= 0i` initializer (CS1002) — and each fix had to be chased across every
   copy of it. Seven generators keep their own surrounding whitespace, so the
   parts are separate rather than one all-or-nothing macro.

   Each macro is defined on ONE line: the micro Jinja env sets neither
   trim_blocks nor lstrip_blocks (src/micro_pipeline.py), so a multi-line body
   would leak its own newlines into every caller. #}
{% macro attrs(f) %}{% if f.header %}[Header("{{ f.header }}")] {% endif %}{% if f.tooltip %}[Tooltip("{{ f.tooltip }}")] {% endif %}{% endmacro %}
{% macro decl(f) %}[SerializeField] private {{ f.type }} {{ f.name }}{% if f.default %} = {{ f.default }}{% endif %};{% endmacro %}
{% macro field(f) %}{{ attrs(f) }}{{ decl(f) }}{% endmacro %}

{% macro fields(s) -%}
{% for f in s.extra_fields %}
{{ "    " }}{{ field(f) }}
{%- endfor %}
{%- endmacro %}

{% macro lifecycle(body) -%}
{% if body %}
        // ── prompt-specific ──
{{ body | indent(8, True) }}
{%- endif %}
{%- endmacro %}

{% macro fixed_update(s) -%}
{% if s.fixed_update_extra %}

    private void FixedUpdate()
    {
{{ s.fixed_update_extra | indent(8, True) }}
    }
{%- endif %}
{%- endmacro %}

{% macro methods(s) -%}
{% for m in s.extra_methods %}

    // ── prompt-specific ──
    {{ m.signature }}
    {
{{ m.body | indent(8, True) }}
    }
{%- endfor %}
{%- endmacro %}

{# Schema Extensions (docs/SCHEMA_EXTENSIONS.md) — the LLM's sandboxed field-
   invention namespace. Kept visually distinct from the extra_* injection
   above: this content passed through apply_extensions_safe_block, NOT
   lint_extensible, so it is collision-checked but not repair-hardened. #}
{% macro extensions_fields(s) -%}
{% if s.extensions_fields %}

    // ═══ EXPERIMENTAL EXTENSIONS (sandboxed — see docs/SCHEMA_EXTENSIONS.md) ═
{% for f in s.extensions_fields %}
{{ "    " }}{{ field(f) }}
{%- endfor %}
{%- endif %}
{%- endmacro %}

{% macro extensions_methods(s) -%}
{% for m in s.extensions_methods %}

    // ── EXPERIMENTAL EXTENSION (sandboxed — see docs/SCHEMA_EXTENSIONS.md) ──
    {{ m.signature }}
    {
{{ m.body | indent(8, True) }}
    }
{%- endfor %}
{%- endmacro %}
