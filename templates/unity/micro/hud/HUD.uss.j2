.root {
    position: absolute;
    padding: 12px;
}
.anchor-TL { top: 0; left: 0; }
.anchor-TR { top: 0; right: 0; }
.anchor-BL { bottom: 0; left: 0; }
.anchor-BR { bottom: 0; right: 0; }
.anchor-center {
    top: 50%; left: 50%; translate: -50% -50%;
}
.hud-label    { font-size: 24px; color: white; -unity-font-style: bold; }
.hud-score    { font-size: 36px; }
.hud-prompt   { font-size: 18px; color: rgb(220, 220, 220); }
.hud-dialogue { font-size: 20px; color: white; }
.hud-title    { font-size: 48px; color: white; -unity-font-style: bold; }
.hud-minimap  { width: 200px; height: 200px; background-color: rgba(0,0,0,0.5); }
.hud-crosshair{ width: 16px; height: 16px; background-color: white; border-radius: 8px; }
