{% if "throw_grenade" in s.abilities %}
    private void ThrowGrenade()
    {
        _grenadesLeft--;
        if (grenadePrefab == null) return;
        var g = Instantiate(grenadePrefab,
            transform.position + transform.forward * 0.5f + Vector3.up * 1f,
            transform.rotation);
        var rb = g.GetComponent<Rigidbody>() ?? g.AddComponent<Rigidbody>();
        rb.AddForce((transform.forward * 0.8f + Vector3.up * 0.4f).normalized * throwForce,
                    ForceMode.Impulse);
    }
{% endif %}
{% if "melee_attack" in s.abilities %}
    private void TryMeleeAttack()
    {
        _meleeCooldown = meleeCooldown;
        Collider[] hits = Physics.OverlapSphere(transform.position + transform.forward * meleeRange * 0.5f, meleeRange);
        foreach (var c in hits)
        {
            if (c.gameObject == gameObject) continue;
            c.SendMessage("TakeDamage", meleeDamage, SendMessageOptions.DontRequireReceiver);
            break;
        }
    }
