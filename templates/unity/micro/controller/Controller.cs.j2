    // Locate the rigged model's four wheel BONES (Wheel.FL/FR/RL/RR), skinned bones
    // only (mesh objects carry a Renderer and are skipped). Returns [FL,FR,RL,RR],
    // or null if all four aren't present (then primitive cylinders are used).
    private Transform FindWheelBones(Transform root)
    {
        Transform fl = null, fr = null, rl = null, rr = null;
        foreach (var t in root.GetComponentsInChildren<Transform>(true))
        {
            if (t.GetComponent<Renderer>() != null) continue;     // mesh, not a bone
            string n = t.name.ToLowerInvariant();
            if (!n.StartsWith("wheel")) continue;
            bool front = n.Contains(".f") || n.Contains("front");
            bool left  = n.EndsWith("l") || n.Contains("left");
            if (front && left)      fl = t;
            else if (front)         fr = t;
            else if (left)          rl = t;
            else                    rr = t;
        }
        if (fl != null && fr != null && rl != null && rr != null)
            return new[] { fl, fr, rl, rr };
        return null;
    }
