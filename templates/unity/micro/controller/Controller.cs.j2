{% if has_physical_projectiles %}    private void InitializeProjectilePools()
    {
        _projectilePools = new ProjectilePool[weaponNames.Length];
        for (int i = 0; i < weaponNames.Length; i++)
        {
            if (weaponDelivery[i] != "projectile_3d") continue;

            var owner = new GameObject("Projectile3DPool_" + i);
            owner.transform.SetParent(transform, false);
            var pool = owner.AddComponent<ProjectilePool>();
            var prefab = BuildProjectile3DPrefab(i, owner.transform);
            pool.Initialize(
                prefab,
                projectilePoolSize[i],
                projectilePoolGrows[i]
                    ? ProjectilePoolGrowthPolicy.GrowByOne
                    : ProjectilePoolGrowthPolicy.Fixed);
            _projectilePools[i] = pool;
        }
    }

    private GameObject BuildProjectile3DPrefab(int weaponIndex, Transform poolOwner)
    {
        var prefab = GameObject.CreatePrimitive(PrimitiveType.Sphere);
        prefab.name = "Projectile3DPrefab_" + weaponIndex;
        prefab.transform.SetParent(poolOwner, false);
        prefab.transform.localScale = Vector3.one * 0.16f;
        var body = prefab.AddComponent<Rigidbody>();
        body.isKinematic = true;
        body.useGravity = false;
        prefab.AddComponent<ProjectileController>();
        prefab.SetActive(false);
        return prefab;
    }

    private bool LaunchProjectile()
    {
        var pool = _projectilePools != null ? _projectilePools[_weaponIndex] : null;
        if (pool == null) return false;

        var projectile = pool.Borrow();
        if (projectile == null) return false;

        Transform muzzle = ResolveProjectileMuzzle();
        Ray aimRay = Camera.main != null
            ? Camera.main.ViewportPointToRay(new Vector3(0.5f, 0.5f, 0f))
            : new Ray(muzzle.position, muzzle.forward);
        projectile.transform.SetPositionAndRotation(muzzle.position, Quaternion.LookRotation(aimRay.direction));
        projectile.Configure(
            weaponDamage[_weaponIndex], gameObject,
            projectileLifetime[_weaponIndex], projectileUseGravity[_weaponIndex]);
        projectile.Launch(aimRay.direction.normalized * projectileSpeed[_weaponIndex]);
        return true;
    }

    private Transform ResolveProjectileMuzzle()
    {
        if (projectileMuzzle != null) return projectileMuzzle;
        var eye = transform.Find("Eye");
        if (eye != null)
        {
            var mountedMuzzle = eye.Find("ProjectileMuzzle");
            if (mountedMuzzle != null) return mountedMuzzle;
        }
        return transform;
    }
