{% if "shoot" in s.abilities %}
    private void TryShoot()
    {
        _lastFireTime = Time.time;
        _currentAmmo--;
        if (muzzleFlash != null) muzzleFlash.Play();
        Ray ray = Camera.main != null
            ? Camera.main.ViewportPointToRay(new Vector3(0.5f, 0.5f, 0f))
            : new Ray(transform.position, transform.forward);
        if (Physics.Raycast(ray, out RaycastHit hit, shootRange))
            hit.collider.SendMessage("TakeDamage", 25f, SendMessageOptions.DontRequireReceiver);
    }

    private IEnumerator ReloadRoutine()
    {
        _isReloading = true;
        yield return new WaitForSeconds(reloadTime);
        _currentAmmo = magazineSize;
        _isReloading = false;
    }
{% endif %}
{% if "cycle_weapon" in s.abilities %}
    private void SwitchWeapon(int delta)
    {
        _weaponIndex = (_weaponIndex + delta + weaponNames.Length) % weaponNames.Length;
        SendMessage("OnWeaponChanged", _weaponIndex, SendMessageOptions.DontRequireReceiver);
    }
