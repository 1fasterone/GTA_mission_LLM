{% if variant == "vehicle_hover" or s.fixed_update_extra %}
    private void FixedUpdate()
    {
{% if variant == "vehicle_hover" %}
        if (_rb == null) return;

        // ── Hover suspension ──────────────────────────────────────────────
        // One spring-damper per probe, pushing along the SURFACE normal so
        // banked or sloped road sections lift the craft correctly.
        _groundedProbes = 0;
        for (int i = 0; i < 4; i++)
        {
            Vector3 worldPoint = transform.TransformPoint(_hoverPoints[i]);
            if (!Physics.Raycast(worldPoint, -transform.up, out RaycastHit hit,
                                 hoverRideHeight * 2f, hoverMask,
                                 QueryTriggerInteraction.Ignore))
                continue;
            _groundedProbes++;
            float   compression = 1f - (hit.distance / hoverRideHeight);
            Vector3 pointVel    = _rb.GetPointVelocity(worldPoint);
            float   damping     = Vector3.Dot(pointVel, hit.normal) * hoverDamper;
            float   force       = (compression * hoverSpring) - damping;
            _rb.AddForceAtPosition(hit.normal * force, worldPoint, ForceMode.Acceleration);
        }
        _grounded = _groundedProbes > 0;

        // ── Thrust ────────────────────────────────────────────────────────
        // Only bites while at least one probe has a surface to push against,
        // so leaving the strip means coasting, not steering in mid-air.
        if (_grounded)
        {
            float drive = _driveInput >= 0f ? _driveInput * thrustForce
                                            : _driveInput * reverseForce;
            if (_boostActive && _driveInput > 0f) drive *= boostMultiplier;
            _rb.AddForce(transform.forward * drive, ForceMode.Acceleration);
            _rb.AddTorque(transform.up * (_steerInput * turnTorque), ForceMode.Acceleration);

            // Lane-keeping: bleed sideways velocity so the hull tracks its
            // heading instead of sliding wide — a drag craft, not a drifter.
            Vector3 lateral = Vector3.Project(_rb.linearVelocity, transform.right);
            _rb.AddForce(-lateral * lateralGrip, ForceMode.Acceleration);

            if (_brakeHeld)
                _rb.AddForce(-_rb.linearVelocity * 2.5f, ForceMode.Acceleration);
        }

        // Hold the hull level rather than letting it nose-dive or barrel-roll.
        Vector3 flatFwd = Vector3.ProjectOnPlane(transform.forward, Vector3.up);
        if (flatFwd.sqrMagnitude > 0.01f)
        {
            Quaternion level = Quaternion.LookRotation(flatFwd.normalized, Vector3.up);
            _rb.MoveRotation(Quaternion.Slerp(_rb.rotation, level,
                                              Time.fixedDeltaTime * 2.5f));
        }

        _rb.AddForce(-_rb.linearVelocity * hoverDrag, ForceMode.Acceleration);
        if (_rb.linearVelocity.magnitude > maxSpeed)
            _rb.linearVelocity = _rb.linearVelocity.normalized * maxSpeed;
{% endif %}
