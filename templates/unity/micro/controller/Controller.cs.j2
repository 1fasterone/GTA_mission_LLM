{% endif %}
        float motor = v * maxMotorTorque;
        float steer = h * maxSteerAngle;
        _steerInput    = h;
        _throttleInput = Mathf.Clamp01(Mathf.Abs(v));

        if (handbrake && _rb.linearVelocity.sqrMagnitude > 1f)
        {
            float slip = Vector3.SignedAngle(transform.forward,
                                             _rb.linearVelocity.normalized, Vector3.up);
            steer = Mathf.Clamp(steer + slip * 0.5f, -maxSteerAngle * 1.5f, maxSteerAngle * 1.5f);
        }

