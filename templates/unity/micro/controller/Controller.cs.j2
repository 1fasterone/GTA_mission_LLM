{% if "dodge" in s.abilities %}
    private IEnumerator DodgeRoutine()
    {
        _isDodging      = true;
        _isInvincible   = true;
        _dashCooldownTimer = dashCooldown;
        Vector3 dir = (transform.right * _moveInput.x + transform.forward * _moveInput.y);
        if (dir.sqrMagnitude < 0.01f) dir = -transform.forward;
        dir.Normalize();
        float elapsed = 0f;
        while (elapsed < dashDuration)
        {
            if (_cc != null) _cc.Move(dir * dashForce * Time.deltaTime);
            elapsed += Time.deltaTime;
            yield return null;
        }
        yield return new WaitForSeconds(Mathf.Max(0f, dashIFrames - dashDuration));
        _isInvincible = false;
        _isDodging    = false;
    }
{% elif "dash" in s.abilities %}
    private IEnumerator DashRoutine()
    {
        _isDodging         = true;
        _isInvincible      = true;
        _dashCooldownTimer = dashCooldown;
        Vector3 dir = (transform.right * _moveInput.x + transform.forward * _moveInput.y);
        if (dir.sqrMagnitude < 0.01f) dir = transform.forward;
        dir.Normalize();
        float elapsed = 0f;
        while (elapsed < dashDuration)
        {
            if (_cc != null) _cc.Move(dir * dashForce * Time.deltaTime);
            elapsed += Time.deltaTime;
            yield return null;
        }
        yield return new WaitForSeconds(Mathf.Max(0f, dashIFrames - dashDuration));
        _isInvincible = false;
        _isDodging    = false;
    }
