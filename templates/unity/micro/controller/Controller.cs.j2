{% if variant.startswith("2d_") %}
            if (_rb != null) _rb.MovePosition(_rb.position + dir2 * dashForce * Time.deltaTime);
{% else %}
            if (_cc != null) _cc.Move(dir * dashForce * Time.deltaTime);
