{% elif "dash" in s.abilities %}
    private IEnumerator DashRoutine()
    {
        _isDodging         = true;
        _isInvincible      = true;
        _dashCooldownTimer = dashCooldown;
{% if variant.startswith("2d_") %}
        Vector2 dir2 = new Vector2(_moveInput.x, 0f);
        if (dir2.sqrMagnitude < 0.01f) dir2 = new Vector2({{ "_facing" if variant == "2d_fighting" else "1f" }}, 0f);
        dir2.Normalize();
{% else %}
        Vector3 dir = (transform.right * _moveInput.x + transform.forward * _moveInput.y);
        if (dir.sqrMagnitude < 0.01f) dir = transform.forward;
        dir.Normalize();
{% endif %}
        float elapsed = 0f;
        while (elapsed < dashDuration)
        {
{% if variant.startswith("2d_") %}
            if (_rb != null) _rb.MovePosition(_rb.position + dir2 * dashForce * Time.deltaTime);
{% else %}
            if (_cc != null) _cc.Move(dir * dashForce * Time.deltaTime);
{% endif %}
            elapsed += Time.deltaTime;
            yield return null;
        }
        yield return new WaitForSeconds(Mathf.Max(0f, dashIFrames - dashDuration));
        _isInvincible = false;
        _isDodging    = false;
    }
{% endif %}
{% if "grab" in s.abilities %}
    private void TryGrab()
    {
        _grabCooldown = grabCooldown;
{% if variant.startswith("2d_") %}
        Collider2D[] hits = Physics2D.OverlapCircleAll(transform.position, grabRange);
{% else %}
        Collider[] hits = Physics.OverlapSphere(transform.position + transform.forward * grabRange, grabRange);
{% endif %}
        foreach (var c in hits)
        {
            if (c.gameObject == gameObject) continue;
            c.SendMessage("OnGrabbed", gameObject, SendMessageOptions.DontRequireReceiver);
            break;
        }
    }
{% endif %}
{% if "throw" in s.abilities %}
    private void TryThrow()
    {
        _throwCooldown = throwCooldown;
        if (_carriedObject != null)
            SendMessage("PlayAction", "throw", SendMessageOptions.DontRequireReceiver);
        if (_carriedObject == null)
        {
            // Not carrying anything — look for a nearby "Throwable" to pick up.
{% if variant.startswith("2d_") %}
            Collider2D[] near = Physics2D.OverlapCircleAll(transform.position, throwRange);
{% else %}
            Collider[] near = Physics.OverlapSphere(transform.position, throwRange);
{% endif %}
            foreach (var c in near)
            {
                if (c.gameObject == gameObject || !c.CompareTag("Throwable")) continue;
                _carriedObject = c.gameObject;
                break;
            }
            if (_carriedObject != null)
            {
                var carriedRb2d = _carriedObject.GetComponent<Rigidbody2D>();
                if (carriedRb2d != null) carriedRb2d.bodyType = RigidbodyType2D.Kinematic;
                var carriedRb3d = _carriedObject.GetComponent<Rigidbody>();
                if (carriedRb3d != null) carriedRb3d.isKinematic = true;
                _carriedObject.transform.SetParent(transform, true);
                _carriedObject.transform.localPosition = Vector3.up * 1.2f;
            }
            return;
        }

        // Carrying something — launch it.
        GameObject thrown = _carriedObject;
        _carriedObject = null;
        thrown.transform.SetParent(null, true);
        var impact = thrown.GetComponent<ThrownObject>();
        if (impact == null) impact = thrown.AddComponent<ThrownObject>();
        impact.damage = throwDamage;
{% if variant.startswith("2d_") %}
        var rb2d = thrown.GetComponent<Rigidbody2D>();
        if (rb2d == null) rb2d = thrown.AddComponent<Rigidbody2D>();
        rb2d.bodyType = RigidbodyType2D.Dynamic;
        Vector2 dir2d = new Vector2({{ "_facing" if variant == "2d_fighting" else "1f" }}, 0.4f).normalized;
        rb2d.AddForce(dir2d * throwForce, ForceMode2D.Impulse);
{% else %}
        var rb3d = thrown.GetComponent<Rigidbody>();
        if (rb3d == null) rb3d = thrown.AddComponent<Rigidbody>();
        rb3d.isKinematic = false;
        rb3d.AddForce((transform.forward * 0.8f + Vector3.up * 0.3f).normalized * throwForce, ForceMode.Impulse);
{% endif %}
    }
{% endif %}

