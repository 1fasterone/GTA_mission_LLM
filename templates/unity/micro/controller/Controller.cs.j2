{% if variant == "vehicle_hover" %}
    private void BuildCar()
    {
        // The hull mesh comes from the Model Pack (ModelSwap replaces this at
        // runtime when a real vehicle model resolved); the primitive is only a
        // stand-in so the craft is visible if no model shipped.
        var hoverPrefab = Resources.Load<GameObject>("Models/Default/Vehicle/Car");
        if (hoverPrefab != null)
        {
            var body = Instantiate(hoverPrefab, transform);
            body.name = "Body";
            body.transform.localPosition = Vector3.zero;
        }
        else
        {
            var body = GameObject.CreatePrimitive(PrimitiveType.Cube);
            body.name = "Body";
            Destroy(body.GetComponent<BoxCollider>());
            body.transform.SetParent(transform, false);
            body.transform.localScale    = new Vector3(2.0f, 0.5f, 5.0f);
            body.transform.localPosition = new Vector3(0f, 0.25f, 0f);
        }

        var col    = gameObject.AddComponent<BoxCollider>();
        col.size   = new Vector3(2.0f, 0.5f, 5.0f);
        col.center = new Vector3(0f, 0.25f, 0f);

        // Probe layout mirrors the hull footprint, inset slightly so a probe
        // never hangs off the edge of a road segment mid-corner.
        _hoverPoints[0] = new Vector3(-0.8f, 0f,  2.0f);
        _hoverPoints[1] = new Vector3( 0.8f, 0f,  2.0f);
        _hoverPoints[2] = new Vector3(-0.8f, 0f, -2.0f);
        _hoverPoints[3] = new Vector3( 0.8f, 0f, -2.0f);

        // A hover craft has no wheel bones, but rigged thruster/petal bones are
        // still driven by name at Play — same convention as the wheel driver.
        if (GetComponent<VehicleBoneDriver>() == null)
            gameObject.AddComponent<VehicleBoneDriver>();

        for (int side = -1; side <= 1; side += 2)
        {
            var hgo = new GameObject("Headlight");
            hgo.transform.SetParent(transform, false);
            hgo.transform.localPosition = new Vector3(0.7f * side, 0.5f, 2.4f);
            hgo.transform.localRotation = Quaternion.Euler(10f, 0f, 0f);
            var hl = hgo.AddComponent<Light>();
            hl.type = LightType.Spot; hl.range = 35f; hl.spotAngle = 70f; hl.intensity = 0f;
            _headlights.Add(hl);
        }
        var bgo = new GameObject("BrakeLight");
        bgo.transform.SetParent(transform, false);
        bgo.transform.localPosition = new Vector3(0f, 0.5f, -2.4f);
        _brakeLight = bgo.AddComponent<Light>();
        _brakeLight.type = LightType.Point; _brakeLight.color = Color.red;
        _brakeLight.range = 5f; _brakeLight.intensity = 0f;

        var tgo = new GameObject("ThrusterFX");
        tgo.transform.SetParent(transform, false);
        tgo.transform.localPosition = new Vector3(0f, 0.25f, -2.5f);
        _thrusterFx = tgo.AddComponent<ParticleSystem>();
        var main = _thrusterFx.main;
        main.startSize = 0.6f; main.startLifetime = 0.5f;
        main.startSpeed = 6f;  main.startColor = new Color(0.2f, 0.85f, 1f, 0.7f);
        var em = _thrusterFx.emission; em.rateOverTime = 0f;
    }
{% elif variant.startswith("vehicle_") %}
    private void BuildCar()
    {
        GameObject body;
{% if is_bike %}
        var carPrefab = Resources.Load<GameObject>("Models/Default/Vehicle/Bike");
{% else %}
        var carPrefab = Resources.Load<GameObject>("Models/Default/Vehicle/Car");
{% endif %}
        if (carPrefab != null)
        {
            body = Instantiate(carPrefab, transform);
            body.name = "Body";
{% if is_bike %}
            body.transform.localPosition = new Vector3(0f, 0.3f, 0f);
{% else %}
            body.transform.localPosition = new Vector3(0f, 0.1f, 0f);
{% endif %}
        }
        else
        {
            body = GameObject.CreatePrimitive(PrimitiveType.Cube);
            body.name = "Body";
            Destroy(body.GetComponent<BoxCollider>());
            body.transform.SetParent(transform, false);
{% if is_bike %}
            // Narrow, tall-ish placeholder along the centerline — a bike has
            // no left/right straddle the way a car's four-corner box does.
            body.transform.localScale    = new Vector3(0.4f, 0.9f, 1.7f);
            body.transform.localPosition = new Vector3(0f, 0.55f, 0f);
{% else %}
            body.transform.localScale    = new Vector3(1.7f, 0.5f, 4.0f);
            body.transform.localPosition = new Vector3(0f, 0.45f, 0f);
{% endif %}
        }
{% if is_bike %}
        // The lean below rotates this body pivot, never the rigidbody.
        _leanPivot = body.transform;
        var col    = gameObject.AddComponent<BoxCollider>();
        col.size   = new Vector3(0.5f, 1.1f, 1.9f);
        col.center = new Vector3(0f, 0.55f, 0f);
{% else %}
        var col    = gameObject.AddComponent<BoxCollider>();
        col.size   = new Vector3(1.7f, 0.5f, 4.0f);
        col.center = new Vector3(0f, 0.45f, 0f);
{% endif %}

        Transform[] wheelBones = FindWheelBones(transform);
        bool boneWheels = wheelBones != null;
{% if is_bike %}
        Vector3[] offsets = boneWheels
            ? System.Array.ConvertAll(wheelBones, t => transform.InverseTransformPoint(t.position))
            : new Vector3[]
            {
                new Vector3(0f, 0.15f,  0.75f), new Vector3(0f, 0.15f, -0.75f),
            };
{% else %}
        Vector3[] offsets = boneWheels
            ? System.Array.ConvertAll(wheelBones, t => transform.InverseTransformPoint(t.position))
            : new Vector3[]
            {
                new Vector3(-0.8f, 0.15f,  1.4f), new Vector3(0.8f, 0.15f,  1.4f),
                new Vector3(-0.8f, 0.15f, -1.4f), new Vector3(0.8f, 0.15f, -1.4f),
            };
{% endif %}

        for (int i = 0; i < {{ wheel_count }}; i++)
        {
            var wgo = new GameObject((i < {{ wheel_count // 2 }} ? "WheelF" : "WheelR") + i);
            wgo.transform.SetParent(transform, false);
            wgo.transform.localPosition = offsets[i];
            var wc = wgo.AddComponent<WheelCollider>();
            wc.radius             = wheelRadius;
            wc.suspensionDistance = suspensionDistance;
            var spring = wc.suspensionSpring;
            spring.spring   = suspensionSpring;
            spring.damper   = suspensionDamper;
            wc.suspensionSpring = spring;
            var fwd = wc.forwardFriction;   fwd.stiffness  = 1.4f; wc.forwardFriction  = fwd;
            var side = wc.sidewaysFriction; side.stiffness = _baseSideStiffness; wc.sidewaysFriction = side;
            _wheels[i] = wc;
            if (boneWheels)
            {
                _wheelVisuals[i] = null;
            }
            else
            {
                var vis = GameObject.CreatePrimitive(PrimitiveType.Cylinder);
                vis.name = "WheelMesh";
                Destroy(vis.GetComponent<CapsuleCollider>());
                vis.transform.SetParent(wgo.transform, false);
                vis.transform.localScale    = new Vector3(wheelRadius * 2f, 0.12f, wheelRadius * 2f);
                vis.transform.localRotation = Quaternion.Euler(0f, 0f, 90f);
                _wheelVisuals[i] = vis.transform;
            }
        }
        if (boneWheels && GetComponent<VehicleBoneDriver>() == null)
            gameObject.AddComponent<VehicleBoneDriver>();

        for (int side = -1; side <= 1; side += 2)
        {
            var hgo = new GameObject("Headlight");
            hgo.transform.SetParent(transform, false);
            hgo.transform.localPosition = new Vector3(0.6f * side, 0.6f, 2.0f);
            hgo.transform.localRotation = Quaternion.Euler(10f, 0f, 0f);
            var hl = hgo.AddComponent<Light>();
            hl.type = LightType.Spot; hl.range = 35f; hl.spotAngle = 70f; hl.intensity = 0f;
            _headlights.Add(hl);
        }
        var bgo = new GameObject("BrakeLight");
        bgo.transform.SetParent(transform, false);
        bgo.transform.localPosition = new Vector3(0f, 0.6f, -2.0f);
        _brakeLight = bgo.AddComponent<Light>();
        _brakeLight.type = LightType.Point; _brakeLight.color = Color.red;
        _brakeLight.range = 4f; _brakeLight.intensity = 0f;

        var sgo = new GameObject("DriftSmoke");
        sgo.transform.SetParent(transform, false);
        sgo.transform.localPosition = new Vector3(0f, 0.2f, -1.8f);
        _smoke = sgo.AddComponent<ParticleSystem>();
        var main = _smoke.main;
        main.startSize = 0.8f; main.startLifetime = 1.2f;
        main.startSpeed = 1.5f; main.startColor = new Color(0.85f, 0.85f, 0.85f, 0.5f);
        var em = _smoke.emission; em.rateOverTime = 0f;
    }

{% if is_bike %}
    private Transform[] FindWheelBones(Transform root)
    {
        // Front/rear only — a bike has no left/right wheel pair to disambiguate.
        Transform f = null, r = null;
        foreach (var t in root.GetComponentsInChildren<Transform>(true))
        {
            if (t.GetComponent<Renderer>() != null) continue;
            string n = t.name.ToLowerInvariant();
            if (!n.StartsWith("wheel")) continue;
            bool front = n.Contains(".f") || n.Contains("front");
            if (front) { if (f == null) f = t; }
            else       { if (r == null) r = t; }
        }
        return (f != null && r != null) ? new[] { f, r } : null;
    }
{% else %}
    private Transform[] FindWheelBones(Transform root)
    {
        Transform fl = null, fr = null, rl = null, rr = null;
        foreach (var t in root.GetComponentsInChildren<Transform>(true))
        {
            if (t.GetComponent<Renderer>() != null) continue;
            string n = t.name.ToLowerInvariant();
            if (!n.StartsWith("wheel")) continue;
            bool front = n.Contains(".f") || n.Contains("front");
            bool left  = n.EndsWith("l")  || n.Contains("left");
            if (front && left)  fl = t;
            else if (front)     fr = t;
            else if (left)      rl = t;
            else                rr = t;
        }
        return (fl != null && fr != null && rl != null && rr != null)
            ? new[] { fl, fr, rl, rr } : null;
    }
{% endif %}
