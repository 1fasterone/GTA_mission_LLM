            _box.size = new Vector2(1f, 2f);
            _box.offset = new Vector2(0f, 1f);
        }
{% if variant == "2d_topdown" %}
        _rb.gravityScale = 0f;
{% endif %}
{% elif variant == "vehicle_hover" %}
        _rb = GetComponent<Rigidbody>();
        if (_rb == null) _rb = gameObject.AddComponent<Rigidbody>();
        // 1200f matches the physics micro's vehicle mass (unity_compose
        // phys_opts) — the two Awake()s race for Rigidbody.mass otherwise.
        // Hover forces all use ForceMode.Acceleration, so feel is unchanged
        // by the exact value; agreeing with the composer is what matters.
        _rb.mass = 1200f;
        // Gravity stays ON — the hover springs are what hold the craft up, so
        // losing ground contact makes it fall, which is the intended feel.
        _rb.useGravity     = true;
        _rb.angularDamping = 4f;
        _rb.centerOfMass   = new Vector3(0f, -0.2f, 0f);
        _rb.interpolation  = RigidbodyInterpolation.Interpolate;
        BuildCar();
{% elif variant.startswith("vehicle_") %}
        _rb = GetComponent<Rigidbody>();
        if (_rb == null) _rb = gameObject.AddComponent<Rigidbody>();
{% if is_bike %}
        _rb.mass = 180f;
        _rb.centerOfMass = new Vector3(0f, -0.3f, 0f);
        // Two WheelColliders give a rigidbody no inherent roll/pitch
        // stability — freeze those axes here so the bike cannot topple, and
        // fake the bank into a turn purely visually (below) instead.
        _rb.constraints = RigidbodyConstraints.FreezeRotationX | RigidbodyConstraints.FreezeRotationZ;
{% else %}
        _rb.mass = 1200f;
        _rb.centerOfMass = new Vector3(0f, -0.4f, 0f);
{% endif %}
        BuildCar();
{% elif variant == "aircraft" %}
        _rb = GetComponent<Rigidbody>();
        if (_rb == null) _rb = gameObject.AddComponent<Rigidbody>();
        _rb.mass          = 2000f;
        _rb.drag          = 0.5f;
        _rb.angularDamping = 2.5f;
        _rb.useGravity    = false;
{% else %}
        _cc = GetComponent<CharacterController>();
        if (_cc == null) _cc = gameObject.AddComponent<CharacterController>();
{% if variant == "climbing" %}
        _cc.height = 1.8f;
        _cc.radius = 0.35f;
        _cc.center = new Vector3(0f, 0.9f, 0f);
        _cc.stepOffset = 0.05f;
        _cc.slopeLimit = 89f;
{% endif %}
{% endif %}
{% if variant == "first_person" %}
        // Reuse an authored "Eye" child if the scene already has one, otherwise
        // build it — the camera rig finds it by name, so it must exist by Awake.
        _eye = transform.Find("Eye");
        if (_eye == null)
        {
            var _eyeGo = new GameObject("Eye");
            _eyeGo.transform.SetParent(transform, false);
            _eye = _eyeGo.transform;
        }
        _eye.localPosition = new Vector3(0f, eyeHeight, 0f);
        _eye.localRotation = Quaternion.identity;
        if (lockCursor)
        {
            Cursor.lockState = CursorLockMode.Locked;
            Cursor.visible   = false;
        }
{% endif %}
{% if "shoot" in s.abilities %}
        _currentAmmo = weaponMagazineSize[_weaponIndex];
        _reserveAmmo = startingReserveAmmo;
{% if has_physical_projectiles %}        InitializeProjectilePools();
{% endif %}{% endif %}
{% if "throw_grenade" in s.abilities %}
        _grenadesLeft = maxGrenades;
{% endif %}
{% if "aim_down_sights" in s.abilities %}
        _defaultFov = Camera.main != null ? Camera.main.fieldOfView : 60f;
{% endif %}
{% if s.awake_extra %}
        // ── prompt-specific ──
{{ s.awake_extra | indent(8, True) }}
{% endif %}
    }

    // ═══ INPUT SO EVENT WIRING ═══════════════════════════════════════════════
{% if not variant.startswith("vehicle_") and variant != "aircraft" %}
    private void OnEnable()
    {
        if (_inputSO == null) return;
        _inputSO.OnMove           += OnMoveEvent;
        _inputSO.OnJump           += OnJumpEvent;
        _inputSO.OnSprint         += OnSprintStart;
        _inputSO.OnSprintReleased += OnSprintEnd;
    }

    private void OnDisable()
    {
        if (_inputSO == null) return;
        _inputSO.OnMove           -= OnMoveEvent;
        _inputSO.OnJump           -= OnJumpEvent;
        _inputSO.OnSprint         -= OnSprintStart;
        _inputSO.OnSprintReleased -= OnSprintEnd;
    }

    /// <summary>Called by GameWiring.Awake via WireInputToController atom.</summary>
    public void SetInputReader(IInputReader inputSO)
    {
        OnDisable();
        _inputSO = inputSO;
        OnEnable();
    }

    private void OnMoveEvent(Vector2 move) => _moveInput     = move;
    private void OnJumpEvent()             => _jumpThisFrame = true;
    private void OnSprintStart()           => _sprintHeld    = true;
    private void OnSprintEnd()             => _sprintHeld    = false;
{% endif %}

    // ═══ UPDATE ══════════════════════════════════════════════════════════════
    private void Update()
    {
{% if s.input_backend == "input_system" %}
        var kb    = Keyboard.current;
        var mouse = Mouse.current;
{% endif %}
{% if variant == "climbing" %}
        UpdateClimbing();
        return;
{% endif %}
{% if variant == "first_person" %}

        // ── Eye height fit ────────────────────────────────────────────────────
        // The player model is swapped in at runtime (ModelSwap), so its real
        // height is unknown at Awake. Fit the eye to it on the first frame that
        // has renderers: a Kenney astronaut is ~0.8 m tall, and a fixed 1.6 m
        // eye would float a head's length above the body it belongs to.
        if (!_eyeFitted && _eye != null)
        {
            var _rends = GetComponentsInChildren<Renderer>();
            if (_rends.Length > 0)
            {
                var _b = _rends[0].bounds;
                for (int i = 1; i < _rends.Length; i++) _b.Encapsulate(_rends[i].bounds);
                if (_b.size.y > 0.05f)
                {
                    _eye.position = new Vector3(_eye.position.x,
                                                _b.max.y - _b.size.y * 0.12f,
                                                _eye.position.z);
                }
                _eyeFitted = true;
            }
        }

        // ── Mouse look ────────────────────────────────────────────────────────
        // Yaw on the BODY so movement follows the view; pitch on the eye only.
{% if s.input_backend == "input_system" %}
        // Input System reports a raw pixel delta, unlike the legacy axis which
        // is already frame-normalised — 0.05 brings the two to the same feel.
        Vector2 _look = mouse != null ? mouse.delta.ReadValue() * 0.05f : Vector2.zero;
        float _lookX = _look.x;
        float _lookY = _look.y;
{% else %}
        float _lookX = Input.GetAxisRaw("Mouse X");
        float _lookY = Input.GetAxisRaw("Mouse Y");
{% endif %}
        if (_lookX != 0f) transform.Rotate(0f, _lookX * lookSensitivity, 0f);
        _pitch = Mathf.Clamp(_pitch - _lookY * lookSensitivity, pitchMin, pitchMax);
        if (_eye != null) _eye.localRotation = Quaternion.Euler(_pitch, 0f, 0f);
{% endif %}

        // ── Base locomotion input ─────────────────────────────────────────────
{% if not variant.startswith("vehicle_") and variant != "aircraft" %}
        if (_inputSO == null)
        {
{% if s.input_backend == "input_system" %}
            if (kb != null)
            {
                _moveInput  = new Vector2(
                    (kb.dKey.isPressed ? 1f : 0f) - (kb.aKey.isPressed ? 1f : 0f),
                    (kb.wKey.isPressed ? 1f : 0f) - (kb.sKey.isPressed ? 1f : 0f));
{% if "sprint" in s.abilities %}
                _sprintHeld = kb.leftShiftKey.isPressed;
{% endif %}
{% if "jump" in s.abilities or "double_jump" in s.abilities %}
                if (kb.spaceKey.wasPressedThisFrame) _jumpThisFrame = true;
{% endif %}
            }
{% else %}
            _moveInput = new Vector2(Input.GetAxisRaw("Horizontal"), Input.GetAxisRaw("Vertical"));
{% if "sprint" in s.abilities %}
            _sprintHeld = Input.GetKey(KeyCode.LeftShift);
{% endif %}
{% if "jump" in s.abilities or "double_jump" in s.abilities %}
            if (Input.GetButtonDown("Jump")) _jumpThisFrame = true;
{% endif %}
{% endif %}
        }
        float h          = _moveInput.x;
        float v          = _moveInput.y;
        bool  sprintHeld = _sprintHeld;
        bool  jumpPressed = _jumpThisFrame;
{% endif %}

{% if "crouch" in s.abilities and not variant.startswith("vehicle_") and variant != "aircraft" %}
        // ── Crouch ─────────────────────────────────────────────────────────
{% if s.input_backend == "input_system" %}
        bool crouchHeld = kb != null && kb.leftCtrlKey.isPressed;
{% else %}
        bool crouchHeld = Input.GetKey(KeyCode.LeftControl);
{% endif %}
        if (crouchHeld != _crouching)
        {
            _crouching = crouchHeld;
            if (_cc != null)
            {
                _cc.height = crouchHeld ? crouchHeight * 2f : 2.0f;
                _cc.center = new Vector3(0f, _cc.height * 0.5f, 0f);
            }
            transform.localScale = new Vector3(1f, crouchHeld ? crouchHeight : 1f, 1f);
        }
        float speed = sprintHeld && !_crouching ? sprintSpeed
                    : _crouching               ? crouchSpeed
                    :                            moveSpeed;
{% elif not variant.startswith("vehicle_") and variant != "aircraft" %}
        float speed = sprintHeld ? sprintSpeed : moveSpeed;
{% endif %}
{% if "aim_down_sights" in s.abilities %}
        if (_isAiming) speed *= adsSpeedMultiplier;
{% endif %}

{% if not variant.startswith("vehicle_") and variant != "aircraft" %}
        speed *= Mathf.Max(0f, 1f + (ReadStat?.Invoke("speed") ?? 0f));
{% endif %}

        // ── Per-variant movement ──────────────────────────────────────────────
{% if variant == "climbing" %}
        // Climbing is handled at the top of Update so free locomotion code
        // below cannot accidentally detach the player from the wall route.
{% elif variant in ("2d_platformer", "2d_fighting") %}
        // Locked while riding a mountable vehicle (e.g. Bike.cs.j2) — that
        // component drives its own Rigidbody2D and the player transform rides
        // along parented to it; this guard just stops THIS component's own
        // walk/jump from fighting that motion. SendMessage-only coupling (no
        // compile-time reference either direction), same convention as every
        // other cross-micro hook in this file.
        if (!_movementLocked)
        {
        Vector2 vel2 = _rb.linearVelocity;
        vel2.x = h * speed;
        _rb.linearVelocity = vel2;
        _grounded = CheckGrounded2D();
        if (jumpPressed && _grounded)
            _rb.linearVelocity = new Vector2(_rb.linearVelocity.x, jumpForce);
{% if variant == "2d_fighting" %}
        if (Mathf.Abs(h) > 0.01f) _facing = Mathf.Sign(h);
{% endif %}
        }
{% elif variant == "2d_topdown" %}
        _rb.linearVelocity = new Vector2(h, v).normalized * speed;
{% elif variant == "top_down" %}
        Vector3 move3 = new Vector3(h, 0f, v).normalized * speed;
{% if "fly" in s.abilities %}
{% if s.input_backend == "input_system" %}
        bool flyHeld = kb != null && kb.leftShiftKey.isPressed;
{% else %}
        bool flyHeld = Input.GetKey(KeyCode.LeftShift);
{% endif %}
        if (flyHeld) move3.y = flySpeed;
{% endif %}
        _cc.Move(move3 * Time.deltaTime);
{% elif variant == "platformer_2_5d" %}
        // 2.5D: real 3D CharacterController, but input drives ONLY the lateral
        // (world X) axis — depth (Z) stays locked so the player reads as a
        // side-scroller even though the world/models are fully 3D.
        _velocity.x = h * speed;
        _velocity.z = 0f;
        _grounded = CheckGrounded3D();
        if (_grounded && _velocity.y < 0f) _velocity.y = -2f;
{% if "jump" in s.abilities %}
        if (jumpPressed && _grounded) _velocity.y = jumpForce;
{% endif %}
{% if "double_jump" in s.abilities %}
        else if (jumpPressed && !_grounded && _airJumpsLeft > 0)
        {
            _velocity.y = jumpForce;
            _airJumpsLeft--;
        }
        if (_grounded) _airJumpsLeft = MaxAirJumps;
{% endif %}
        _velocity.y += Physics.gravity.y * Time.deltaTime;
        _cc.Move(_velocity * Time.deltaTime);
        // Face the direction of travel (flip left/right, no free 3D rotation).
        if (Mathf.Abs(h) > 0.01f)
            transform.rotation = Quaternion.Euler(0f, h > 0f ? 90f : -90f, 0f);
{% elif variant in ("first_person", "third_person", "fighting") %}
        Vector3 input3 = transform.right * h + transform.forward * v;
        _velocity.x = input3.x * speed;
        _velocity.z = input3.z * speed;
{% if variant in ("third_person", "fighting") %}
        // Third-person follow cameras use the player root as their orientation
        // anchor. Turn toward travel so the authored camera offset stays behind
        // the blacksmith instead of orbiting a stale heading.
        if (input3.sqrMagnitude > 0.0001f)
        {
            Quaternion desiredRotation = Quaternion.LookRotation(
                input3.normalized, Vector3.up);
            transform.rotation = Quaternion.Slerp(
                transform.rotation, desiredRotation,
                1f - Mathf.Exp(-12f * Time.deltaTime));
        }
{% endif %}
        _grounded = CheckGrounded3D();
        if (_grounded && _velocity.y < 0f) _velocity.y = -2f;
{% if "jump" in s.abilities %}
        if (jumpPressed && _grounded) _velocity.y = jumpForce;
{% endif %}
{% if "double_jump" in s.abilities %}
        else if (jumpPressed && !_grounded && _airJumpsLeft > 0)
        {
            _velocity.y = jumpForce;
            _airJumpsLeft--;
        }
        if (_grounded) _airJumpsLeft = MaxAirJumps;
{% endif %}
        _velocity.y += Physics.gravity.y * Time.deltaTime;
{% if "fly" in s.abilities %}
{% if s.input_backend == "input_system" %}
        bool flyHeld = kb != null && kb.leftShiftKey.isPressed;
{% else %}
        bool flyHeld = Input.GetKey(KeyCode.LeftShift);
{% endif %}
        if (flyHeld) _velocity.y = flySpeed;
{% endif %}
        _cc.Move(_velocity * Time.deltaTime);
{% elif variant == "flying" %}
{% if s.input_backend == "input_system" %}
        bool flyAscend  = kb != null && kb.spaceKey.isPressed;
        bool flyDescend = kb != null && kb.leftCtrlKey.isPressed;
{% else %}
        bool flyAscend  = Input.GetKey(KeyCode.Space);
        bool flyDescend = Input.GetKey(KeyCode.LeftControl);
{% endif %}
        Vector3 flyDir = transform.right * h + transform.forward * v;
        flyDir.y += (flyAscend ? 1f : 0f) - (flyDescend ? 1f : 0f);
        _cc.Move(flyDir.normalized * speed * Time.deltaTime);
{% elif variant == "swimming" %}
{% if s.input_backend == "input_system" %}
        bool swimUp   = kb != null && kb.spaceKey.isPressed;
        bool swimDown = kb != null && kb.leftCtrlKey.isPressed;
{% else %}
        bool swimUp   = Input.GetKey(KeyCode.Space);
        bool swimDown = Input.GetKey(KeyCode.LeftControl);
{% endif %}
        Vector3 swimDir = transform.right * h + transform.forward * v;
        swimDir.y = (swimUp ? 1f : 0f) - (swimDown ? 1f : 0f);
        _cc.Move(swimDir.normalized * speed * Time.deltaTime);
{% elif variant == "aircraft" %}
        // ── Aircraft: pitch / roll / yaw / throttle ───────────────────────
{% if s.input_backend == "input_system" %}
        float pitchInput = kb != null ? (kb.sKey.isPressed ? -1f : 0f) + (kb.wKey.isPressed ? 1f : 0f) : 0f;
        float rollInput  = kb != null ? (kb.dKey.isPressed ?  1f : 0f) + (kb.aKey.isPressed ? -1f : 0f) : 0f;
        float yawInput   = kb != null ? (kb.eKey.isPressed ?  1f : 0f) + (kb.qKey.isPressed ? -1f : 0f) : 0f;
        bool throtUp     = kb != null && kb.leftShiftKey.isPressed;
        bool throtDown   = kb != null && kb.leftCtrlKey.isPressed;
{% else %}
        float pitchInput = -Input.GetAxisRaw("Vertical");
        float rollInput  = Input.GetAxisRaw("Horizontal");
        float yawInput   = (Input.GetKey(KeyCode.E) ? 1f : 0f) - (Input.GetKey(KeyCode.Q) ? 1f : 0f);
        bool throtUp     = Input.GetKey(KeyCode.LeftShift);
        bool throtDown   = Input.GetKey(KeyCode.LeftControl);
{% endif %}
        _throttle = Mathf.Clamp01(_throttle + (throtUp ? 1f : throtDown ? -1f : 0f) * throttleRate * Time.deltaTime);
        transform.Rotate(
            pitchInput * pitchSpeed * Time.deltaTime,
            yawInput   * yawSpeed   * Time.deltaTime,
            -rollInput * rollSpeed  * Time.deltaTime,
            Space.Self
        );
        if (_rb != null)
        {
            _rb.AddForce(transform.forward * (_throttle * maxThrust), ForceMode.Force);
            float spd = _rb.linearVelocity.magnitude;
            if (spd > stallSpeed)
                _rb.AddForce(Vector3.up * liftCoefficient * Mathf.Clamp01(spd / maxAirSpeed), ForceMode.Force);
            if (spd > maxAirSpeed)
                _rb.linearVelocity = _rb.linearVelocity.normalized * maxAirSpeed;
        }
{% elif variant == "vehicle_hover" %}
        // ── Hover craft: raycast spring-damper + thrust ───────────────────
        // No WheelColliders: four downward probes hold the hull at
        // hoverRideHeight, thrust drives it along its own forward axis, and
        // sideways velocity is bled off so it tracks a lane instead of sliding.
{% if s.input_backend == "input_system" %}
        float h = kb != null ? (kb.dKey.isPressed ? 1f : 0f) - (kb.aKey.isPressed ? 1f : 0f) : 0f;
        float v = kb != null ? (kb.wKey.isPressed ? 1f : 0f) - (kb.sKey.isPressed ? 1f : 0f) : 0f;
        bool brake        = kb != null && kb.spaceKey.isPressed;
        bool boostDown    = kb != null && kb.leftShiftKey.wasPressedThisFrame;
        bool lightsToggle = kb != null && kb.hKey.wasPressedThisFrame;
{% else %}
        float h = Input.GetAxisRaw("Horizontal");
        float v = Input.GetAxisRaw("Vertical");
        bool brake        = Input.GetKey(KeyCode.Space);
        bool boostDown    = Input.GetKeyDown(KeyCode.LeftShift);
        bool lightsToggle = Input.GetKeyDown(KeyCode.H);
{% endif %}
        // Input is sampled here; every Rigidbody force is applied in
        // FixedUpdate below, so the craft's motion is step-rate independent.
        _steerInput    = h;
        _throttleInput = Mathf.Clamp01(Mathf.Abs(v));
        _driveInput    = v;
        _brakeHeld     = brake;
        if (boostDown && !_boostActive && _boostCooldown <= 0f)
        {
            _boostActive = true;
            _boostTimer  = boostDuration;
        }

        if (lightsToggle)
        {
            _lightsOn = !_lightsOn;
            foreach (var l in _headlights) l.intensity = _lightsOn ? 2.5f : 0f;
        }
        if (_brakeLight != null)
            _brakeLight.intensity = (v < -0.1f || brake) ? 3f : 0f;
        if (_thrusterFx != null)
        {
            var em = _thrusterFx.emission;
            em.rateOverTime = _boostActive ? 120f : (v > 0.1f ? 40f : 0f);
        }
        if (_boostActive)
        {
            _boostTimer -= Time.deltaTime;
            if (_boostTimer <= 0f) { _boostActive = false; _boostCooldown = boostCooldown; }
        }
        else if (_boostCooldown > 0f) _boostCooldown -= Time.deltaTime;
{% elif variant.startswith("vehicle_") %}
        // ── Vehicle: WheelCollider rig ────────────────────────────────────
{% if s.input_backend == "input_system" %}
        float h = kb != null ? (kb.dKey.isPressed ? 1f : 0f) - (kb.aKey.isPressed ? 1f : 0f) : 0f;
        float v = kb != null ? (kb.wKey.isPressed ? 1f : 0f) - (kb.sKey.isPressed ? 1f : 0f) : 0f;
        bool handbrake    = kb != null && kb.spaceKey.isPressed;
        bool lightsToggle = kb != null && kb.hKey.wasPressedThisFrame;
{% else %}
        float h = Input.GetAxisRaw("Horizontal");
        float v = Input.GetAxisRaw("Vertical");
        bool handbrake    = Input.GetKey(KeyCode.Space);
        bool lightsToggle = Input.GetKeyDown(KeyCode.H);
{% endif %}
        float motor = v * maxMotorTorque;
        float steer = h * maxSteerAngle;
        _steerInput    = h;
        _throttleInput = Mathf.Clamp01(Mathf.Abs(v));

        if (handbrake && _rb.linearVelocity.sqrMagnitude > 1f)
        {
            float slip = Vector3.SignedAngle(transform.forward,
                                             _rb.linearVelocity.normalized, Vector3.up);
            steer = Mathf.Clamp(steer + slip * 0.5f, -maxSteerAngle * 1.5f, maxSteerAngle * 1.5f);
        }

{% if "nitro" in s.abilities %}
        // ── Nitro ─────────────────────────────────────────────────────────
{% if s.input_backend == "input_system" %}
        bool nitroDown = kb != null && kb.nKey.wasPressedThisFrame;
{% else %}
        bool nitroDown = Input.GetKeyDown(KeyCode.N);
{% endif %}
        if (nitroDown && !_nitroActive && _nitroCooldown <= 0f)
            StartCoroutine(NitroRoutine());
        if (_nitroCooldown > 0f) _nitroCooldown -= Time.deltaTime;
        if (_nitroActive) motor *= nitroMultiplier;
{% endif %}

        for (int i = 0; i < {{ wheel_count }}; i++)
        {
            var wc = _wheels[i];
            if (wc == null) continue;
            if (i < {{ wheel_count // 2 }}) wc.steerAngle  = steer;
            wc.motorTorque  = i >= {{ wheel_count // 2 }} ? motor : 0f;
            wc.brakeTorque  = handbrake && i >= {{ wheel_count // 2 }} ? handbrakeTorque : 0f;
            var sf = wc.sidewaysFriction;
            sf.stiffness = (handbrake && i >= {{ wheel_count // 2 }}) ? _baseSideStiffness * driftSlipMultiplier : _baseSideStiffness;
            wc.sidewaysFriction = sf;
            if (_wheelVisuals[i] != null)
            {
                wc.GetWorldPose(out Vector3 wPos, out Quaternion wRot);
                _wheelVisuals[i].SetPositionAndRotation(wPos, wRot * Quaternion.Euler(0f, 0f, 90f));
            }
        }
{% if is_bike %}
        // ── Lean (visual only — the rigidbody stays upright via the Awake()
        // rotation freeze; nothing here touches physics) ──────────────────
        float _leanSpeedFactor = Mathf.Clamp01(Mathf.Abs(ForwardSpeed) / 6f);
        float _targetLean = -_steerInput * maxLeanAngle * _leanSpeedFactor;
        _currentLean = Mathf.MoveTowards(_currentLean, _targetLean, leanSpeed * Time.deltaTime);
        if (_leanPivot != null)
            _leanPivot.localRotation = Quaternion.Euler(0f, 0f, _currentLean);
{% endif %}
        if (lightsToggle)
        {
            _lightsOn = !_lightsOn;
            foreach (var l in _headlights) l.intensity = _lightsOn ? 2.5f : 0f;
        }
        if (_brakeLight != null)
            _brakeLight.intensity = (v < -0.1f || handbrake) ? 3f : 0f;
        if (_smoke != null)
        {
            var em = _smoke.emission;
            em.rateOverTime = (handbrake && _rb.linearVelocity.magnitude > 3f) ? 60f : 0f;
        }
{% endif %}

        // ── Boost ─────────────────────────────────────────────────────────────
{% if "boost" in s.abilities and not variant.startswith("vehicle_") and variant != "aircraft" %}
{% if s.input_backend == "input_system" %}
        bool boostDown = kb != null && kb.qKey.wasPressedThisFrame;
{% else %}
        bool boostDown = Input.GetKeyDown(KeyCode.Q);
{% endif %}
        if (_boostCooldownTimer > 0f) _boostCooldownTimer -= Time.deltaTime;
        if (_boostTimer > 0f)
        {
            _boostTimer -= Time.deltaTime;
            speed        = sprintSpeed * boostMultiplier;
        }
        if (boostDown && _boostCooldownTimer <= 0f && _boostTimer <= 0f)
        {
            _boostTimer        = boostDuration;
            _boostCooldownTimer = boostCooldown;
        }
{% endif %}

        // ── Shooting ──────────────────────────────────────────────────────────
{% if "shoot" in s.abilities %}
{% if s.input_backend == "input_system" %}
        bool fireDown   = mouse != null && mouse.leftButton.isPressed;
        bool reloadDown = kb   != null && kb.rKey.wasPressedThisFrame;
{% else %}
        bool fireDown   = Input.GetMouseButton(0);
        bool reloadDown = Input.GetKeyDown(KeyCode.R);
{% endif %}
{% if "aim_down_sights" in s.abilities %}
{% if s.input_backend == "input_system" %}
        bool aimDown = mouse != null && mouse.rightButton.isPressed;
{% else %}
        bool aimDown = Input.GetMouseButton(1);
{% endif %}
        if (aimDown != _isAiming)
        {
            _isAiming = aimDown;
            if (Camera.main != null)
                Camera.main.fieldOfView = Mathf.Lerp(Camera.main.fieldOfView,
