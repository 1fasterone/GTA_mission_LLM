        float yawInput   = (Input.GetKey(KeyCode.E) ? 1f : 0f) - (Input.GetKey(KeyCode.Q) ? 1f : 0f);
        bool throtUp     = Input.GetKey(KeyCode.LeftShift);
        bool throtDown   = Input.GetKey(KeyCode.LeftControl);
{% endif %}
        _throttle = Mathf.Clamp01(_throttle + (throtUp ? 1f : throtDown ? -1f : 0f) * throttleRate * Time.deltaTime);
        transform.Rotate(
            pitchInput * pitchSpeed * Time.deltaTime,
            yawInput   * yawSpeed   * Time.deltaTime,
            -rollInput * rollSpeed  * Time.deltaTime,
            Space.Self
        );
        if (_rb != null)
        {
            _rb.AddForce(transform.forward * (_throttle * maxThrust), ForceMode.Force);
            float spd = _rb.linearVelocity.magnitude;
            if (spd > stallSpeed)
                _rb.AddForce(Vector3.up * liftCoefficient * Mathf.Clamp01(spd / maxAirSpeed), ForceMode.Force);
            if (spd > maxAirSpeed)
                _rb.linearVelocity = _rb.linearVelocity.normalized * maxAirSpeed;
        }
{% elif variant.startswith("vehicle_") %}
