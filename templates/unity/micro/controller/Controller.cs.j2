    // ═══ WALL-CONSTRAINED CLIMBING ══════════════════════════════════════════
    private void UpdateClimbing()
    {
        if (!_routeReady) BuildClimbingRoute();
        if (_routeHolds.Count == 0)
        {
            _climbing = false;
            _gripHeld = false;
            _grounded = false;
            _velocity += Physics.gravity * Time.deltaTime;
            _cc.Move(_velocity * Time.deltaTime);
            return;
        }

        if (_routeIndex < 0)
        {
            _routeIndex = FindNearestHold();
            transform.position = HoldRoot(_routeHolds[_routeIndex]);
        }

{% if s.input_backend == "input_system" %}
        var kb = Keyboard.current;
        var mouse = Mouse.current;
        bool grip = (kb == null || (!kb.qKey.isPressed
                    && !(mouse != null && mouse.rightButton.isPressed)))
                    && Time.time >= _forcedReleaseUntil;
        Vector2 climbInput = kb == null ? Vector2.zero : new Vector2(
            (kb.dKey.isPressed ? 1f : 0f) - (kb.aKey.isPressed ? 1f : 0f),
            (kb.wKey.isPressed ? 1f : 0f) - (kb.sKey.isPressed ? 1f : 0f));
{% else %}
        // The climber starts attached to the first hold. Right mouse/Q is the
        // explicit release gesture; movement keys choose the next hold.
        bool grip = !Input.GetMouseButton(1) && !Input.GetKey(KeyCode.Q)
                    && Time.time >= _forcedReleaseUntil;
        Vector2 climbInput = new Vector2(Input.GetAxisRaw("Horizontal"),
                                         Input.GetAxisRaw("Vertical"));
{% endif %}
        _gripHeld = grip;

        if (!grip)
        {
            if (_climbing)
            {
                _climbing = false;
                _velocity = new Vector3(0f, -2f, 0f);
                SendMessage("OnGripReleased", SendMessageOptions.DontRequireReceiver);
            }
            _grounded = false;
            _velocity += Physics.gravity * Time.deltaTime;
            _cc.Move(_velocity * Time.deltaTime);
            SendMessage("SetClimbing", false, SendMessageOptions.DontRequireReceiver);
            return;
        }

        if (!_climbing)
        {
            _climbing = true;
            _velocity = Vector3.zero;
        }
        if (_routeInputCooldown > 0f)
            _routeInputCooldown -= Time.deltaTime;

        if (_routeInputCooldown <= 0f && climbInput.sqrMagnitude > 0.04f)
        {
            int next = FindReachableHold(climbInput);
            if (next >= 0 && next != _routeIndex)
            {
                _routeIndex = next;
                _routeInputCooldown = 0.16f;
                SendMessage("OnClimbHoldChanged", _routeIndex,
                            SendMessageOptions.DontRequireReceiver);
            }
        }

        Vector3 target = HoldRoot(_routeHolds[_routeIndex]);
        Vector3 delta = target - transform.position;
        float step = Mathf.Max(2.5f, moveSpeed) * Time.deltaTime;
        _cc.Move(Vector3.ClampMagnitude(delta, step));
        _velocity = delta / Mathf.Max(Time.deltaTime, 0.0001f);
        _grounded = true;

        // The wall normal points from the face toward the climber. Looking at
        // -normal keeps the avatar aligned to the rock instead of rotating
        // toward free-movement input.
        Quaternion wallRotation = Quaternion.LookRotation(-_wallNormal, Vector3.up);
        transform.rotation = Quaternion.Slerp(
            transform.rotation, wallRotation,
            1f - Mathf.Exp(-14f * Time.deltaTime));
        SendMessage("SetClimbing", true, SendMessageOptions.DontRequireReceiver);
    }

    private void BuildClimbingRoute()
    {
        _routeReady = true;
        _routeHolds.Clear();
        try
        {
            foreach (string tag in new[] { "Hold", "Platform" })
            {
                foreach (GameObject go in GameObject.FindGameObjectsWithTag(tag))
                    if (go != null && !_routeHolds.Contains(go.transform))
                        _routeHolds.Add(go.transform);
            }
        }
        catch (UnityException) { }

        if (_routeHolds.Count == 0) return;
        float plane = 0f;
        foreach (Transform hold in _routeHolds) plane += hold.position.z;
        _wallPlaneZ = plane / _routeHolds.Count;
        _wallNormal = transform.position.z >= _wallPlaneZ
            ? Vector3.forward : Vector3.back;

        // Stable insertion sort: y is the route axis and x is the tie-break.
        for (int i = 1; i < _routeHolds.Count; i++)
        {
            Transform item = _routeHolds[i];
            int j = i - 1;
            while (j >= 0 && (item.position.y < _routeHolds[j].position.y
                   || (Mathf.Abs(item.position.y - _routeHolds[j].position.y) < 0.001f
                       && item.position.x < _routeHolds[j].position.x)))
            {
                _routeHolds[j + 1] = _routeHolds[j];
                j--;
            }
            _routeHolds[j + 1] = item;
        }
    }

    private int FindNearestHold()
    {
        int best = 0;
        float bestDistance = float.MaxValue;
        for (int i = 0; i < _routeHolds.Count; i++)
        {
            float distance = (HoldRoot(_routeHolds[i]) - transform.position).sqrMagnitude;
            if (distance < bestDistance)
            {
                best = i;
                bestDistance = distance;
            }
        }
        return best;
    }

    private int FindReachableHold(Vector2 input)
    {
        int best = -1;
        float bestScore = float.MaxValue;
        Vector3 current = _routeHolds[_routeIndex].position;
        for (int i = 0; i < _routeHolds.Count; i++)
        {
            if (i == _routeIndex) continue;
            Vector3 candidate = _routeHolds[i].position;
            float dy = candidate.y - current.y;
            bool vertical = Mathf.Abs(input.y) >= Mathf.Abs(input.x);
            if (vertical)
            {
                if (input.y > 0f && dy <= 0.05f) continue;
                if (input.y < 0f && dy >= -0.05f) continue;
                if (Mathf.Abs(candidate.x - current.x) > 3.0f) continue;
                float score = Mathf.Abs(dy) + Mathf.Abs(candidate.x - current.x) * 0.35f;
                if (score < bestScore) { best = i; bestScore = score; }
            }
            else
            {
                if (Mathf.Abs(dy) > 0.9f) continue;
                if (input.x > 0f && candidate.x <= current.x) continue;
                if (input.x < 0f && candidate.x >= current.x) continue;
                float score = Mathf.Abs(candidate.x - current.x);
                if (score < bestScore) { best = i; bestScore = score; }
            }
        }
        return best;
    }

    private Vector3 HoldRoot(Transform hold)
    {
        return hold.position + _wallNormal * WallStandOff
            + Vector3.down * ClimbHandOffset;
    }
