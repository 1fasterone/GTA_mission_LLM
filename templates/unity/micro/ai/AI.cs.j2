            Vector3 targetEye = _target.position   + Vector3.up * eyeHeight;
            Vector3 dir       = targetEye - eye;
            if (dir.sqrMagnitude > 0.0001f) eye += dir.normalized * 0.35f;
            if (Physics.Linecast(eye, targetEye, out RaycastHit hit)
                && hit.transform.root != _target.root)
                return false;
{%- endif %}
        }
        return true;
    }
{% if s.squad_alert_radius > 0 %}

    /// <summary>Called from UpdatePerception() the instant this AI newly
    /// senses the target — tells every same-archetype ally within
    /// squadAlertRadius, sharing WHERE (not granting them live tracking; each
    /// ally still needs its own sight/hearing to upgrade a search into a
    /// direct chase) AND assigning each responder a distinct approach role
    /// (alternating FlankLeft/FlankRight/Cover in range order) so the squad
    /// spreads out around the report instead of every responder converging
    /// on the identical point — see ApplySquadRoleOffset().</summary>
    private void AlertSquad()
    {
        int responderIndex = 0;
        foreach (var ally in _squad)
        {
            if (ally == null || ally == this) continue;
            if (Vector3.Distance(transform.position, ally.transform.position) <= squadAlertRadius)
            {
                SquadRole role = responderIndex % 3 == 0 ? SquadRole.FlankLeft
                                : responderIndex % 3 == 1 ? SquadRole.FlankRight
                                :                            SquadRole.Cover;
                ally.ReceiveAllyAlert(_lastKnownPosition, GetInstanceID(), role);
                responderIndex++;
            }
        }
    }

    /// <summary>SendMessage-free entry point a squadmate's AlertSquad() calls
    /// directly (same generated class only — see docs on squadAlertRadius).
    /// De-duplicated: the same caller (sourceId) re-reporting a position this
    /// AI already holds and still trusts (_alertUrgency > 0) is not new
    /// information — accepting it anyway would restart urgency/role every
    /// frame the whole time one squadmate keeps a stationary target in
    /// sight, instead of decaying toward "give up and use my own memory".</summary>
    public void ReceiveAllyAlert(Vector3 reportedPosition, int sourceId, SquadRole role)
    {
        if (sourceId == _alertSourceId && _alertUrgency > 0f
            && Vector3.Distance(reportedPosition, _lastKnownPosition) < 0.5f)
            return;

        _allyAlerted        = true;
        _alertSourceId      = sourceId;
        _alertUrgency       = 1f;
        _squadRole          = role;
        _lastKnownPosition  = reportedPosition;
        _searchTimer        = Mathf.Max(_searchTimer, memorySeconds);
    }

    /// <summary>Spreads a role-assigned responder's approach point sideways
    /// (Flank) or holds it back toward this AI's own position (Cover) —
    /// see ChaseDestination(), which only calls this while a secondhand
    /// report is still fresh (_alertUrgency > 0).</summary>
    private Vector3 ApplySquadRoleOffset(Vector3 dest)
    {
        if (_squadRole == SquadRole.None) return dest;
        Vector3 toDest = dest - transform.position;
{%- if s.nav_backend == "kinematic_2d" %}
        Vector3 lateral = new Vector3(-toDest.y, toDest.x, 0f);
{%- else %}
        Vector3 lateral = Vector3.Cross(Vector3.up, toDest);
{%- endif %}
        if (lateral.sqrMagnitude > 0.0001f) lateral.Normalize();
        switch (_squadRole)
        {
            case SquadRole.FlankLeft:  return dest - lateral * squadFlankOffset;
            case SquadRole.FlankRight: return dest + lateral * squadFlankOffset;
            case SquadRole.Cover:      return Vector3.Lerp(transform.position, dest, 0.5f);
            default:                   return dest;
        }
    }
{% endif %}
{% endif %}

    private void TryAttack()
    {
        _attackTimer -= Time.deltaTime;
        if (_attackTimer > 0f) return;
        _attackTimer = 1.0f;
{% if s.use_health_hook %}
        if (_target != null)
            _target.SendMessage("TakeDamage", 10f * DifficultyDamageMult(), SendMessageOptions.DontRequireReceiver);
{% endif %}
    }
{% if s.use_health_hook %}

    /// <summary>Scales this AI's attack damage by the main menu's difficulty
    /// selection (PlayerPrefs "Difficulty": Easy | Medium | Hard).</summary>
    private static float DifficultyDamageMult()
    {
        string diff = PlayerPrefs.GetString("Difficulty", "Medium");
        return diff == "Easy" ? 0.6f : diff == "Hard" ? 1.6f : 1f;
    }

{% if variant in ("fsm_guard", "behaviour_tree_lite") %}

    /// <summary>SendMessage target called by Health.cs.j2's TakeDamage — marks
    /// this AI hit for one Update() so a "took_damage" transition can fire.</summary>
    public void OnHurt() => _tookDamage = true;
{% endif %}
{% endif %}

    // DifficultyDamageMult() above only exists for variants with a health
    // hook — every variant moves and perceives, combat or not (a racing/
    // patrol AI has no health hook and got ZERO difficulty scaling before
    // this, the exact gap a hand-built racing game had to work around with
    // its own bespoke, non-reusable copy of this same idea). These two are
    // unconditional so movement-only AI shares in difficulty tuning too.
    private float EffectiveMoveSpeed      => moveSpeed * DifficultyMoveMult();
    private float EffectiveDetectionRadius => detectionRadius * DifficultySenseMult();

    /// <summary>Scales AI move speed by the main menu's difficulty
    /// selection. Narrower than DifficultyDamageMult()'s 0.6/1/1.6 — a
    /// slower-moving Easy AI still has to look plausible driving/walking
    /// around the same world.</summary>
    private static float DifficultyMoveMult()
    {
        string diff = PlayerPrefs.GetString("Difficulty", "Medium");
        return diff == "Easy" ? 0.85f : diff == "Hard" ? 1.15f : 1f;
    }

    /// <summary>Scales AI detection/hearing radius by difficulty — how
    /// early it notices the player. Wider swing than move speed: Easy
    /// should read as "reacts late," not just "slightly slower."</summary>
    private static float DifficultySenseMult()
    {
        string diff = PlayerPrefs.GetString("Difficulty", "Medium");
        return diff == "Easy" ? 0.70f : diff == "Hard" ? 1.40f : 1f;
    }

    private void OnDrawGizmosSelected()
    {
        Gizmos.color = Color.yellow; Gizmos.DrawWireSphere(transform.position, detectionRadius);
        Gizmos.color = Color.red;    Gizmos.DrawWireSphere(transform.position, attackRadius);
{% if _perception_variant %}
        if (visionAngle < 360f)
        {
            Gizmos.color = new Color(1f, 1f, 0f, 0.5f);
{%- if s.nav_backend == "kinematic_2d" %}
            Vector3 facing = transform.right;
{%- else %}
            Vector3 facing = transform.forward;
{%- endif %}
            Quaternion left  = Quaternion.AngleAxis(-visionAngle * 0.5f, Vector3.up);
            Quaternion right = Quaternion.AngleAxis( visionAngle * 0.5f, Vector3.up);
            Gizmos.DrawLine(transform.position, transform.position + (left  * facing) * detectionRadius);
            Gizmos.DrawLine(transform.position, transform.position + (right * facing) * detectionRadius);
        }
        if (hearingRadius > 0f)
        {
            Gizmos.color = Color.cyan;
            Gizmos.DrawWireSphere(transform.position, hearingRadius);
        }
{% if s.squad_alert_radius > 0 %}
        Gizmos.color = new Color(1f, 0.5f, 0f, 0.6f);
        Gizmos.DrawWireSphere(transform.position, squadAlertRadius);
{% endif %}
{% endif %}
    }
