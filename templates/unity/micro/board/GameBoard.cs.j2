            size.x / Mathf.Max(0.0001f, Mathf.Abs(ls.x)),
            size.y / Mathf.Max(0.0001f, Mathf.Abs(ls.y)),
            Mathf.Max(0.05f, size.z / Mathf.Max(0.0001f, Mathf.Abs(ls.z))));
