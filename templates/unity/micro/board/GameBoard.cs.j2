    // ── The parser ───────────────────────────────────────────────────────────

    /// <summary>Run one typed line and return what the terminal should print.
    ///
    /// Public and side-effect-complete: this IS the command surface, so a test
    /// (or a menu button, or a tutorial script) drives the game the same way
    /// the player does, with no UI in the way.</summary>
    public string Run(string line)
    {
        var argv = Tokenize(line);
        if (argv.Count == 0) return "";

        int i = 0;
        if (!string.IsNullOrEmpty(commandPrefix)
            && string.Equals(argv[0], commandPrefix, StringComparison.OrdinalIgnoreCase))
        {
            i = 1;
            if (argv.Count == 1) return "usage: " + commandPrefix + " <command>.  Type  help";
        }

        string verb = argv[i].ToLowerInvariant();
        var rest = argv.GetRange(i + 1, argv.Count - i - 1);
        StripFillers(rest);

        switch (verb)
        {
            case "help": case "?":                return HelpText();
            case "status": case "st":             return StatusText();
            case "zones": case "places": case "ls": case "list": return ZonesText();
            case "move": case "put": case "place": return CmdMove(rest);
        }

        foreach (var c in commands)
            if (c.verb == verb) return RunCommand(c, rest);

        return "'" + verb + "' is not a command here. Type  help";
    }

    /// <summary>Quote-aware split: a quoted phrase is ONE argument, so a
    /// message or a multi-word name survives the parser intact.</summary>
    public static List<string> Tokenize(string s)
    {
        var outp = new List<string>();
        if (string.IsNullOrEmpty(s)) return outp;
        var sb = new System.Text.StringBuilder();
        bool quoted = false;
        for (int i = 0; i < s.Length; i++)
        {
            char ch = s[i];
            if (ch == '"') { quoted = !quoted; continue; }
            if (!quoted && char.IsWhiteSpace(ch))
            {
                if (sb.Length > 0) { outp.Add(sb.ToString()); sb.Length = 0; }
                continue;
            }
            sb.Append(ch);
        }
        if (sb.Length > 0) outp.Add(sb.ToString());
        return outp;
    }

    /// <summary>"move the file into staging" reads better than "move file
    /// staging" and means the same thing. Dropped before resolution so the
    /// words never have to be part of a name.</summary>
    private static void StripFillers(List<string> argv)
    {
        for (int i = argv.Count - 1; i >= 0; i--)
        {
            string w = argv[i].ToLowerInvariant();
            if (argv.Count > 1 && (w == "to" || w == "into" || w == "onto" || w == "the"))
                argv.RemoveAt(i);
        }
    }

    private string CmdMove(List<string> argv)
    {
        if (argv.Count < 2)
            return "usage: move <piece> <place>   (or  move all <place>)";
        string whereRaw = argv[argv.Count - 1];
        string whatRaw  = string.Join(" ", argv.GetRange(0, argv.Count - 1).ToArray());

        var zone = ResolveZone(whereRaw);
        if (zone == null) return "there is no place called '" + whereRaw + "'. Type  zones";

        var targets = ResolvePieces(whatRaw);
        if (targets.Count == 0) return "nothing here is called '" + whatRaw + "'. Type  status";
        return MoveAll(targets, zone.groupId, "");
    }

    private string RunCommand(CommandSpec c, List<string> argv)
    {
        // A command with no destination moves nothing and says so — a verb like
        // `push` or `submit` is an announcement, and pretending it was a move
        // would put a piece somewhere the domain never said it goes.
        if (string.IsNullOrEmpty(c.toZone))
        {
            OnCommand?.Invoke(c.verb);
            return string.IsNullOrEmpty(c.help) ? c.verb + ": done" : c.help;
        }

        List<Piece> targets = null;
        if (c.takesTarget && argv.Count > 0)
        {
            string arg = string.Join(" ", argv.ToArray());
            targets = ResolvePieces(arg);
            if (targets.Count == 0)
                return "nothing here is called '" + arg + "'. Type  status";
        }
        if (targets == null || targets.Count == 0) targets = DefaultTargets(c);
        if (targets.Count == 0)
            return "nothing left to " + c.verb;
        return MoveAll(targets, c.toZone, c.verb);
    }

    /// <summary>What a command acts on when the player named nothing: every
    /// piece of the group it moves that is not already where it is going.</summary>
    private List<Piece> DefaultTargets(CommandSpec c)
    {
        var outp = new List<Piece>();
        foreach (var p in _pieces)
        {
            if (!string.IsNullOrEmpty(c.moves) && p.groupId != c.moves) continue;
            if (GroupOfZone(p.zoneId) == c.toZone) continue;
            outp.Add(p);
        }
        return outp;
    }

    private string MoveAll(List<Piece> targets, string zoneGroupId, string verb)
    {
        int moved = 0;
        string firstRefusal = "";
        foreach (var p in targets)
        {
            var z = FreeZoneOf(zoneGroupId, p);
            string reason;
            if (TryPlace(p, z, false, out reason)) moved++;
            else if (string.IsNullOrEmpty(firstRefusal)) firstRefusal = reason;
        }
        if (moved > 0 && !string.IsNullOrEmpty(verb)) OnCommand?.Invoke(verb);
        if (moved == 0) { Reject(firstRefusal); return ""; }
        return "  moved " + moved + " to " + GroupLabel(zoneGroupId)
             + (string.IsNullOrEmpty(firstRefusal) ? "" : "  (" + firstRefusal + ")");
    }

    /// <summary>Which instance of a zone group a command should use: the one
    /// holding the fewest pieces, so four folders fill evenly instead of one
    /// folder holding everything and three standing empty.</summary>
    private Zone FreeZoneOf(string zoneGroupId, Piece p)
    {
        Zone best = null;
        int bestCount = int.MaxValue;
        foreach (var z in _zones)
        {
            if (z.groupId != zoneGroupId) continue;
            int n = 0;
            foreach (var other in _pieces) if (other != p && other.zoneId == z.id) n++;
            if (n < bestCount) { bestCount = n; best = z; }
        }
        return best;
    }

    private Zone ResolveZone(string s)
    {
        string key = Slug(s);
        if (key.Length == 0) return null;
        foreach (var z in _zones) if (Slug(z.id) == key || Slug(z.label) == key) return z;
        foreach (var z in _zones) if (Slug(z.groupId) == key) return FreeZoneOf(z.groupId, null);
        foreach (var z in _zones)
            if (Slug(z.label).StartsWith(key) || Slug(z.groupId).StartsWith(key)) return z;
        return null;
    }

    /// <summary>`.` and `all` mean everything, a group name means that group,
    /// and anything else is one piece by the name it shows on screen.</summary>
    private List<Piece> ResolvePieces(string s)
    {
        var outp = new List<Piece>();
        string key = Slug(s);
        if (s == "." || s == "*" || key == "all" || key == "everything")
        {
            outp.AddRange(_pieces);
            return outp;
        }
        foreach (var p in _pieces) if (Slug(p.label) == key || Slug(p.id) == key) outp.Add(p);
        if (outp.Count > 0) return outp;
        foreach (var p in _pieces) if (Slug(p.groupId) == key) outp.Add(p);
        if (outp.Count > 0) return outp;
        foreach (var p in _pieces) if (Slug(p.label).StartsWith(key)) outp.Add(p);
        return outp;
    }

    private static string Slug(string s)
    {
        if (string.IsNullOrEmpty(s)) return "";
        var sb = new System.Text.StringBuilder(s.Length);
        foreach (char ch in s)
            if (char.IsLetterOrDigit(ch)) sb.Append(char.ToLowerInvariant(ch));
        return sb.ToString();
    }

    // ── What the parser prints ───────────────────────────────────────────────

    private string HelpText()
    {
        var sb = new System.Text.StringBuilder();
        string pre = string.IsNullOrEmpty(commandPrefix) ? "" : commandPrefix + " ";
        sb.AppendLine("  move <piece> <place>       put one piece somewhere");
        sb.AppendLine("  move all <place>           put every piece there");
        sb.AppendLine("  status                     where everything is");
        sb.AppendLine("  zones                      the places, and what they take");
        foreach (var c in commands)
            sb.AppendLine("  " + (pre + c.verb).PadRight(26) + " " + c.help);
        return sb.ToString().TrimEnd();
    }

    private string StatusText()
    {
        var sb = new System.Text.StringBuilder();
        foreach (var g in pieceGroups)
        {
            int total = TotalCount(g.id), placed = PlacedCount(g.id);
            if (total == 0) continue;
            sb.AppendLine("  " + GroupLabel(g.id) + ": " + placed + " / " + total + " placed");
            foreach (var p in _pieces)
            {
                if (p.groupId != g.id) continue;
                sb.AppendLine("    " + p.label.PadRight(22) + " "
                              + (string.IsNullOrEmpty(p.zoneId) ? "—" : ZoneLabel(p.zoneId)));
            }
        }
        return sb.Length == 0 ? "  nothing on this board" : sb.ToString().TrimEnd();
    }

    private string ZonesText()
    {
        var sb = new System.Text.StringBuilder();
        foreach (var z in zoneGroups)
        {
            sb.Append("  " + z.label.PadRight(22));
            sb.Append(z.accepts != null && z.accepts.Count > 0
                      ? "takes " + LabelList(z.accepts) : "takes anything");
            if (!z.dropTarget) sb.Append("  (command only)");
            if (!string.IsNullOrEmpty(z.requires)) sb.Append("  (after " + GroupLabel(z.requires) + ")");
            if (!string.IsNullOrEmpty(z.describe)) sb.Append("  — " + z.describe);
            sb.AppendLine();
        }
        return sb.Length == 0 ? "  nowhere to put anything" : sb.ToString().TrimEnd();
    }

