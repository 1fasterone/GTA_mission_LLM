    private readonly List<string> _lines = new List<string>();

    private void Echo(string s)
    {
        if (string.IsNullOrEmpty(s)) return;
        foreach (var line in s.Split('\n')) _lines.Add(line);
        while (_lines.Count > 10) _lines.RemoveAt(0);
        if (_termOut != null) _termOut.text = string.Join("\n", _lines.ToArray());
    }

    private void BuildConsole()
    {
        var root = Canvas();
        var term = Panel(root, "Terminal", new Vector2(0, 0), new Vector2(1, 0),
                         new Vector2(16, 92), new Vector2(-16, 372),
                         new Color(0.06f, 0.06f, 0.07f, 0.96f));
        _termOut = Label(term, 16, new Color(0.79f, 0.80f, 0.81f), TextAnchor.LowerLeft);
        Anchor(_termOut.rectTransform, new Vector2(0, 0), new Vector2(1, 1),
               new Vector2(14, 46), new Vector2(-14, -28));
        _status = Label(term, 14, new Color(0.52f, 0.55f, 0.58f), TextAnchor.UpperLeft);
        Anchor(_status.rectTransform, new Vector2(0, 1), new Vector2(1, 1),
               new Vector2(14, -26), new Vector2(-14, -6));

        var inputGo = new GameObject("TerminalInput", typeof(RectTransform),
                                     typeof(Image), typeof(InputField));
        var irt = inputGo.GetComponent<RectTransform>();
        irt.SetParent(term, false);
        Anchor(irt, new Vector2(0, 0), new Vector2(1, 0), new Vector2(14, 8), new Vector2(-14, 40));
        inputGo.GetComponent<Image>().color = new Color(0.04f, 0.04f, 0.05f, 1f);

        var txt = Label(irt, 16, new Color(0.31f, 0.79f, 0.69f), TextAnchor.MiddleLeft);
        Stretch(txt.rectTransform, new Vector2(26, 2), new Vector2(-8, -2));
        txt.supportRichText = false;
        txt.raycastTarget = true;
        var ph = Label(irt, 16, new Color(0.42f, 0.45f, 0.48f), TextAnchor.MiddleLeft);
        Stretch(ph.rectTransform, new Vector2(26, 2), new Vector2(-8, -2));
        ph.text = "type a command and press Enter…";
        var caret = Label(irt, 16, new Color(0.35f, 0.39f, 0.97f), TextAnchor.MiddleLeft);
        Anchor(caret.rectTransform, new Vector2(0, 0), new Vector2(0, 1),
               new Vector2(8, 0), new Vector2(26, 0));
        caret.text = ">";

        _termIn = inputGo.GetComponent<InputField>();
        _termIn.textComponent = txt;
        _termIn.placeholder   = ph;
        _termIn.lineType      = InputField.LineType.SingleLine;
        _termIn.onEndEdit.AddListener(OnSubmit);

        if (FindFirstObjectByType<EventSystem>() == null)
            new GameObject("EventSystem", typeof(EventSystem), typeof(StandaloneInputModule));
        _termIn.Select();
        _termIn.ActivateInputField();
    }

    private void OnSubmit(string raw)
    {
        // onEndEdit also fires when focus is lost, which would run the half-
        // typed line the player was in the middle of.
        if (!Input.GetKeyDown(KeyCode.Return) && !Input.GetKeyDown(KeyCode.KeypadEnter)) return;
        string line = (raw ?? "").Trim();
        _termIn.text = "";
        _termIn.ActivateInputField();
        if (line.Length == 0) return;
        Echo("> " + line);
        Echo(Run(line));
        Report();
    }
