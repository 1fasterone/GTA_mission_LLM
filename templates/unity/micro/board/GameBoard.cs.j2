    private void BeginDrag()
    {
        RaycastHit hit;
        if (!Physics.Raycast(_cam.ScreenPointToRay(Input.mousePosition), out hit, 500f)) return;
        var piece = PieceUnder(hit.collider.transform);
        if (piece == null) return;

        _dragging = piece;
        // The plane the piece already lives on, facing the camera: a board is
        // read flat, so a drag must not push content toward or away from it.
        _dragPlane = new Plane(-_cam.transform.forward, piece.view.position);
        Vector3 grab;
        _dragOffset = PlanePoint(out grab) ? piece.view.position - grab : Vector3.zero;

        // The dragged piece must not shadow the zone underneath it when the
        // drop ray goes out, so its own collider stands down for the duration.
        _dragCollider = piece.view.GetComponent<Collider>();
        if (_dragCollider != null) _dragCollider.enabled = false;
    }

    private void DragTo()
    {
        Vector3 p;
        if (PlanePoint(out p)) _dragging.view.position = p + _dragOffset;
    }

    private void EndDrag()
    {
        var piece = _dragging;
        _dragging = null;
        if (_dragCollider != null) { _dragCollider.enabled = true; _dragCollider = null; }

        RaycastHit hit;
        Zone zone = Physics.Raycast(_cam.ScreenPointToRay(Input.mousePosition), out hit, 500f)
            ? ZoneUnder(hit.collider.transform) : null;

        if (zone == null)
        {
            // Dropped on open board. That is the "take it back out" move, and
            // it is legal: a piece returns to where the layout put it.
            piece.view.position = piece.home;
            if (!string.IsNullOrEmpty(piece.zoneId))
            {
                string from = ZoneLabel(piece.zoneId);
                piece.zoneId = "";
                Echo("  took " + piece.label + " back out of " + from);
                Report();
            }
            return;
        }

        string reason;
        if (TryPlace(piece, zone, true, out reason)) Echo("  " + piece.label + " -> " + zone.label);
        else { piece.view.position = piece.home; Reject(reason); }
    }

    private bool PlanePoint(out Vector3 point)
    {
        var ray = _cam.ScreenPointToRay(Input.mousePosition);
        float enter;
        if (_dragPlane.Raycast(ray, out enter)) { point = ray.GetPoint(enter); return true; }
        point = Vector3.zero;
        return false;
    }

    private Piece PieceUnder(Transform t)
    {
        while (t != null)
        {
            foreach (var p in _pieces) if (p.view == t) return p;
            t = t.parent;
        }
        return null;
    }

    private Zone ZoneUnder(Transform t)
    {
        while (t != null)
        {
            foreach (var z in _zones) if (z.view == t) return z;
            t = t.parent;
        }
        return null;
    }

    /// <summary>Lay the piece out INSIDE the zone rather than on top of it, so a
    /// full zone reads as a full zone instead of one plate with a stack behind
    /// it.</summary>
    private void Snap(Piece p, Zone z)
    {
        int slot = 0;
        foreach (var other in _pieces) if (other != p && other.zoneId == z.id) slot++;

        var b = WorldBounds(z.view);
        float step = Mathf.Max(0.35f, b.size.x / 3.4f);
        Vector3 right = _cam != null ? _cam.transform.right : Vector3.right;
        Vector3 up    = _cam != null ? _cam.transform.up    : Vector3.up;
        Vector3 front = _cam != null ? -_cam.transform.forward : Vector3.back;

        int col = slot % 3, row = slot / 3;
        p.view.position = b.center
                        + right * ((col - 1) * step)
                        + up    * (b.extents.y * 0.45f - row * step * 0.8f)
                        + front * (b.extents.z + 0.12f);
    }
