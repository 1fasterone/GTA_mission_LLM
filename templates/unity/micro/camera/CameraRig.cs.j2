        Transform best = null;
        float bestDelta = float.MaxValue;
        try
        {
            foreach (string tag in new[] { "Hold", "Platform" })
            {
                foreach (GameObject candidate in GameObject.FindGameObjectsWithTag(tag))
                {
                    if (candidate == null || candidate.transform == _followRoot) continue;
                    float dy = candidate.transform.position.y - _followRoot.position.y;
                    if (dy <= 0.35f || dy >= bestDelta) continue;
                    best = candidate.transform;
                    bestDelta = dy;
