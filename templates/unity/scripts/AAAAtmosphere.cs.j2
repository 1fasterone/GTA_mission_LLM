    private void CreateAtmosphereProxy(string name, Vector3 scale,
                                       Vector3 position, float alpha)
    {
        Transform root = FindOrCreateChild(name);
        if (root.childCount > 0)
            return;
        GameObject proxy = GameObject.CreatePrimitive(PrimitiveType.Cube);
        proxy.name = name + " Volume";
        proxy.transform.SetParent(root, false);
        proxy.transform.localPosition = position;
        proxy.transform.localScale = scale;
        Collider collider = proxy.GetComponent<Collider>();
        if (collider != null)
            Destroy(collider);
        Renderer renderer = proxy.GetComponent<Renderer>();
        renderer.sharedMaterial = CreateMaterial(
            "Universal Render Pipeline/Unlit",
            new Color(0.38f, 0.48f, 0.62f, alpha), true);
    }

    private Transform FindOrCreateChild(string name)
    {
        Transform child = transform.Find(name);
        if (child != null)
            return child;
        GameObject created = new GameObject(name);
        created.transform.SetParent(transform, false);
        return created.transform;
    }

    private static Texture2D BuildDensityTexture(int seed, Color tint)
    {
        const int size = 32;
        Texture2D texture = new Texture2D(size, size, TextureFormat.RGBA32, false);
        for (int y = 0; y < size; y++)
        {
            for (int x = 0; x < size; x++)
            {
                float n = Mathf.PerlinNoise((x + seed) * 0.11f, (y + seed) * 0.13f);
                texture.SetPixel(x, y, new Color(
                    tint.r * (0.75f + n * 0.25f),
                    tint.g * (0.75f + n * 0.25f),
                    tint.b * (0.75f + n * 0.25f), tint.a));
            }
        }
        texture.wrapMode = TextureWrapMode.Repeat;
        texture.filterMode = FilterMode.Bilinear;
        texture.Apply(false, true);
        return texture;
    }

    private static Texture2D BuildDecalTexture(int seed, Color tint)
    {
        const int size = 32;
        Texture2D texture = new Texture2D(size, size, TextureFormat.RGBA32, false);
        for (int y = 0; y < size; y++)
        {
            for (int x = 0; x < size; x++)
            {
                float dx = x / (size - 1f) - 0.5f;
                float dy = y / (size - 1f) - 0.5f;
                float edge = Mathf.Clamp01(1f - Mathf.Sqrt(dx * dx + dy * dy) * 2f);
                float noise = Mathf.PerlinNoise((x + seed) * 0.18f, (y + seed) * 0.14f);
                texture.SetPixel(x, y, new Color(tint.r, tint.g, tint.b,
                    tint.a * edge * noise));
            }
        }
        texture.wrapMode = TextureWrapMode.Clamp;
        texture.filterMode = FilterMode.Bilinear;
        texture.Apply(false, true);
        return texture;
    }

    private static Material CreateMaterial(string shaderName, Color color,
                                           bool transparent)
    {
        Shader shader = Shader.Find(shaderName);
        if (shader == null)
            return null;
        Material material = new Material(shader);
        SetMaterialColor(material, "_BaseColor", color);
        SetMaterialColor(material, "_Color", color);
        if (transparent)
        {
            SetMaterialFloat(material, "_Surface", 1f);
            SetMaterialFloat(material, "_AlphaClip", 0f);
            material.renderQueue = 3000;
        }
        return material;
    }

    private static void SetMaterialColor(Material material, string name, Color value)
    {
        if (material != null && material.HasProperty(name))
            material.SetColor(name, value);
    }

    private static void SetMaterialFloat(Material material, string name, float value)
    {
        if (material != null && material.HasProperty(name))
            material.SetFloat(name, value);
    }

    private static void SetMaterialTexture(Material material, string name, Texture value)
    {
        if (material != null && material.HasProperty(name))
            material.SetTexture(name, value);
    }

    private static Type FindType(string fullName)
    {
        Type direct = Type.GetType(fullName);
        if (direct != null)
            return direct;
        foreach (Assembly assembly in AppDomain.CurrentDomain.GetAssemblies())
        {
            Type found = assembly.GetType(fullName, false);
            if (found != null)
                return found;
        }
        return null;
    }

    private static Component EnsureComponentOnObject(GameObject target,
                                                     string fullTypeName)
    {
        Type type = FindType(fullTypeName);
        if (type == null || !typeof(Component).IsAssignableFrom(type))
            return null;
        Component existing = target.GetComponent(type);
        return existing != null ? existing : target.AddComponent(type);
    }

    private static void SetObjectMember(object target, string name, object value)
    {
        if (target == null)
            return;
        Type type = target.GetType();
        FieldInfo field = type.GetField(name, BindingFlags.Instance |
                                         BindingFlags.Public | BindingFlags.NonPublic);
        PropertyInfo property = type.GetProperty(name, BindingFlags.Instance |
                                                 BindingFlags.Public | BindingFlags.NonPublic);
        MemberInfo member = field != null ? (MemberInfo)field : property;
        if (member == null)
            return;
        SetMemberValue(target, member, value);
    }

    private static void SetParameter(VolumeComponent component, string name,
                                     object value)
    {
        if (component == null)
            return;
        Type type = component.GetType();
        FieldInfo field = type.GetField(name, BindingFlags.Instance |
                                        BindingFlags.Public | BindingFlags.NonPublic);
        if (field == null)
            return;
        object parameter = field.GetValue(component);
        if (parameter == null)
            return;
        SetObjectMember(parameter, "overrideState", true);
        SetObjectMember(parameter, "value", value);
    }

    private static void SetMemberValue(object target, MemberInfo member,
                                       object requested)
    {
        Type targetType = member is FieldInfo field
            ? field.FieldType
            : ((PropertyInfo)member).PropertyType;
        object converted = requested;
        if (targetType.IsEnum && requested is string)
            converted = Enum.Parse(targetType, (string)requested, true);
        else if (requested != null && !targetType.IsInstanceOfType(requested))
        {
            try { converted = Convert.ChangeType(requested, targetType); }
            catch (Exception) { return; }
        }
        if (member is FieldInfo writableField)
            writableField.SetValue(target, converted);
        else
        {
            PropertyInfo writableProperty = (PropertyInfo)member;
            if (writableProperty.CanWrite)
                writableProperty.SetValue(target, converted, null);
        }
    }

    private void ValidatePass()
    {
        List<string> missing = new List<string>();
        if (_profile == null)
            missing.Add("VolumeProfile");
        else
        {
            foreach (string required in RequiredVisualComponents)
            {
                bool found = false;
                foreach (VolumeComponent component in _profile.components)
                {
                    if (component != null && component.GetType().Name == required)
                    {
                        found = true;
                        break;
                    }
                }
                if (!found)
                    missing.Add(required);
            }
        }
        if (missing.Count > 0)
            Debug.LogError("[" + PassName + "] Missing required components: " +
                           string.Join(", ", missing.ToArray()) +
                           ". Regenerate the Unity output.");
    }
}
