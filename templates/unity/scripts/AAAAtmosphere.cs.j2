    private Texture3D BuildFilmicLut()
    {
        Texture3D texture = new Texture3D(LutSize, LutSize, LutSize,
                                          TextureFormat.RGBA32, false);
        Color[] pixels = new Color[LutSize * LutSize * LutSize];
        int index = 0;
        for (int blue = 0; blue < LutSize; blue++)
        {
            for (int green = 0; green < LutSize; green++)
            {
                for (int red = 0; red < LutSize; red++)
                {
                    float r = red / (LutSize - 1f);
                    float g = green / (LutSize - 1f);
                    float b = blue / (LutSize - 1f);
                    // Gentle filmic shoulder + warm highlights + cool shadows.
                    r = Mathf.Pow(Mathf.Clamp01(r * 1.04f), 0.96f);
                    g = Mathf.Pow(Mathf.Clamp01(g * 1.00f), 0.98f);
                    b = Mathf.Pow(Mathf.Clamp01(b * 0.98f), 1.02f);
                    pixels[index++] = new Color(r, g, b, 1f);
                }
            }
        }
        texture.SetPixels(pixels);
        texture.wrapMode = TextureWrapMode.Clamp;
        texture.filterMode = FilterMode.Bilinear;
        texture.Apply(false, true);
        return texture;
    }

