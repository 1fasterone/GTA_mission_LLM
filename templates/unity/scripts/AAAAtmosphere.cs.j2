        if (componentType == null || !typeof(VolumeComponent).IsAssignableFrom(componentType))
        {
            Debug.LogWarning("[" + PassName + "] Missing pipeline volume component: " + shortName);
            return null;
        }

        foreach (VolumeComponent existing in profile.components)
        {
            if (existing != null && existing.GetType() == componentType)
                return existing;
        }

        VolumeComponent created = ScriptableObject.CreateInstance(componentType) as VolumeComponent;
        if (created == null)
            return null;
        created.name = shortName;
        profile.components.Add(created);
        return created;
    }

