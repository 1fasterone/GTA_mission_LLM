    private void CreateGroundLayer(Transform root, string name, float y,
                                   Color tint, int seed)
    {
        GameObject layer = GameObject.CreatePrimitive(PrimitiveType.Plane);
        layer.name = name;
        layer.transform.SetParent(root, false);
        layer.transform.localPosition = new Vector3(0f, y, 0f);
        layer.transform.localScale = new Vector3(18f, 1f, 18f);
        Collider collider = layer.GetComponent<Collider>();
        if (collider != null)
            Destroy(collider);

        Renderer renderer = layer.GetComponent<Renderer>();
        Material material = CreateMaterial("Universal Render Pipeline/Lit", tint, false);
        if (material == null)
            material = CreateMaterial("Standard", tint, false);
        if (material != null)
        {
            Texture2D texture = BuildDensityTexture(seed, tint);
            SetMaterialTexture(material, "_BaseMap", texture);
            SetMaterialTexture(material, "_MainTex", texture);
            renderer.sharedMaterial = material;
        }
    }

    private void CreateDecal(Transform root, string name, int seed, Vector3 position,
                             Vector2 size, Color tint)
    {
        GameObject decal = GameObject.CreatePrimitive(PrimitiveType.Quad);
        decal.name = name;
        decal.transform.SetParent(root, false);
        decal.transform.localPosition = position;
        decal.transform.localRotation = Quaternion.Euler(90f, position.x * 7f, 0f);
        decal.transform.localScale = new Vector3(size.x, size.y, 1f);
        Collider collider = decal.GetComponent<Collider>();
        if (collider != null)
            Destroy(collider);
        Renderer renderer = decal.GetComponent<Renderer>();
        Material material = CreateMaterial("Universal Render Pipeline/Unlit", tint, true);
        if (material == null)
            material = CreateMaterial("Unlit/Transparent", tint, true);
        if (material != null)
        {
            Texture2D texture = BuildDecalTexture(seed, tint);
            SetMaterialTexture(material, "_BaseMap", texture);
            SetMaterialTexture(material, "_MainTex", texture);
            renderer.sharedMaterial = material;
        }
    }

