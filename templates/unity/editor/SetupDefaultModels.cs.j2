using System.Collections.Generic;
using UnityEditor;
using UnityEditor.Animations;
using UnityEngine;

[InitializeOnLoad]
public static class SetupDefaultModels
{
    private const string PrefKey = "{{ project_name }}_DefaultModelsSetupDone";
    private const string ModelsRoot = "Assets/Resources/Models/Default";
    private const string ControllerPath = ModelsRoot + "/DefaultCharacter.controller";
    // The generator already decided Humanoid-vs-Generic per model (unity_generator.py
    // downgrades every humanoid rig to Generic for 2D games — a rigged FBX still
    // has a 'Hips' transform even after that downgrade, so a hasHips-only rescan would
    // silently re-force Humanoid here and reintroduce the 2D "Required human bone
    // 'LeftLowerLeg'" avatar crash). Mirror that decision instead of re-deriving it.
    // 2.5D uses real 3D models/world (see unity_compose.py's GOLDEN_2_5D_CORE_SIGNATURE),
    // so it keeps Humanoid like a normal 3D project.
    private const bool AllowHumanoid = {{ "false" if game_type == "2D" else "true" }};

    static SetupDefaultModels()
    {
        if (EditorPrefs.GetBool(PrefKey, false)) return;
        EditorApplication.delayCall += RunOnce;
    }

    // Depth-first search for a transform by name (used to detect a humanoid skeleton).
    private static Transform FindDeep(Transform root, string name)
    {
        if (root.name == name) return root;
        for (int i = 0; i < root.childCount; i++)
        {
            var found = FindDeep(root.GetChild(i), name);
            if (found != null) return found;
        }
        return null;
    }

    private static void RunOnce()
    {
        if (!AssetDatabase.IsValidFolder(ModelsRoot)) return;

        // 1. Set rig type + looping clips per model. Humanoid ONLY when the model
        //    actually has a humanoid skeleton (a 'Hips' bone) — forcing Humanoid on
        //    a skeleton-less mesh (e.g. a procedural vehicle) throws "Invalid Avatar
        //    Rig Configuration. Required human bone 'Hips' not found". Skeleton-less
        //    meshes are left Generic so they import clean.
        foreach (var guid in AssetDatabase.FindAssets("t:Model", new[] { ModelsRoot }))
        {
            var path = AssetDatabase.GUIDToAssetPath(guid);
            var imp = AssetImporter.GetAtPath(path) as ModelImporter;
            if (imp == null) continue;
            bool dirty = false;

            var go = AssetDatabase.LoadMainAssetAtPath(path) as GameObject;
            bool hasHips = go != null && FindDeep(go.transform, "Hips") != null;
            var want = (hasHips && AllowHumanoid)
                ? ModelImporterAnimationType.Human
                : ModelImporterAnimationType.Generic;
            if (imp.animationType != want)
            {
                imp.animationType = want;
                dirty = true;
            }
            var clips = imp.defaultClipAnimations;
            if (clips != null && clips.Length > 0)
            {
                foreach (var c in clips) c.loopTime = true;
                imp.clipAnimations = clips;
                dirty = true;
            }
            if (dirty) imp.SaveAndReimport();
        }

        // 2. Build the shared AnimatorController from whatever clips exist.
        var clipsByName = new Dictionary<string, AnimationClip>();
        foreach (var guid in AssetDatabase.FindAssets("t:AnimationClip", new[] { ModelsRoot + "/Player" }))
        {
            var path = AssetDatabase.GUIDToAssetPath(guid);
            foreach (var asset in AssetDatabase.LoadAllAssetsAtPath(path))
            {
                var clip = asset as AnimationClip;
                if (clip == null || clip.name.StartsWith("__preview__")) continue;
                var key = System.IO.Path.GetFileNameWithoutExtension(path);
                if (!clipsByName.ContainsKey(key)) clipsByName[key] = clip;
            }
        }
        if (clipsByName.Count > 0 &&
            AssetDatabase.LoadAssetAtPath<AnimatorController>(ControllerPath) == null)
        {
            var controller = AnimatorController.CreateAnimatorControllerAtPath(ControllerPath);
            controller.AddParameter("Speed", AnimatorControllerParameterType.Float);
            var sm = controller.layers[0].stateMachine;

            var states = new Dictionary<string, AnimatorState>();
            foreach (var kv in clipsByName)
            {
                var st = sm.AddState(kv.Key);
                st.motion = kv.Value;
                states[kv.Key] = st;
            }
            // Default state: Idle if present, else Run, else the first clip.
            AnimatorState idle = states.ContainsKey("Idle") ? states["Idle"] : null;
            AnimatorState run  = states.ContainsKey("Run")  ? states["Run"]  : null;
            sm.defaultState = idle ?? run ?? states[new List<string>(states.Keys)[0]];

            if (idle != null && run != null)
            {
                var toRun = idle.AddTransition(run);
                toRun.AddCondition(AnimatorConditionMode.Greater, 0.2f, "Speed");
                toRun.hasExitTime = false; toRun.duration = 0.15f;
                var toIdle = run.AddTransition(idle);
                toIdle.AddCondition(AnimatorConditionMode.Less, 0.2f, "Speed");
                toIdle.hasExitTime = false; toIdle.duration = 0.15f;
            }
            AssetDatabase.SaveAssets();
            Debug.Log("[{{ project_name }}] DefaultCharacter.controller built from "
                      + clipsByName.Count + " clip(s).");
        }

        EditorPrefs.SetBool(PrefKey, true);
    }
}
