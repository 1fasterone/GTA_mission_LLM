            clip, EditorCurveBinding.FloatCurve(
                "", typeof(Transform), "localEulerAnglesRaw.z"),
            new AnimationCurve(keys));
        AssetDatabase.CreateAsset(clip, path);
        return clip;
    }

    private static AnimationClip FindNamed(
