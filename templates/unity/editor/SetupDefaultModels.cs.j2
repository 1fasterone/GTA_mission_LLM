            // Default state: Idle if present, else Run, else the first clip.
            AnimatorState idle = states.ContainsKey("Idle") ? states["Idle"] : null;
            AnimatorState run  = states.ContainsKey("Run")  ? states["Run"]  : null;
            sm.defaultState = idle ?? run ?? states[new List<string>(states.Keys)[0]];

            if (idle != null && run != null)
            {
                var toRun = idle.AddTransition(run);
                toRun.AddCondition(AnimatorConditionMode.Greater, 0.2f, "Speed");
                toRun.hasExitTime = false; toRun.duration = 0.15f;
                var toIdle = run.AddTransition(idle);
                toIdle.AddCondition(AnimatorConditionMode.Less, 0.2f, "Speed");
                toIdle.hasExitTime = false; toIdle.duration = 0.15f;
            }
