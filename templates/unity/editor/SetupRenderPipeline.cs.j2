#if UNITY_EDITOR
using UnityEditor;
using UnityEngine;
using UnityEngine.Rendering;
{% if render_pipeline == "URP" %}
using UnityEngine.Rendering.Universal;
{% elif render_pipeline == "HDRP" %}
using UnityEngine.Rendering.HighDefinition;
{% endif %}

[InitializeOnLoad]
public static class SetupRenderPipeline
{
    private const string PrefKey = "{{ project_name }}_RenderPipelineSetupDone";

    static SetupRenderPipeline()
    {
        // GraphicsSettings.defaultRenderPipeline is the real, per-project
        // source of truth for whether the pipeline is actually configured.
        // EditorPrefs below is only a same-session optimization — it must
        // NEVER be trusted as the sole gate: it's keyed only by
        // project_name and stored machine-globally (the platform's global
        // editor prefs store), so it persists across completely different
        // project directories that happen to share a name. Confirmed live
        // (2026-09): iterative regeneration of a same-named project during
        // development left every copy after the first permanently
        // unconfigured — defaultRenderPipeline stayed null, every
        // URP-authored material rendered 100% Unity's magenta
        // missing-shader color, and nothing logged an error, because a
        // pipeline mismatch isn't one — invisible to every check in this
        // repo's QA until Gap C's PlayMode render-health gate
        // (docs/COMPILER_AUDIT.md solution #4).
        // defaultRenderPipeline replaced the deprecated renderPipelineAsset (Unity 6
        // API updater otherwise prompts a Script Updating Consent dialog on open).
        if (GraphicsSettings.defaultRenderPipeline != null)
        {
            EditorPrefs.SetBool(PrefKey, true);
            return;
        }
        // Not configured — always (re-)register regardless of what
        // EditorPrefs claims for this project NAME. CreatePipelineAsset()
        // re-checks defaultRenderPipeline itself before creating anything,
        // so an extra delayCall queued across domain reloads within the
        // SAME project is harmless, not a duplicate-asset error.
        EditorApplication.delayCall += CreatePipelineAsset;
    }

    private static void CreatePipelineAsset()
    {
        if (GraphicsSettings.defaultRenderPipeline != null) return;  // a queued call from an earlier reload already did this

        const string settingsFolder = "Assets/Settings";
        if (!AssetDatabase.IsValidFolder(settingsFolder))
            AssetDatabase.CreateFolder("Assets", "Settings");

{% if render_pipeline == "URP" %}
        const string rendererPath = "Assets/Settings/URPRenderer.asset";
        const string pipelinePath = "Assets/Settings/UniversalRenderPipelineAsset.asset";

        var rendererData = ScriptableObject.CreateInstance<UniversalRendererData>();
        AssetDatabase.CreateAsset(rendererData, rendererPath);

        // UniversalRenderPipelineAsset.Create() requires a renderer data reference
        var pipelineAsset = UniversalRenderPipelineAsset.Create(rendererData);
        AssetDatabase.CreateAsset(pipelineAsset, pipelinePath);
{% elif render_pipeline == "HDRP" %}
        const string pipelinePath = "Assets/Settings/HDRenderPipelineAsset.asset";

        var pipelineAsset = ScriptableObject.CreateInstance<HDRenderPipelineAsset>();
        AssetDatabase.CreateAsset(pipelineAsset, pipelinePath);
{% else %}
        // Built-in pipeline — no asset required.
        EditorPrefs.SetBool(PrefKey, true);
        return;
{% endif %}

        AssetDatabase.SaveAssets();
        AssetDatabase.Refresh();

        // Apply to both Graphics Settings and the active Quality tier
        GraphicsSettings.defaultRenderPipeline = pipelineAsset;
        QualitySettings.renderPipeline       = pipelineAsset;

{% if render_pipeline == "URP" and not has_atmosphere %}
        // Scene starts with Unity's default "Default-Skybox" material, which
        // is a Built-in-RP shader — URP renders it flat/incorrectly, and
        // RenderSettings.ambientMode=Skybox then samples near-black GI from
        // it, so the scene looks lightless even with a normal directional
        // light. This project didn't opt into the full atmosphere feature
        // (see wants_atmosphere()), so give it a neutral, URP-safe baseline
        // instead of silently shipping a broken sky: try a URP procedural
        // skybox shader if the project has one, else fall back to flat
        // ambient so lighting is at least visible.
        var proceduralShader = Shader.Find("Skybox/Procedural");
        if (proceduralShader != null)
        {
            var skyMat = new Material(proceduralShader);
            const string skyPath = "Assets/Settings/DefaultSkybox.mat";
            AssetDatabase.CreateAsset(skyMat, skyPath);
            RenderSettings.skybox = skyMat;
            DynamicGI.UpdateEnvironment();
        }
        else
        {
            RenderSettings.skybox = null;
            RenderSettings.ambientMode = AmbientMode.Flat;
            RenderSettings.ambientLight = new Color(0.35f, 0.38f, 0.45f);
        }
{% endif %}

        // Models imported BEFORE this switch generated their materials against
        // the built-in pipeline (Standard shader — magenta/black under {{ render_pipeline }}).
        // Reimport them so material generation reruns under the now-active
        // pipeline (materialImportMode 2 + URPMaterialPostprocessor).
        foreach (var guid in AssetDatabase.FindAssets("t:Model"))
        {
            var p = AssetDatabase.GUIDToAssetPath(guid);
            if (p.StartsWith("Assets/"))
                AssetDatabase.ImportAsset(p, ImportAssetOptions.ForceUpdate);
        }

        EditorPrefs.SetBool(PrefKey, true);
        Debug.Log($"[SetupRenderPipeline] {{ render_pipeline }} asset created at {pipelinePath} and applied to Graphics Settings.");
    }
}
#endif
