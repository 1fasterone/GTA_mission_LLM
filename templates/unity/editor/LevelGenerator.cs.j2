    /// <summary>
    /// Unity batch-mode entry point.  The greybox E2E invokes this exact
    /// method, then asserts that the generated scene was persisted on disk.
    /// </summary>
    public static void GenerateAndSavePreviewScene()
    {
        GenerateProjectScene(forceRebuild: true);
    }

    /// <summary>
    /// Batch-mode visual evidence only.  The temporary light and render target
    /// are never saved, so geometry-only output still contains no lighting or
    /// material assets.
    /// </summary>
    public static void CapturePreviewScreenshot()
    {
        GenerateAndSavePreviewScene();
        GameObject root = GameObject.Find("Dungeon_Greybox");
        Transform markerRoot = root == null ? null : root.transform.Find("Markers");
        Camera camera = markerRoot == null
            ? null : markerRoot.GetComponentInChildren<Camera>(true);
        if (camera == null)
            throw new InvalidOperationException("Greybox preview camera is missing.");

        const int width = 1280;
        const int height = 720;
        RenderTexture renderTarget = RenderTexture.GetTemporary(
            width, height, 24, RenderTextureFormat.ARGB32);
        RenderTexture previousActive = RenderTexture.active;
        RenderTexture previousTarget = camera.targetTexture;
        Color previousAmbient = RenderSettings.ambientLight;
        Texture2D pixels = null;
        GameObject captureLight = new GameObject("_GreyboxCaptureLight");
        captureLight.hideFlags = HideFlags.HideAndDontSave;
        Light light = captureLight.AddComponent<Light>();
        light.type = LightType.Directional;
        light.intensity = 1.2f;
        captureLight.transform.rotation = Quaternion.Euler(50f, -30f, 0f);
        try
        {
            RenderSettings.ambientLight = new Color(0.35f, 0.35f, 0.35f, 1f);
            camera.targetTexture = renderTarget;
            camera.Render();
            RenderTexture.active = renderTarget;
            pixels = new Texture2D(width, height, TextureFormat.RGB24, false);
            pixels.ReadPixels(new Rect(0f, 0f, width, height), 0, 0);
            pixels.Apply();
            string projectRoot = Directory.GetParent(Application.dataPath).FullName;
            string outputPath = Path.Combine(projectRoot, "greybox_preview.png");
            File.WriteAllBytes(outputPath, pixels.EncodeToPNG());
            Debug.Log("[GreyboxLevelGenerator] captured preview: " + outputPath);
        }
        finally
        {
            camera.targetTexture = previousTarget;
            RenderTexture.active = previousActive;
            RenderSettings.ambientLight = previousAmbient;
            RenderTexture.ReleaseTemporary(renderTarget);
            if (pixels != null) UnityEngine.Object.DestroyImmediate(pixels);
            UnityEngine.Object.DestroyImmediate(captureLight);
        }
        if (Application.isBatchMode) EditorApplication.Exit(0);
    }

    [InitializeOnLoadMethod]
    private static void ScheduleInitialSceneBuild()
    {
        EditorApplication.delayCall += EnsureProjectScene;
    }

    private static void EnsureProjectScene()
    {
        if (EditorApplication.isPlayingOrWillChangePlaymode) return;
        if (EditorApplication.isCompiling || EditorApplication.isUpdating)
        {
            EditorApplication.delayCall += EnsureProjectScene;
            return;
        }

        GenerateProjectScene(forceRebuild: false);
    }

    private static void GenerateProjectScene(bool forceRebuild)
    {
        Scene active = EditorSceneManager.GetActiveScene();
        bool isPreviewScene = active.IsValid() && active.path == PreviewScenePath;
        bool previewAssetExists =
            AssetDatabase.LoadAssetAtPath<SceneAsset>(PreviewScenePath) != null;
        if (!forceRebuild && !isPreviewScene && active.IsValid() && active.rootCount > 0)
        {
            bool onlyUnityStarterObjects = true;
            foreach (GameObject rootObject in active.GetRootGameObjects())
                if (rootObject.name != "Main Camera"
                    && rootObject.name != "Directional Light")
                    onlyUnityStarterObjects = false;
            if (!onlyUnityStarterObjects) return;
        }

        Scene scene;
        if (previewAssetExists)
        {
            scene = isPreviewScene
                ? active
                : EditorSceneManager.OpenScene(PreviewScenePath, OpenSceneMode.Single);
        }
        else
        {
            scene = EditorSceneManager.NewScene(
                NewSceneSetup.EmptyScene, NewSceneMode.Single);
        }

        DungeonGreyboxIR ir = null;
        if (forceRebuild || GameObject.Find("Dungeon_Greybox") == null)
            ir = Generate(DefaultSeed, GenerationMode.GeometryOnly);
        if (ir == null)
            ir = Build(DefaultSeed, GenerationMode.GeometryOnly);
        if (ir == null)
            throw new InvalidOperationException(
                "Greybox IR could not be loaded for preview-scene generation.");

        EnsurePreviewCamera(ir);
        if (!EditorSceneManager.SaveScene(scene, PreviewScenePath))
            throw new InvalidOperationException(
                "Unity could not save the generated greybox preview scene.");
        List<EditorBuildSettingsScene> buildScenes =
            new List<EditorBuildSettingsScene>(EditorBuildSettings.scenes);
        bool hasPreview = false;
        foreach (EditorBuildSettingsScene buildScene in buildScenes)
            if (buildScene.path == PreviewScenePath) hasPreview = true;
        if (!hasPreview)
        {
            buildScenes.Add(new EditorBuildSettingsScene(PreviewScenePath, true));
            EditorBuildSettings.scenes = buildScenes.ToArray();
        }
        AssetDatabase.SaveAssets();
        Debug.Log("[GreyboxLevelGenerator] saved preview scene: "
                  + PreviewScenePath);
    }

    private static void EnsurePreviewCamera(DungeonGreyboxIR ir)
    {
        GameObject root = GameObject.Find(ir.hierarchyRoot);
        if (root == null) return;
        Transform markerRoot = root.transform.Find("Markers");
        if (markerRoot == null) return;
        Camera camera = markerRoot.GetComponentInChildren<Camera>(true);
        if (camera == null)
        {
            GameObject cameraObject = new GameObject("GreyboxPreviewCamera");
            cameraObject.transform.SetParent(markerRoot, false);
            camera = cameraObject.AddComponent<Camera>();
            cameraObject.tag = "MainCamera";
        }

        Bounds bounds = new Bounds(Vector3.zero, Vector3.one);
        bool hasBounds = false;
        foreach (UnityPrimitiveIR primitive in ir.unityPrimitives)
        {
            Vector3 size = primitive.size;
            Vector3 center = primitive.worldPosition + Vector3.up * (size.y * 0.5f);
            Bounds next = new Bounds(center, size);
            if (!hasBounds) { bounds = next; hasBounds = true; }
            else bounds.Encapsulate(next);
        }
        if (!hasBounds) return;

        camera.enabled = true;
        camera.clearFlags = CameraClearFlags.SolidColor;
        camera.backgroundColor = new Color(0.16f, 0.16f, 0.16f, 1f);
        camera.fieldOfView = 55f;
        camera.nearClipPlane = 0.1f;
        float radius = Mathf.Max(1f, bounds.extents.magnitude);
        float distance = radius / Mathf.Sin(camera.fieldOfView * Mathf.Deg2Rad * 0.5f);
        Vector3 direction = new Vector3(1f, 0.8f, -1f).normalized;
        camera.transform.position = bounds.center + direction * distance * 1.15f;
        camera.transform.rotation = Quaternion.LookRotation(
            (bounds.center - camera.transform.position).normalized, Vector3.up);
        camera.farClipPlane = Mathf.Max(1000f, distance * 4f);
    }

    /// <summary>Build, validate and emit one deterministic greybox world.</summary>
    public static DungeonGreyboxIR Generate(
        int seed, GenerationMode mode = GenerationMode.GeometryOnly)
    {
        DungeonGreyboxIR ir = Build(seed, mode);
        List<string> errors = Validate(ir);
        if (errors.Count > 0)
        {
            Debug.LogError("[GreyboxLevelGenerator] REJECTED: "
                           + string.Join("; ", errors.ToArray()));
            return null;
        }
        Emit(ir);
        Debug.Log("[GreyboxLevelGenerator] accepted seed=" + seed
                  + " rooms=" + ir.rooms.Count
                  + " corridors=" + ir.corridors.Count
                  + " bossDepth=" + ir.bossDepth
                  + " loops=" + ir.loopCount);
        return ir;
    }

    public static DungeonGreyboxIR Build(
        int seed, GenerationMode mode = GenerationMode.GeometryOnly)
    {
        // The Python generator writes this schema-shaped asset beside the
        // canonical IR. JsonUtility is only the transport here; validation
        // remains the deterministic Python/C# contract below.
        TextAsset asset = AssetDatabase.LoadAssetAtPath<TextAsset>(GreyboxAssetPath);
        if (asset != null)
        {
            DungeonGreyboxIR loaded = JsonUtility.FromJson<DungeonGreyboxIR>(asset.text);
            if (loaded != null && loaded.seed == seed && loaded.rooms != null
                && loaded.corridors != null)
            {
                RebuildGraph(loaded);
                loaded.mode = mode;
                loaded.theme = "none";
                return loaded;
            }
        }
        Debug.LogError("[GreyboxLevelGenerator] greybox transport missing or "
                       + "does not match the requested seed: " + seed);
        return null;
    }

    private static RoomIR FindRoom(DungeonGreyboxIR ir, string id)
    {
        foreach (RoomIR room in ir.rooms)
            if (room.id == id) return room;
        return null;
    }

    private static void RebuildGraph(DungeonGreyboxIR ir)
    {
        ir.adjacency = new Dictionary<string, List<string>>();
        ir.branchingFactors = new Dictionary<string, int>();
        foreach (RoomIR room in ir.rooms)
        {
            ir.adjacency[room.id] = new List<string>();
            ir.branchingFactors[room.id] = 0;
        }
        foreach (CorridorIR corridor in ir.corridors)
        {
            if (!ir.adjacency.ContainsKey(corridor.fromRoomId)
                || !ir.adjacency.ContainsKey(corridor.toRoomId)) continue;
            ir.adjacency[corridor.fromRoomId].Add(corridor.toRoomId);
            ir.adjacency[corridor.toRoomId].Add(corridor.fromRoomId);
            ir.branchingFactors[corridor.fromRoomId]++;
            ir.branchingFactors[corridor.toRoomId]++;
        }
        ir.bossDepth = ShortestPath(ir, ir.startRoomId, ir.bossRoomId);
        ir.loopCount = Mathf.Max(0, ir.corridors.Count - ir.rooms.Count + 1);
    }

    private static Vector3 GridToWorld(GridPoint point, float cellSize)
    {
        return new Vector3(point.x * cellSize, point.y * cellSize,
                           point.z * cellSize);
    }

    private static int ShortestPath(DungeonGreyboxIR ir, string start, string target)
    {
        Queue<KeyValuePair<string, int>> queue =
            new Queue<KeyValuePair<string, int>>();
        HashSet<string> visited = new HashSet<string>();
        queue.Enqueue(new KeyValuePair<string, int>(start, 0));
        while (queue.Count > 0)
        {
            KeyValuePair<string, int> item = queue.Dequeue();
            if (!visited.Add(item.Key)) continue;
            if (item.Key == target) return item.Value;
            foreach (string next in ir.adjacency[item.Key])
                queue.Enqueue(new KeyValuePair<string, int>(next, item.Value + 1));
        }
        return -1;
    }

    public static List<string> Validate(DungeonGreyboxIR ir)
    {
        List<string> errors = new List<string>();
        if (ir == null) { errors.Add("IR is null"); return errors; }
        if (ir.cellSize <= 0f || float.IsNaN(ir.cellSize)
            || float.IsInfinity(ir.cellSize))
            errors.Add("cellSize must be finite and positive");
        if (FindRoom(ir, ir.startRoomId) == null) errors.Add("start room is missing");
        if (FindRoom(ir, ir.bossRoomId) == null) errors.Add("boss room is missing");
        for (int i = 0; i < ir.rooms.Count; i++)
        {
            RoomIR room = ir.rooms[i];
            Vector3 expected = GridToWorld(room.gridPosition, ir.cellSize);
            if ((room.worldPosition - expected).sqrMagnitude > 0.00000001f)
                errors.Add("room " + room.id + " is not grid aligned");
            if (room.width < ir.constraints.minRoomWidth
                || room.width > ir.constraints.maxRoomWidth)
                errors.Add("room width out of range: " + room.id);
            if (room.depth < ir.constraints.minRoomDepth
                || room.depth > ir.constraints.maxRoomDepth)
                errors.Add("room depth out of range: " + room.id);
            for (int j = 0; j < i; j++)
                if (room.bounds.Overlaps(ir.rooms[j].bounds))
                    errors.Add("rooms overlap: " + ir.rooms[j].id + "/" + room.id);
        }
        if (ir.rooms.Count < ir.constraints.minRooms
            || ir.rooms.Count > ir.constraints.maxRooms)
            errors.Add("room count out of range: " + ir.rooms.Count);
        foreach (CorridorIR corridor in ir.corridors)
        {
            if (corridor.width < ir.constraints.minCorridorWidth
                || corridor.width > ir.constraints.maxCorridorWidth)
                errors.Add("corridor width out of range: " + corridor.id);
            if (!ir.adjacency.ContainsKey(corridor.fromRoomId)
                || !ir.adjacency.ContainsKey(corridor.toRoomId))
                errors.Add("corridor references unknown room: " + corridor.id);
        }
        int depth = ShortestPath(ir, ir.startRoomId, ir.bossRoomId);
        if (depth < ir.constraints.minBossDepth
            || depth > ir.constraints.maxBossDepth)
            errors.Add("boss depth out of range: " + depth);
        if (depth != ir.bossDepth) errors.Add("boss depth metadata does not match graph");
        if (ir.loopCount < ir.constraints.minLoops
            || ir.loopCount > ir.constraints.maxLoops)
            errors.Add("loop count out of range: " + ir.loopCount);
        foreach (KeyValuePair<string, int> branch in ir.branchingFactors)
            if (branch.Value > ir.constraints.maxBranching)
                errors.Add("branching factor out of range: " + branch.Key);
        return errors;
    }

    private static void Emit(DungeonGreyboxIR ir)
    {
        GameObject previous = GameObject.Find(ir.hierarchyRoot);
        if (previous != null) Undo.DestroyObjectImmediate(previous);
        GameObject root = new GameObject(ir.hierarchyRoot);
        Undo.RegisterCreatedObjectUndo(root, "Generate Dungeon Greybox");
        Transform geometry = Child(root, "Geometry");
        Transform rooms = Child(root, "Rooms");
        Transform corridors = Child(root, "Corridors");
        Transform elevation = Child(root, "Elevation");
        Transform markers = Child(root, "Markers");

        foreach (RoomIR room in ir.rooms)
        {
            NewEmpty(rooms, room.id);
        }
        // The canonical unity_primitives list is the geometry payload.  Room
        // and corridor IR remain available for validation and markers, while
        // this loop guarantees the editor emits exactly the Python-authored
        // primitive coordinates and hierarchy parents.
        foreach (UnityPrimitiveIR primitive in ir.unityPrimitives)
        {
            Transform parent = geometry;
            if (primitive.parent == "Corridors") parent = corridors;
            if (primitive.parent == "Elevation") parent = elevation;
            BuildBox(parent, primitive.id, primitive.worldPosition, primitive.size);
        }
        foreach (MarkerIR marker in ir.markers)
        {
            // Keep the empty marker anchor at its exact IR coordinate. The
            // visible cube is a child offset above the floor, not a material
            // asset or gameplay prop.
            GameObject markerObject = NewEmpty(markers, marker.id);
            markerObject.transform.localPosition = marker.worldPosition;
            GameObject volume = BuildBox(
                markerObject.transform, "Volume",
                Vector3.up * (ir.cellSize * 0.125f),
                Vector3.one * (ir.cellSize * 0.45f));
            TintMarker(volume.GetComponent<MeshRenderer>(), marker.type);
        }
        Selection.activeGameObject = root;
        SceneView.FrameLastActiveSceneView();
    }

    private static Transform Child(GameObject root, string name)
    {
        return NewEmpty(root.transform, name).transform;
    }

    private static GameObject NewEmpty(Transform parent, string name)
    {
        GameObject go = new GameObject(name);
        go.transform.SetParent(parent, false);
        return go;
    }

    private static Material BuiltInGreyboxMaterial()
    {
        Material material =
            AssetDatabase.GetBuiltinExtraResource<Material>("Default-Material.mat");
        if (material == null || material.shader == null || !material.shader.isSupported)
            throw new InvalidOperationException(
                "Unity's built-in default material is unavailable for greybox geometry.");
        return material;
    }

    // Marker tint uses a renderer property block on Unity's built-in material;
    // no Material, texture, lighting, art, gameplay, enemy, item or prop asset
    // is emitted by geometry-only generation.
    private static void TintMarker(MeshRenderer renderer, string type)
    {
        if (renderer == null || renderer.sharedMaterial == null
            || !renderer.sharedMaterial.HasProperty("_Color")) return;
        Color color = type == "spawn" ? new Color(0.25f, 0.72f, 0.35f)
            : type == "boss" ? new Color(0.86f, 0.28f, 0.25f)
            : new Color(0.26f, 0.48f, 0.88f);
        MaterialPropertyBlock properties = new MaterialPropertyBlock();
        properties.SetColor("_Color", color);
        renderer.SetPropertyBlock(properties);
    }

    private static GameObject BuildBox(Transform parent, string name, Vector3 position,
                                       Vector3 size)
    {
        GameObject go = NewEmpty(parent, name);
        go.transform.localPosition = position;
        ProBuilderMesh mesh = go.AddComponent<ProBuilderMesh>();
        MeshRenderer renderer = go.GetComponent<MeshRenderer>();
        renderer.sharedMaterial = BuiltInGreyboxMaterial();
        float halfX = size.x * 0.5f;
        float halfZ = size.z * 0.5f;
        mesh.CreateShapeFromPolygon(new List<Vector3>
        {
            new Vector3(-halfX, 0f, -halfZ),
            new Vector3( halfX, 0f, -halfZ),
            new Vector3( halfX, 0f,  halfZ),
            new Vector3(-halfX, 0f,  halfZ),
        }, Mathf.Max(0.01f, size.y), false);
        mesh.ToMesh();
        mesh.Refresh();
        return go;
    }

    [MenuItem("Tools/{{ project_name }}/Generate Greybox", validate = true)]
    private static bool ValidateGenerateLevel() => !EditorApplication.isPlaying;
