    private void Update()
    {
        if (!Application.isPlaying) return;   // Animator speed-blend is a Play-only concern
        if (_anim == null || _anim.runtimeAnimatorController == null) return;
        Vector3 d = transform.position - _lastPos;
        _lastPos = transform.position;
        d.y = 0f;
        _anim.SetFloat("Speed", d.magnitude / Mathf.Max(Time.deltaTime, 0.0001f));
    }
