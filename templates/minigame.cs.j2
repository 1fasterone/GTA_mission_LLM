    public {{ class_name }}()
    {
        Tick    += OnTick;
        KeyDown += OnKeyDown;
        Aborted += OnAborted;
        LoadIni();
    }

    // -- Input (F7 = the one gameplay-safe hotkey; see design note R4) ----------

    private void OnKeyDown(object sender, KeyEventArgs e)
    {
        if (e.KeyCode == Keys.F7)
        {
            switch (_state)
            {
                case State.Idle:
                case State.Results: _state = State.Menu; _menuSelection = 0; break;
                case State.Menu:    _state = State.Idle; break;
                case State.Playing: AbortRound(); break;
            }
            return;
        }
        if (_state == State.Results)
        {
            if (e.KeyCode == Keys.Enter)
            {
                ResetRound();
                _state = State.Playing;
            }
            else if (e.KeyCode == Keys.Back)
            {
                _state = State.Menu;
                _menuSelection = 0;
            }
        }
{% if round_type == "survive_waves" and hero_row_index >= 0 %}
        else if (_state == State.Playing
            && (e.KeyCode == Keys.E || e.KeyCode == Keys.Q)
            && DateTime.UtcNow >= _abilityCooldown)
        {
            RunHeroAbility(e.KeyCode == Keys.E);
            _abilityCooldown = DateTime.UtcNow.AddSeconds(1.0);
        }
{% endif %}
    }

    // -- Main loop ---------------------------------------------------------------

    private void OnTick(object sender, EventArgs e)
    {
        switch (_state)
        {
            case State.Idle:
                if (!_idleHintShown)
                {
                    _idleHintShown = true;
                    GTA.UI.Notification.PostTicker(
                        "~y~{{ mission_name }}~s~ loaded. Press ~b~F7~s~ to play.", true);
                }
                break;
            case State.Menu:
                DrawMenu();
                HandleMenuControls();
                break;
            case State.Playing:
                RunRound();
                DrawRoundHud();
                break;
            case State.Results:
                DrawResults();
                break;
        }
{% if extra_tick %}
        // ── prompt-specific (runs every tick) ──
{{ extra_tick | indent(8, True) }}
{% endif %}
    }

    // -- Config menu (the primary loop) -------------------------------------------

    private void DrawMenu()
    {
        int rows = _cfgRows.Length + 1;   // + START row
        float startY  = 0.30f;
        float spacing = 0.042f;

        DrawPanelRect(0.50f, 0.42f, 0.42f, 0.10f + rows * spacing, 18, 18, 26, 225);
        DrawPanelRect(0.50f, 0.26f, 0.42f, 0.05f, 0, 95, 160, 235);
        DrawPanelText("{{ mission_name | upper }}", 0.50f, 0.242f, 0.62f, 255, 255, 255, 255, true);

        for (int i = 0; i < _cfgRows.Length; i++)
        {
            float y = startY + i * spacing;
            if (i == _menuSelection)
                DrawPanelRect(0.50f, y + 0.012f, 0.38f, 0.032f, 45, 55, 95, 190);
            DrawPanelText((i == _menuSelection ? "~b~> ~w~" : "~w~") + _cfgRows[i].Label,
                0.315f, y, 0.40f, 255, 255, 255, 255, false);
            DrawPanelText("~s~" + MenuValueFor(i),
                0.62f, y, 0.40f, 255, 220, 120, 255, false);
        }

        float startRowY = startY + _cfgRows.Length * spacing;
        if (_menuSelection == _cfgRows.Length)
            DrawPanelRect(0.50f, startRowY + 0.012f, 0.38f, 0.032f, 30, 90, 45, 200);
        DrawPanelText((_menuSelection == _cfgRows.Length ? "~b~> " : "") + "~g~>> START <<",
            0.50f, startRowY, 0.46f, 255, 255, 255, 255, true);

        DrawPanelText("Best {{ score_label }}: ~y~" + _bestScore
            + "~s~   |   UP/DOWN  LEFT/RIGHT  ENTER  |  F7 close",
            0.50f, startRowY + spacing + 0.01f, 0.30f, 170, 170, 170, 255, true);
    }

    private string MenuValueFor(int i)
    {
        switch (_cfgRows[i].Kind)
        {
            case RowKind.Cycle:  return _cfgRows[i].Options[_cfgValues[i]];
            case RowKind.Toggle: return _cfgValues[i] == 1 ? "~g~ON" : "~c~OFF";
            default:             return _cfgValues[i].ToString();
        }
    }

    private void AdjustConfig(int i, int dir)
    {
        switch (_cfgRows[i].Kind)
        {
            case RowKind.Cycle:
                int n = _cfgRows[i].Options.Length;
                _cfgValues[i] = (_cfgValues[i] + dir + n) % n;
                break;
            case RowKind.Toggle:
                _cfgValues[i] = 1 - _cfgValues[i];
                break;
            default:
                int v = _cfgValues[i] + dir * _cfgRows[i].Step;
                _cfgValues[i] = Math.Max(_cfgRows[i].Min, Math.Min(_cfgRows[i].Max, v));
                break;
        }
    }

    private void HandleMenuControls()
    {
        int rows = _cfgRows.Length + 1;
        if (Game.IsControlJustPressed(GTA.Control.PhoneUp))
            _menuSelection = (_menuSelection - 1 + rows) % rows;
        if (Game.IsControlJustPressed(GTA.Control.PhoneDown))
            _menuSelection = (_menuSelection + 1) % rows;

        bool left   = Game.IsControlJustPressed(GTA.Control.PhoneLeft);
        bool right  = Game.IsControlJustPressed(GTA.Control.PhoneRight);
        bool select = Game.IsControlJustPressed(GTA.Control.PhoneSelect);
        bool cancel = Game.IsControlJustPressed(GTA.Control.PhoneCancel);

        if (_menuSelection < _cfgRows.Length && (left || right))
            AdjustConfig(_menuSelection, right ? 1 : -1);

        if (select)
        {
            if (_menuSelection == _cfgRows.Length)
            {
                SaveIniSettings();
                ResetRound();
                _state = State.Playing;
            }
            else
            {
                AdjustConfig(_menuSelection, 1);
            }
        }

        if (cancel) _state = State.Idle;
    }

    // -- Round lifecycle -----------------------------------------------------------

    // Full scalar + entity reset — a fresh round every time, no leftover state.
    private void ResetRound()
    {
        CleanupEntities();
        _score      = 0;
        _newBest    = false;
        _roundStart = DateTime.UtcNow;
{% if round_type == "survive_waves" %}
        CleanupWave();
        ResetWaves();
        _prevAlive = 0;
{% if hero_row_index >= 0 %}
        _mysticMarkSet   = false;
        _abilityCooldown = DateTime.MinValue;
{% endif %}
{% elif round_type == "pursuit_survive" %}
        Function.Call(Hash.SET_PLAYER_WANTED_LEVEL, Game.Player, {{ round_params.start_wanted }}, false);
        Function.Call(Hash.SET_PLAYER_WANTED_LEVEL_NOW, Game.Player, false);
        _nextEscalation = DateTime.UtcNow.AddSeconds({{ round_params.escalation_interval_s }});
        _heliSpawned    = false;
{% elif round_type == "drift_score" %}
        _comboMultiplier = 1f;
        _isDrifting       = false;
        _lastDriftAt      = DateTime.MinValue;
{% elif round_type == "theft_streak" %}
        _stolenVehicle = null;
        _securedHandles.Clear();
        if (_garageBlip == null)
        {
            _garageBlip             = World.CreateBlip(_garagePos);
            _garageBlip.Sprite      = BlipSprite.Standard;
            _garageBlip.Color       = BlipColor.Yellow;
            _garageBlip.Scale       = 1.1f;
            _garageBlip.IsShortRange = false;
            _garageBlip.Name        = "Garage";
        }
{% endif %}
{% if extra_init %}
        // ── prompt-specific round setup (runs at the start of every round) ──
{{ extra_init | indent(8, True) }}
{% endif %}
    }

    private void RunRound()
    {
        if (Game.Player.Character.IsDead)
        {
            EndRound();
            return;
        }
{% if round_type == "survive_waves" %}
{% if hero_row_index >= 0 %}
        if (_cfgValues[{{ hero_row_index }}] == 1) Game.Player.SetSuperJumpThisFrame();   // Wolverine — passive
{% endif %}
        // Arena horde: clear all {{ waves_cfg.max_waves }} waves; score = kills (+ wave bonus).
        if (_wave == 0 || (_intermissionUntil != DateTime.MinValue && !InIntermission()))
        {
            _intermissionUntil = DateTime.MinValue;
            BeginWave();
            SpawnWave(WaveSizeFor(_wave));
            _prevAlive = AliveCount();
            GTA.UI.Screen.ShowSubtitle("~r~WAVE " + _wave + " ~s~/ {{ waves_cfg.max_waves }}", 2500);
            Function.Call(Hash.PLAY_SOUND_FRONTEND, -1,
                "CHECKPOINT_PERFECT", "HUD_MINI_GAME_SOUNDSET", true);
            return;
        }
        if (InIntermission())
        {
            GTA.UI.Screen.ShowSubtitle("~y~Wave cleared! ~s~Next wave incoming...", 200);
            return;
        }
        int _alive = AliveCount();
        if (_alive < _prevAlive)
        {
            _score += (_prevAlive - _alive);   // one point per kill
            _prevAlive = _alive;
        }
        if (_alive == 0)
        {
            _score += {{ waves_cfg.base_count }};   // wave-clear bonus
            CleanupWave();
            if (WavesRemaining() > 0)
            {
                BeginIntermission();
            }
            else
            {
                EndRound();                    // all waves cleared — victory
            }
        }
{% elif round_type == "pursuit_survive" %}
        // Outlast the heat: score = seconds survived; heat rises every
        // {{ round_params.escalation_interval_s }}s to {{ round_params.max_wanted }} stars.
        _score = (int)(DateTime.UtcNow - _roundStart).TotalSeconds;
        int _wanted = Function.Call<int>(Hash.GET_PLAYER_WANTED_LEVEL, Game.Player);
        if (_wanted == 0)
        {
            EndRound();                        // slipped the heat — round over
            return;
        }
        if (DateTime.UtcNow >= _nextEscalation && _wanted < {{ round_params.max_wanted }})
        {
            Function.Call(Hash.SET_PLAYER_WANTED_LEVEL, Game.Player, _wanted + 1, false);
            Function.Call(Hash.SET_PLAYER_WANTED_LEVEL_NOW, Game.Player, false);
            _nextEscalation = DateTime.UtcNow.AddSeconds({{ round_params.escalation_interval_s }});
            GTA.UI.Screen.ShowSubtitle("~r~THE HEAT IS RISING", 2500);
        }
{% if round_params.spawn_heli_at_level > 0 %}
        if (!_heliSpawned && _wanted >= {{ round_params.spawn_heli_at_level }})
        {
            _heliSpawned = true;
            var _hpos = Game.Player.Character.Position + new Vector3(60f, 60f, 40f);
            var _heli = World.CreateVehicle(new Model("buzzard"), _hpos);
            if (_heli != null)
            {
                var _pilot = World.CreatePed(new Model("s_m_y_pilot_01"), _hpos);
                if (_pilot != null)
                {
                    _pilot.IsPersistent = true;
                    _pilot.SetIntoVehicle(_heli, VehicleSeat.Driver);
                    // TASK_HELI_MISSION mode 6 = attack target
                    Function.Call(Hash.TASK_HELI_MISSION, _pilot, _heli, 0,
                        Game.Player.Character, 0f, 0f, 0f, 6, 40f, 30f, -1f, 0, 40, -1f, 0);
                    _vehicles.Add(_heli);      // CleanupEntities deletes both
                    _peds.Add(_pilot);
                    GTA.UI.Notification.PostTicker("~r~Air support inbound!", false);
                }
                else
                {
                    _heli.Delete();
                }
            }
        }
{% endif %}
{% elif round_type == "drift_score" %}
        // Chain drifts for points; combo decays after {{ round_params.combo_decay_s }}s out of a slide.
        double _driftElapsed = (DateTime.UtcNow - _roundStart).TotalSeconds;
        if (_driftElapsed >= {{ round_params.time_limit_s }})
        {
            EndRound();
            return;
        }
        Vehicle _veh = Game.Player.Character.CurrentVehicle;
        if (_veh != null)
        {
            float _speed = _veh.Speed;
            Vector3 _fwd = _veh.ForwardVector; _fwd.Z = 0f;
            Vector3 _vel = _veh.Velocity;      _vel.Z = 0f;
            float _fwdLen = _fwd.Length();
            float _velLen = _vel.Length();
            float _driftAngle = 0f;
            if (_fwdLen > 0.01f && _velLen > 0.01f)
            {
                float _dot = (_fwd.X * _vel.X + _fwd.Y * _vel.Y) / (_fwdLen * _velLen);
                _dot = Math.Max(-1f, Math.Min(1f, _dot));
                _driftAngle = (float)(Math.Acos(_dot) * 180.0 / Math.PI);
            }
            bool _drifting = _speed >= {{ round_params.min_drift_speed }}f
                && _driftAngle >= {{ round_params.min_drift_angle }}f
                && _driftAngle <= 85f;
            if (_drifting)
            {
                if (!_isDrifting) _comboMultiplier = 1f;
                _comboMultiplier = Math.Min(5f, _comboMultiplier + 0.01f);
                _score += (int)(_driftAngle * 0.1f * _comboMultiplier);
                _lastDriftAt = DateTime.UtcNow;
                _isDrifting  = true;
            }
            else if (_isDrifting
                && (DateTime.UtcNow - _lastDriftAt).TotalSeconds > {{ round_params.combo_decay_s }})
            {
                _isDrifting      = false;
                _comboMultiplier = 1f;
            }
        }
        else if (_isDrifting)
        {
            _isDrifting      = false;
            _comboMultiplier = 1f;
        }
{% elif round_type == "theft_streak" %}
        // Steal any vehicle, drive it to the garage blip to secure it (+1). A
        // secured vehicle's handle is remembered so it can't be re-scored.
        double _theftElapsed = (DateTime.UtcNow - _roundStart).TotalSeconds;
        if (_theftElapsed >= {{ round_params.time_limit_s }})
        {
            EndRound();
            return;
        }
        Vehicle _cur = Game.Player.Character.CurrentVehicle;
        if (_cur != null && _cur.Exists() && !_securedHandles.Contains(_cur.Handle))
        {
            if (_stolenVehicle == null || _stolenVehicle.Handle != _cur.Handle)
            {
                _stolenVehicle = _cur;
                GTA.UI.Screen.ShowSubtitle("~y~Vehicle stolen! ~s~Bring it to the garage blip.", 2500);
            }
            Vector3 _diff = _cur.Position - _garagePos;
            float _gdist = (float)Math.Sqrt(_diff.X * _diff.X + _diff.Y * _diff.Y + _diff.Z * _diff.Z);
            if (_gdist <= {{ round_params.garage_radius }}f)
            {
                _securedHandles.Add(_cur.Handle);
                _stolenVehicle = null;
                _score++;
                GTA.UI.Notification.PostTicker("~g~Car secured! ~w~+1 (" + _score + ")", false);
                Function.Call(Hash.PLAY_SOUND_FRONTEND, -1,
                    "CHECKPOINT_PERFECT", "HUD_MINI_GAME_SOUNDSET", true);
            }
        }
{% else %}
        // Timed round: survive {{ round_params.get("seconds", 60) }}s; score = seconds lasted.
        double _elapsed = (DateTime.UtcNow - _roundStart).TotalSeconds;
        _score = (int)Math.Min(_elapsed, {{ round_params.get("seconds", 60) }});
        if (_elapsed >= {{ round_params.get("seconds", 60) }})
        {
            EndRound();
        }
{% endif %}
    }
{% if round_type == "survive_waves" and hero_row_index >= 0 %}

    // -- Hero ability: E = primary, Q = secondary. Row {{ hero_row_index }} picks the hero:
    //    0 Magneto (push/pull), 1 Wolverine (claws; jump is passive in RunRound), 2 Mystique (mark/warp).
    private void RunHeroAbility(bool primary)
    {
        Ped _self = Game.Player.Character;
        switch (_cfgValues[{{ hero_row_index }}])
        {
            case 0:
                foreach (Vehicle _v in World.GetNearbyVehicles(_self.Position, 15f))
                {
                    Vector3 _diff = _v.Position - _self.Position;
                    float _dist = (float)Math.Sqrt(_diff.X * _diff.X + _diff.Y * _diff.Y + _diff.Z * _diff.Z);
                    if (_dist < 0.5f) continue;
                    Vector3 _dir = new Vector3(_diff.X / _dist, _diff.Y / _dist, _diff.Z / _dist);
                    _v.ApplyForce(primary ? _dir * 12f : _dir * -12f);
                }
                GTA.UI.Notification.PostTicker(primary ? "~b~Magnetic push!" : "~b~Magnetic pull!", false);
                break;
            case 1:
                if (primary)
                {
                    foreach (Ped _p in World.GetNearbyPeds(_self.Position, 2.5f))
                    {
                        if (_p == _self) continue;
                        _p.ApplyDamage(200);
                    }
                    GTA.UI.Notification.PostTicker("~r~Claws!", false);
                }
                break;
            case 2:
                if (primary)
                {
                    _mysticMark    = _self.Position;
                    _mysticMarkSet = true;
                    GTA.UI.Notification.PostTicker("~p~Mark set.", false);
                }
                else if (_mysticMarkSet)
                {
                    _self.Position = _mysticMark;
                    GTA.UI.Notification.PostTicker("~p~Warped.", false);
                }
                break;
        }
    }
{% endif %}

    private void DrawRoundHud()
    {
        var _rt = DateTime.UtcNow - _roundStart;
        string _clock = ((int)_rt.TotalMinutes).ToString("00") + ":" + _rt.Seconds.ToString("00");
        DrawPanelRect(0.90f, 0.055f, 0.14f, 0.075f, 15, 15, 22, 195);
        DrawPanelText("~w~" + _clock, 0.90f, 0.028f, 0.50f, 255, 255, 255, 255, true);
        DrawPanelText("~y~{{ score_label }}: ~w~" + _score + "   ~s~Best: ~w~" + _bestScore,
            0.90f, 0.062f, 0.34f, 255, 255, 255, 255, true);
{% if round_type == "survive_waves" %}
        DrawPanelText("~r~WAVE ~w~" + _wave + " ~s~/ {{ waves_cfg.max_waves }}   ~r~Enemies: ~w~" + AliveCount(),
            0.90f, 0.092f, 0.34f, 255, 255, 255, 255, true);
{% if hero_row_index >= 0 %}
        string _heroHint = _cfgValues[{{ hero_row_index }}] == 0 ? "E push / Q pull"
            : _cfgValues[{{ hero_row_index }}] == 1 ? "E claws" : "E mark / Q warp";
        DrawPanelText("~p~" + _cfgRows[{{ hero_row_index }}].Options[_cfgValues[{{ hero_row_index }}]]
            + ": ~w~" + _heroHint, 0.90f, 0.122f, 0.28f, 255, 255, 255, 255, true);
{% endif %}
{% elif round_type == "pursuit_survive" %}
        DrawPanelText("~r~HEAT: ~w~" + Function.Call<int>(Hash.GET_PLAYER_WANTED_LEVEL, Game.Player)
            + " ~s~/ {{ round_params.max_wanted }} stars",
            0.90f, 0.092f, 0.34f, 255, 255, 255, 255, true);
{% elif round_type == "drift_score" %}
        int _driftTimeLeft = Math.Max(0, {{ round_params.time_limit_s }} - (int)_rt.TotalSeconds);
        DrawPanelText("~b~TIME: ~w~" + _driftTimeLeft + "s   ~o~COMBO x" + _comboMultiplier.ToString("0.0")
            + (_isDrifting ? " ~g~DRIFTING" : ""),
            0.90f, 0.092f, 0.30f, 255, 255, 255, 255, true);
{% elif round_type == "theft_streak" %}
        int _theftTimeLeft = Math.Max(0, {{ round_params.time_limit_s }} - (int)_rt.TotalSeconds);
        DrawPanelText("~b~TIME: ~w~" + _theftTimeLeft + "s   ~g~CARS SECURED: ~w~" + _score,
            0.90f, 0.092f, 0.30f, 255, 255, 255, 255, true);
        DrawPanelText(_stolenVehicle != null ? "~y~Carrying a stolen car — get it to the garage!"
            : "~s~Steal a car to begin.", 0.90f, 0.122f, 0.28f, 255, 255, 255, 255, true);
{% endif %}
    }

    private void EndRound()
    {
        _newBest = _score > _bestScore;
        if (_newBest)
        {
            _bestScore = _score;
            SaveBestScore();
        }
        CleanupRound();
        Function.Call(Hash.PLAY_SOUND_FRONTEND, -1,
            _newBest ? "MEDAL_UP" : "CHECKPOINT_NORMAL", "HUD_MINI_GAME_SOUNDSET", true);
        _state = State.Results;
    }

    private void AbortRound()
    {
        CleanupRound();
        _state = State.Menu;
        _menuSelection = 0;
        GTA.UI.Notification.PostTicker("~c~Round aborted.", false);
    }

    // Round-type teardown on top of the shared entity cleanup — every exit path
    // (finish, abort, script unload) funnels through here.
    private void CleanupRound()
    {
        CleanupEntities();
{% if round_type == "survive_waves" %}
        CleanupWave();
        ResetWaves();
        _prevAlive = 0;
{% elif round_type == "pursuit_survive" %}
        Function.Call(Hash.SET_PLAYER_WANTED_LEVEL, Game.Player, 0, false);
        Function.Call(Hash.SET_PLAYER_WANTED_LEVEL_NOW, Game.Player, false);
{% elif round_type == "drift_score" %}
        _isDrifting      = false;
        _comboMultiplier = 1f;
{% elif round_type == "theft_streak" %}
        _stolenVehicle = null;
        if (_garageBlip != null) { _garageBlip.Delete(); _garageBlip = null; }
{% endif %}
    }

    private void DrawResults()
    {
        DrawPanelRect(0.50f, 0.42f, 0.36f, 0.24f, 18, 18, 26, 230);
        DrawPanelRect(0.50f, 0.325f, 0.36f, 0.05f, 0, 95, 160, 235);
        DrawPanelText("ROUND OVER", 0.50f, 0.307f, 0.62f, 255, 255, 255, 255, true);
        DrawPanelText("~y~{{ score_label }}: ~w~" + _score, 0.50f, 0.385f, 0.58f, 255, 255, 255, 255, true);
        DrawPanelText(_newBest ? "~g~NEW BEST!" : "~s~Best: ~w~" + _bestScore,
            0.50f, 0.435f, 0.44f, 255, 255, 255, 255, true);
        DrawPanelText("~b~ENTER~s~ play again   |   ~b~BACK~s~ menu   |   ~b~F7~s~ close",
            0.50f, 0.49f, 0.32f, 170, 170, 170, 255, true);
    }

    // -- Cleanup ---------------------------------------------------------------------

    private void CleanupEntities()
    {
        foreach (var p in _peds)     { if (p != null) p.Delete(); }
        foreach (var v in _vehicles) { if (v != null) v.Delete(); }
        foreach (var r in _props)    { if (r != null) r.Delete(); }
        _peds.Clear();
        _vehicles.Clear();
        _props.Clear();
    }

    private void OnAborted(object sender, EventArgs e)
    {
        CleanupRound();
{% if extra_tick or extra_init %}
        // prompt-specific state dies with the script; entities above are the
        // only world-side residue a minigame may leave.
{% endif %}
    }
{% if round_type == "survive_waves" %}
{{ spawner.methods(wave_spawner_cfg, wave_weapon_native) }}
{{ waves.methods(waves_cfg) }}
{% endif %}
{{ helpers.draw_methods() }}
{{ helpers.score_store(ini_file) }}
{% for m in extra_methods %}

    // ── prompt-specific ──
    {{ m.signature }}
    {
{{ m.body | indent(8, True) }}
    }
{% endfor %}
}
