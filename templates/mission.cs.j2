    // -- Start trigger --------------------------------------------------------

    private void CheckStart()
    {
        if (!_startReady)
        {
            _startBlip             = World.CreateBlip(SpawnOrigin);
            _startBlip.Sprite      = BlipSprite.Standard;
            _startBlip.Color       = BlipColor.Yellow;
            _startBlip.Scale       = 1.1f;
            _startBlip.IsFlashing  = true;
            _startBlip.IsShortRange = false;
            _startBlip.Name        = "{{ mission_name }}";
            _startReady            = true;

            // One-time ticker so player sees the mission name and knows to find the blip
            GTA.UI.Notification.PostTicker(
                "~y~Mission available: ~w~{{ mission_name }}"
                + "~n~~s~Go to the ~y~flashing yellow blip ~s~on your radar.", true);
        }

        float _distToStart = Game.Player.Character.Position.DistanceTo(SpawnOrigin);

        // Show a permanent subtitle hinting the key so player doesn't miss it
        if (_distToStart < 50f)
            GTA.UI.Screen.ShowSubtitle(
                _distToStart < 15f
                    ? "~y~[F5] ~w~Start: ~y~{{ mission_name }}"
                    : "~s~Approach the ~y~yellow blip ~s~to start ~y~{{ mission_name }}", 200);

        if (_distToStart < 15f && Game.IsKeyPressed(Keys.F5))
        {
            if (_startBlip != null) { _startBlip.Delete(); _startBlip = null; }
            Init();
        }
    }

