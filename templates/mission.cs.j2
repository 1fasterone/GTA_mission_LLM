    // Mission progress 0..1: completed steps / total, plus the intra-step
    // fraction (visited / total points) while a scavenger step is running.
    private float MissionProgress()
    {
        float p = (float)_step;
{% for step in steps %}
{% if step.type == "scavenger" and step.scavenger_idx is not none %}
        if (_step == {{ step.index }})
            p += (float)_scavVisited.Count / (float){{ scavenger_sets[step.scavenger_idx].array_name }}.Length;
{% endif %}
{% endfor %}
        p /= {{ total_steps }}f;
        return p < 0f ? 0f : (p > 1f ? 1f : p);
    }
