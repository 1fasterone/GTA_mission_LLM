            case State.Inactive: CheckStart(); break;
            case State.Active:   RunStep();    break;
        }
{% if race_checkpoints %}
        if (_state == State.Active) UpdateRivals();
{% endif %}
{% if editor_triggers %}
        if (_state == State.Active)
        {
            var pp = Game.Player.Character.Position;
            for (int ti = 0; ti < _editorTriggers.Length; ti++)
            {
                if (_editorTriggers[ti].Fired) continue;
                if (pp.DistanceTo(_editorTriggers[ti].Pos) <= _editorTriggers[ti].Radius)
                {
                    _editorTriggers[ti].Fired = true;
                    GTA.UI.Notification.PostTicker("~y~Trigger: ~w~" + _editorTriggers[ti].Id, false);
                    int ls = _editorTriggers[ti].LinkedStep;
                    if (ls >= 0) _step = ls;
                }
            }
        }
{% endif %}
{% if editor_paths %}
        if (_state == State.Active) UpdatePatrols();
{% endif %}
{% if editor_zones %}
