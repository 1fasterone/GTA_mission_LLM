    // -- Spawning -------------------------------------------------------------

    private void SpawnPeds()
    {
{% for ped in peds %}
{% if ped.model != "UNRESOLVED" %}
        // {{ ped.role }}: {{ ped.model }}
        for (int i = 0; i < {{ ped.count }}; i++)
        {
{% if ped.abs_x is not none %}
            // Exact placement from the Mission Editor (extra copies fan out slightly).
            var pos = new Vector3({{ "%.2f"|format(ped.abs_x) }}f, {{ "%.2f"|format(ped.abs_y) }}f, {{ "%.2f"|format(ped.abs_z) }}f)
                      + new Vector3(i * 2.5f, i * 1.5f, 0f);
{% else %}
            var pos = SpawnOrigin + new Vector3({{ "%.1f"|format(ped.base_x) }}f + i * 2.5f,
                                               {{ "%.1f"|format(ped.base_y) }}f + i * 1.5f, 0f);
{% endif %}
            var p = World.CreatePed(new Model("{{ ped.model }}"), pos);
            if (p == null) continue;
            p.IsPersistent = true;
{% if ped.heading is not none %}
            p.Heading = {{ "%.1f"|format(ped.heading) }}f;
{% endif %}
{% if ped.weapon_name %}
            // GET_HASH_KEY resolves any weapon string at runtime, including DLC weapons.
            // Split into a local to avoid parser ambiguity with nested generic calls.
            { int _wh = Function.Call<int>(Hash.GET_HASH_KEY, "{{ ped.weapon_name }}");
              Function.Call(Hash.GIVE_WEAPON_TO_PED, p, _wh, 100, false, true); }
{% endif %}
{% if ped.patrol_path_idx is not none %}
            // Patrol path binding — walk the editor-authored waypoint loop.
            {
                var _path = EditorPathByIndex({{ ped.patrol_path_idx }});
                if (_path != null && _path.Length > 0)
                {
                    p.Task.RunTo(_path[0], true);
                    _patrols.Add(new PatrolUnit { Ped = p, Path = _path, Wp = 0 });
                }
            }
{% elif ped.is_hostile %}
            p.Task.Combat(Game.Player.Character);
{% elif ped.role == "ally" %}
            // TaskInvoker.FollowToOffsetOfEntity removed in 3.9 — use native directly
            Function.Call(Hash.TASK_FOLLOW_TO_OFFSET_OF_ENTITY,
                p, Game.Player.Character, 1.0f, -1.0f, 0.0f, 2.0f, -1, 1.0f, true);
{% elif ped.role == "guard" %}
            p.Task.GuardCurrentPosition();
{% elif ped.role == "patrol" %}
            p.Task.WanderAround();
{% endif %}
            _peds.Add(p);
        }
{% endif %}
{% endfor %}
    }

    private void SpawnVehicles()
    {
{% for v in vehicles %}
{% if v.model != "UNRESOLVED" and not v.is_race_opponent %}
        // {{ v.role }}: {{ v.model }}
        for (int i = 0; i < {{ v.count }}; i++)
        {
{% if v.abs_x is not none %}
            var pos = new Vector3({{ "%.2f"|format(v.abs_x) }}f, {{ "%.2f"|format(v.abs_y) }}f, {{ "%.2f"|format(v.abs_z) }}f)
                      + new Vector3(i * 7f, 0f, 0f);
{% else %}
            var pos = SpawnOrigin + new Vector3({{ "%.1f"|format(v.base_x) }}f + i * 7f,
                                               {{ "%.1f"|format(v.base_y) }}f, 0f);
{% endif %}
            var veh = World.CreateVehicle(new Model("{{ v.model }}"), pos);
{% if v.heading is not none %}
            if (veh != null) veh.Heading = {{ "%.1f"|format(v.heading) }}f;
{% endif %}
            if (veh != null) _vehicles.Add(veh);
        }
{% elif v.model != "UNRESOLVED" and v.is_race_opponent %}
        // race_opponent: {{ v.model }} — spawns with AI driver
        for (int i = 0; i < {{ v.count }}; i++)
        {
            var rpos = SpawnOrigin + new Vector3({{ "%.1f"|format(v.base_x) }}f + i * 8f,
                                                {{ "%.1f"|format(v.base_y) }}f + i * 4f, 0f);
            var rveh = World.CreateVehicle(new Model("{{ v.model }}"), rpos);
            if (rveh == null) continue;
            _vehicles.Add(rveh);
            // Spawn AI driver and start driving toward first race checkpoint
            // PedHash.Business01AMM is a known-valid generic civilian in SHVDN3 3.9.0
            var rdriver = World.CreatePed(PedHash.Business01AMM, rpos);
            if (rdriver == null) continue;
            rdriver.IsPersistent = true;
            rdriver.SetIntoVehicle(rveh, VehicleSeat.Driver);
{% if race_checkpoints %}
            // Register the rival so UpdateRivals() can re-path it around the full
            // circuit every tick (one-shot DriveTo only reaches the first point).
            // SHVDN3 3.9.0: DriveTo(Vehicle, Vector3, radius, VehicleDrivingFlags, speed)
            rdriver.Task.DriveTo(rveh, {{ race_checkpoints[0].array_name }}[0],
                5f, (VehicleDrivingFlags)786603, 40f);
            _rivalDrivers.Add(rdriver);
            _rivalCp.Add(0);
{% endif %}
            _peds.Add(rdriver);
        }
{% endif %}
{% endfor %}
    }

    private void SpawnProps()
    {
{% if race_checkpoints %}
        // Start/finish line at the first checkpoint of the primary circuit.
        {
            var _fp = World.CreateProp(new Model("prop_start_finish_line_01"),
                {{ race_checkpoints[0].array_name }}[0], false, false);
            if (_fp != null)
            {
                _fp.IsPositionFrozen = true;
                _props.Add(_fp);
            }
        }
{% endif %}
{% for prop in props %}
{% if prop.model != "UNRESOLVED" %}
        // {{ prop.role }}: {{ prop.model }}
        {
{% if prop.abs_x is not none %}
            var pos = new Vector3({{ "%.2f"|format(prop.abs_x) }}f, {{ "%.2f"|format(prop.abs_y) }}f, {{ "%.2f"|format(prop.abs_z) }}f);
{% else %}
            var pos = SpawnOrigin + new Vector3({{ "%.1f"|format(prop.base_x) }}f,
                                               {{ "%.1f"|format(prop.base_y) }}f, 0f);
{% endif %}
            var p = World.CreateProp(new Model("{{ prop.model }}"), pos, false, false);
            if (p != null)
            {
{% if prop.heading is not none %}
                p.Heading = {{ "%.1f"|format(prop.heading) }}f;
{% endif %}
{% if prop.role != "pickup" %}
                // Obstacles / decorations (cones, banners, ramps, lights) stay put.
                p.IsPositionFrozen = true;
                Function.Call(Hash.PLACE_OBJECT_ON_GROUND_PROPERLY, p);
{% endif %}
                _props.Add(p);
            }
        }
{% endif %}
{% endfor %}
    }

    // -- Utilities ------------------------------------------------------------
{% if race_checkpoints %}

    // Draw a translucent checkpoint cylinder at the active target (immediate-mode,
    // must be called every tick while the race step is running).
    private void DrawCheckpointMarker(Vector3 pos)
    {
        World.DrawMarker(MarkerType.VerticalCylinder, pos, Vector3.Zero, Vector3.Zero,
            new Vector3(8f, 8f, 4f), Color.FromArgb(140, 255, 190, 0));
    }

    private void PlayCheckpointChime()
    {
        Function.Call(Hash.PLAY_SOUND_FRONTEND, -1,
            "CHECKPOINT_NORMAL", "HUD_MINI_GAME_SOUNDSET", true);
    }

    // Re-path each AI rival to the next checkpoint as it arrives, so opponents
    // run the whole circuit instead of idling after the first point.
    private void UpdateRivals()
    {
        for (int i = 0; i < _rivalDrivers.Count; i++)
        {
            var d = _rivalDrivers[i];
            if (d == null || !d.Exists() || d.IsDead) continue;
            var veh = d.CurrentVehicle;
            if (veh == null) continue;
            int cp = _rivalCp[i];
            if (veh.Position.DistanceTo({{ race_checkpoints[0].array_name }}[cp]) < 15f)
            {
                cp = (cp + 1) % {{ race_checkpoints[0].array_name }}.Length;
                _rivalCp[i] = cp;
                d.Task.DriveTo(veh, {{ race_checkpoints[0].array_name }}[cp],
                    5f, (VehicleDrivingFlags)786603, 45f);
            }
        }
    }
{% endif %}

    private void RefreshBlip()
    {
        if (_blip != null) { _blip.Delete(); _blip = null; }
        switch (_step)
        {
{% for step in steps %}
            case {{ step.index }}:
{% if step.type == "go_to" and step.waypoint_idx is not none %}
                _blip = World.CreateBlip(Waypoints[{{ step.waypoint_idx }}]);
{% elif step.type == "kill_all" %}
                foreach (var _p in _peds)
                    if (_p != null && _p.IsAlive) { _blip = _p.AddBlip(); break; }
{% elif step.type == "pickup" %}
                foreach (var _pr in _props)
                    if (_pr != null) { _blip = _pr.AddBlip(); break; }
{% elif step.type == "get_in_vehicle" %}
                foreach (var _v in _vehicles)
                    if (_v != null) { _blip = _v.AddBlip(); break; }
{% elif step.type == "deliver" and step.next_waypoint is not none %}
                _blip = World.CreateBlip(Waypoints[{{ step.next_waypoint }}]);
{% elif step.type in ("checkpoint", "race_lap") and step.race_checkpoint_idx is not none %}
                _blip = World.CreateBlip({{ race_checkpoints[step.race_checkpoint_idx].array_name }}[_cpIdx]);
{% endif %}
                break;
{% endfor %}
        }
        if (_blip != null)
        {
            _blip.Color = BlipColor.Yellow;
            _blip.Name  = "{{ mission_name }}";
        }
    }

{% if editor_paths %}
    private void UpdatePatrols()
    {
        for (int i = 0; i < _patrols.Count; i++)
        {
            var u = _patrols[i];
            if (u.Ped == null || !u.Ped.Exists() || u.Ped.IsDead) continue;
            if (u.Ped.Position.DistanceTo(u.Path[u.Wp]) < 3.0f)
            {
                u.Wp = (u.Wp + 1) % u.Path.Length;     // loop the route
                u.Ped.Task.RunTo(u.Path[u.Wp], true);
            }
            // If the ped was knocked off-task (e.g. ragdoll recovered), re-issue.
            else if (!u.Ped.IsWalking && !u.Ped.IsRunning)
            {
                u.Ped.Task.RunTo(u.Path[u.Wp], true);
            }
        }
    }
{% endif %}
{% if editor_zones %}
    private void CheckZones()
    {
        var pp = Game.Player.Character.Position;
        var p2 = new Vector2(pp.X, pp.Y);

        // No-go zones: entering any fails the mission immediately.
{% for zone in editor_zones %}
{% if zone.kind == "nogo" %}
        if (PointInPoly(p2, EditorZone_{{ loop.index0 }}))
        {
            GTA.UI.Screen.ShowSubtitle("~r~Out of bounds: ~w~{{ zone.name }}", 1000);
            FailMission();
            return;
        }
{% endif %}
{% endfor %}

        // Mission zones: player must stay inside at least one. Leaving warns,
        // then fails after a grace period.
        if (_hasMissionZone)
        {
            bool inside = false;
{% for zone in editor_zones %}
{% if zone.kind == "mission" %}
            if (PointInPoly(p2, EditorZone_{{ loop.index0 }})) inside = true;
{% endif %}
{% endfor %}
            if (inside)
            {
                _outOfBoundsSecs = 0f;
            }
            else
            {
                _outOfBoundsSecs += Game.LastFrameTime;
                int remain = (int)System.Math.Ceiling(OutOfBoundsGrace - _outOfBoundsSecs);
                GTA.UI.Screen.ShowSubtitle(
                    "~y~Return to the mission area! ~w~(" + remain + "s)", 800);
                if (_outOfBoundsSecs >= OutOfBoundsGrace)
                {
                    FailMission();
                }
            }
        }
    }

    private void FailMission()
    {
        if (_state != State.Active) return;
        GTA.UI.Notification.PostTicker("~r~Mission Failed", false);
{% if audio_fail %}
        Function.Call(Hash.PLAY_MISSION_COMPLETE_AUDIO, "{{ audio_fail }}");
{% endif %}
        Cleanup();
        _state = State.Failed;
    }
{% endif %}
    private void Complete()
    {
        GTA.UI.Notification.PostTicker("~g~Mission Complete", false);
{% if audio_pass %}
        Function.Call(Hash.PLAY_MISSION_COMPLETE_AUDIO, "{{ audio_pass }}");
{% endif %}
        Cleanup();
        _state = State.Complete;
    }

    private void OnAborted(object sender, EventArgs e)
    {
        if (_startBlip != null) { _startBlip.Delete(); _startBlip = null; }
        Cleanup();
    }

    private void Cleanup()
    {
        if (_blip != null) _blip.Delete();
        foreach (var p in _peds)     { if (p != null) p.Delete(); }
        foreach (var v in _vehicles) { if (v != null) v.Delete(); }
        foreach (var r in _props)    { if (r != null) r.Delete(); }
        _peds.Clear();
        _vehicles.Clear();
        _props.Clear();
{% if editor_paths %}
        _patrols.Clear();
{% endif %}
    }
{% for m in extra_methods %}

    // ── prompt-specific ──
    {{ m.signature }}
    {
{{ m.body | indent(8, True) }}
    }
{% endfor %}
}
