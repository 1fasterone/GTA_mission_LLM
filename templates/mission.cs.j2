    private void UpdatePatrols()
    {
        for (int i = 0; i < _patrols.Count; i++)
        {
            var u = _patrols[i];
            if (u.Ped == null || !u.Ped.Exists() || u.Ped.IsDead || u.State == PatrolRouteState.Complete) continue;
            if (u.Path == null || u.Path.Length == 0) { u.State = PatrolRouteState.Complete; continue; }
            if (u.Wp < 0) u.Wp = 0;
            if (u.Wp >= u.Path.Length) u.Wp = u.Path.Length - 1;
            if (u.Dir == 0) u.Dir = 1;

            if (u.Ped.Position.DistanceTo(u.Path[u.Wp]) < 3.0f)
            {
                if (AdvancePatrol(u))
                {
                    u.Ped.Task.RunTo(u.Path[u.Wp], true);
                }
            }
            // If the ped was knocked off-task (e.g. ragdoll recovered), re-issue.
            else if (!u.Ped.IsWalking && !u.Ped.IsRunning)
            {
                u.Ped.Task.RunTo(u.Path[u.Wp], true);
            }
        }
    }

    private bool AdvancePatrol(PatrolUnit u)
    {
        if (u == null || u.Path == null || u.Path.Length == 0) return false;
        if (u.Path.Length == 1) { u.State = PatrolRouteState.Complete; return false; }

        switch (u.Mode)
        {
            case PatrolRouteMode.Once:
                if (u.Wp >= u.Path.Length - 1)
                {
                    u.State = PatrolRouteState.Complete;
                    return false;
                }
                u.Wp++;
                return true;
            case PatrolRouteMode.PingPong:
                int next = u.Wp + u.Dir;
                if (next < 0 || next >= u.Path.Length)
                {
                    u.Dir = -u.Dir;
                    next = u.Wp + u.Dir;
                }
                if (next < 0 || next >= u.Path.Length)
                {
                    u.State = PatrolRouteState.Complete;
                    return false;
                }
                u.Wp = next;
                return true;
            case PatrolRouteMode.Loop:
            default:
                u.Wp = (u.Wp + 1) % u.Path.Length;
                return true;
        }
    }
{% endif %}
{% if editor_zones %}
    private void CheckZones()
    {
        var pp = Game.Player.Character.Position;
        var p2 = new Vector2(pp.X, pp.Y);

        // No-go zones: entering any fails the mission immediately.
{% for zone in editor_zones %}
{% if zone.kind == "nogo" %}
        if (PointInPoly(p2, EditorZone_{{ loop.index0 }}))
        {
            GTA.UI.Screen.ShowSubtitle("~r~Out of bounds: ~w~{{ zone.name }}", 1000);
            FailMission();
            return;
        }
{% endif %}
{% endfor %}

        // Mission zones: player must stay inside at least one. Leaving warns,
        // then fails after a grace period.
        if (_hasMissionZone)
        {
            bool inside = false;
{% for zone in editor_zones %}
{% if zone.kind == "mission" %}
            if (PointInPoly(p2, EditorZone_{{ loop.index0 }})) inside = true;
{% endif %}
{% endfor %}
            if (inside)
            {
                _outOfBoundsSecs = 0f;
            }
            else
            {
                _outOfBoundsSecs += Game.LastFrameTime;
                int remain = (int)System.Math.Ceiling(OutOfBoundsGrace - _outOfBoundsSecs);
                GTA.UI.Screen.ShowSubtitle(
                    "~y~Return to the mission area! ~w~(" + remain + "s)", 800);
                if (_outOfBoundsSecs >= OutOfBoundsGrace)
                {
                    FailMission();
                }
            }
        }
    }

    private void FailMission()
    {
        if (_state != State.Active) return;
        GTA.UI.Notification.PostTicker("~r~Mission Failed", false);
{% if audio_fail %}
        Function.Call(Hash.PLAY_MISSION_COMPLETE_AUDIO, "{{ audio_fail }}");
{% endif %}
        Cleanup();
        _state = State.Failed;
    }
{% endif %}
    private void Complete()
    {
        GTA.UI.Notification.PostTicker("~g~Mission Complete", false);
{% if audio_pass %}
        Function.Call(Hash.PLAY_MISSION_COMPLETE_AUDIO, "{{ audio_pass }}");
{% endif %}
{% if reward_cash > 0 %}
        // Cash reward — SP total-cash stat (HeliRace pattern), money fallback.
        try
        {
            var _pm = (PedHash)Game.Player.Character.Model.Hash;
            string _stat = _pm == PedHash.Michael  ? "SP0_TOTAL_CASH"
                         : _pm == PedHash.Franklin ? "SP1_TOTAL_CASH"
                         : "SP2_TOTAL_CASH";
            int _sh = Function.Call<int>(Hash.GET_HASH_KEY, _stat);
            var _cur = new OutputArgument();
            Function.Call(Hash.STAT_GET_INT, _sh, _cur, -1);
            Function.Call(Hash.STAT_SET_INT, _sh, _cur.GetResult<int>() + {{ reward_cash }}, true);
        }
        catch
        {
            Game.Player.Money += {{ reward_cash }};
        }
        GTA.UI.Notification.PostTicker("~g~Reward: ~w~${{ reward_cash }}", false);
{% endif %}
        Cleanup();
        _state = State.Complete;
    }

    private void OnAborted(object sender, EventArgs e)
    {
        if (_startBlip != null) { _startBlip.Delete(); _startBlip = null; }
        Cleanup();
    }

    private void Cleanup()
    {
{% if events_change_weather %}
        // Restore the mission's configured weather if a storm event changed it.
        if (_weatherChanged)
        {
{% if config_menu %}
            Function.Call(Hash.SET_WEATHER_TYPE_NOW_PERSIST, _cfgWeatherOptions[_cfgWeatherIdx]);
{% else %}
            Function.Call(Hash.SET_WEATHER_TYPE_NOW_PERSIST, "{{ weather }}");
{% endif %}
            Function.Call(Hash.SET_WIND_SPEED, 0f);
            _weatherChanged = false;
        }
{% endif %}
{% if scavenger_sets %}
        foreach (var sb in _scavBlips) { if (sb != null) sb.Delete(); }
        _scavBlips.Clear();
        _scavVisited.Clear();
{% endif %}
        if (_blip != null) _blip.Delete();
        foreach (var p in _peds)     { if (p != null) p.Delete(); }
        foreach (var v in _vehicles) { if (v != null) v.Delete(); }
        foreach (var r in _props)    { if (r != null) r.Delete(); }
        _peds.Clear();
        _vehicles.Clear();
        _props.Clear();
{% if editor_paths %}
        _patrols.Clear();
{% endif %}
    }
{% for m in extra_methods %}

    // ── prompt-specific ──
    {{ m.signature }}
    {
{{ m.body | indent(8, True) }}
    }
{% endfor %}
}
