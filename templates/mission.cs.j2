    // -- Step machine ---------------------------------------------------------

    private void RunStep()
    {
        if (Game.Player.Character.IsDead)
        {
            GTA.UI.Notification.PostTicker("~r~Mission Failed", false);
            Function.Call(Hash.PLAY_MISSION_COMPLETE_AUDIO, "{{ audio_fail }}");
            Cleanup();
            _state = State.Failed;
            return;
        }
        if (_step != _lastBlipStep)
        {
            RefreshBlip();
            _lastBlipStep = _step;
        }
        switch (_step)
        {
{% for step in steps %}
            case {{ step.index }}: Step{{ step.index }}_{{ step.type | upper }}(); break;
{% endfor %}
            default: Complete(); break;
        }
    }

{% for step in steps %}
    private void Step{{ step.index }}_{{ step.type | upper }}()
    {
{% if step.type == "go_to" %}
{% if step.waypoint_idx is not none %}
        if (Game.Player.Character.Position.DistanceTo(Waypoints[{{ step.waypoint_idx }}]) < 3f)
        {
            GTA.UI.Notification.PostTicker("{{ step.label }}", false);
            _step++;
        }
{% endif %}
{% elif step.type == "kill_all" %}
        bool allDead = _peds.Count == 0;
        if (!allDead)
        {
            allDead = true;
            foreach (var p in _peds)
                if (p != null && p.IsAlive) { allDead = false; break; }
        }
        if (allDead)
        {
            GTA.UI.Notification.PostTicker("~g~{{ step.label }}", false);
            _step++;
        }
{% elif step.type == "pickup" %}
        foreach (var prop in _props)
        {
            if (prop == null) continue;
            if (Game.Player.Character.Position.DistanceTo(prop.Position) < 2f)
            {
                prop.Delete();
                GTA.UI.Notification.PostTicker("~g~{{ step.label }}", false);
                _step++;
                break;
            }
        }
{% elif step.type == "deliver" %}
        if (_blip != null && Game.Player.Character.Position.DistanceTo(_blip.Position) < 3f)
        {
            GTA.UI.Notification.PostTicker("~g~{{ step.label }}", false);
            _step++;
        }
{% elif step.type == "get_in_vehicle" %}
        // Only advance if the player is inside one of the spawned mission vehicles.
        bool _inMissionVeh = false;
        foreach (var mv in _vehicles)
            if (mv != null && Game.Player.Character.CurrentVehicle == mv)
                { _inMissionVeh = true; break; }
        if (_inMissionVeh)
        {
            GTA.UI.Notification.PostTicker("~g~{{ step.label }}", false);
            _step++;
        }
{% elif step.type == "escape" %}
        if (Function.Call<int>(Hash.GET_PLAYER_WANTED_LEVEL, Game.Player) == 0)
        {
            GTA.UI.Notification.PostTicker("~g~{{ step.label }}", false);
            _step++;
        }
{% elif step.type == "wait" %}
        Wait(3000);
        GTA.UI.Notification.PostTicker("{{ step.label }}", false);
        _step++;
{% elif step.type == "checkpoint" %}
{% set rci = step.race_checkpoint_idx %}
{% if rci is not none %}
{% set rc = race_checkpoints[rci] %}
        var _cpArr{{ step.index }} = {{ rc.array_name }};
        DrawCheckpointMarker(_cpArr{{ step.index }}[_cpIdx]);
{% if rc.require_vehicle %}
        if (!Game.Player.Character.IsInVehicle())
        {
            GTA.UI.Screen.ShowSubtitle("~r~You must be in a vehicle!", 200);
            return;
        }
{% endif %}
        if (Game.Player.Character.Position.DistanceTo(_cpArr{{ step.index }}[_cpIdx]) < 10f)
        {
            _cpIdx++;
            PlayCheckpointChime();
            if (_cpIdx >= _cpArr{{ step.index }}.Length)
            {
                _cpIdx = 0;
                GTA.UI.Notification.PostTicker("~g~{{ step.label }}", false);
                _step++;
            }
            else
            {
                GTA.UI.Screen.ShowSubtitle(
                    "~y~Checkpoint ~w~" + (_cpIdx) + " ~s~/ ~w~" + _cpArr{{ step.index }}.Length, 200);
            }
        }
        else
        {
            GTA.UI.Screen.ShowSubtitle(
                "~y~Checkpoint ~w~" + (_cpIdx + 1) + " ~s~/ ~w~" + _cpArr{{ step.index }}.Length
                + "   ~s~Reach the next checkpoint", 200);
        }
{% endif %}
{% elif step.type == "race_lap" %}
{% set rci = step.race_checkpoint_idx %}
{% if rci is not none %}
{% set rc = race_checkpoints[rci] %}
        var _rcArr{{ step.index }} = {{ rc.array_name }};
        int _totalLaps{{ step.index }} = {{ rc.lap_count }};
        DrawCheckpointMarker(_rcArr{{ step.index }}[_cpIdx]);
        if (_lapStart == DateTime.MinValue) _lapStart = DateTime.UtcNow;
{% if rc.require_vehicle %}
        if (!Game.Player.Character.IsInVehicle())
        {
            GTA.UI.Screen.ShowSubtitle("~r~Get in a vehicle to race!", 200);
            return;
        }
{% endif %}
        GTA.UI.Screen.ShowSubtitle(
            "~y~Lap ~w~" + (_lapsDone + 1) + " ~s~/ ~w~" + _totalLaps{{ step.index }}
            + "   ~y~CP ~w~" + (_cpIdx + 1) + " ~s~/ ~w~" + _rcArr{{ step.index }}.Length
            + (_bestLap > 0 ? "   ~y~Best ~w~" + _bestLap.ToString("0.0") + "s" : ""), 200);
        if (Game.Player.Character.Position.DistanceTo(_rcArr{{ step.index }}[_cpIdx]) < 10f)
        {
            _cpIdx++;
            PlayCheckpointChime();
            if (_cpIdx >= _rcArr{{ step.index }}.Length)
            {
                _cpIdx = 0;
                _lapsDone++;
                // Record lap time and start the next lap's clock.
                double _lapTime = (DateTime.UtcNow - _lapStart).TotalSeconds;
                if (_bestLap < 0 || _lapTime < _bestLap) _bestLap = _lapTime;
                _lapStart = DateTime.UtcNow;
                if (_lapsDone >= _totalLaps{{ step.index }})
                {
                    _lapsDone = 0;
                    _cpIdx    = 0;
                    _lapStart = DateTime.MinValue;
                    // ── Finish ceremony ──
                    GTA.UI.Screen.ShowSubtitle(
                        "~y~~h~FINISH!~h~ ~s~Best lap ~w~" + _bestLap.ToString("0.00") + "s", 6000);
                    Function.Call(Hash.PLAY_SOUND_FRONTEND, -1,
                        "RACE_PLACED", "HUD_AWARDS", true);
                    GTA.UI.Notification.PostTicker("~g~{{ step.label }}", false);
                    _step++;
                }
                else
                {
                    GTA.UI.Notification.PostTicker(
                        "~y~Lap " + _lapsDone + " complete  (" + _lapTime.ToString("0.0") + "s)", false);
                    Function.Call(Hash.PLAY_SOUND_FRONTEND, -1,
                        "CHECKPOINT_AHEAD", "HUD_MINI_GAME_SOUNDSET", true);
                }
            }
        }
{% endif %}
{% elif step.type == "timer" %}
        if (_stepStart == DateTime.MinValue) _stepStart = DateTime.UtcNow;
        double _elapsed{{ step.index }} = (DateTime.UtcNow - _stepStart).TotalSeconds;
        double _remain{{ step.index }}  = {{ step.timer_seconds }} - _elapsed{{ step.index }};
        if (_remain{{ step.index }} <= 0)
        {
            _stepStart = DateTime.MinValue;
            GTA.UI.Notification.PostTicker("~g~{{ step.label }}", false);
            _step++;
        }
        else
        {
            GTA.UI.Screen.ShowSubtitle(
                "~y~Time remaining: ~w~" + ((int)_remain{{ step.index }}).ToString() + "s", 200);
        }
{% elif step.type == "scavenger" and step.scavenger_idx is not none %}
{% set sc = scavenger_sets[step.scavenger_idx] %}
        // Any-order collection: visit every point, blips flip Yellow → Green.
        if (_scavBlips.Count == 0)
        {
            for (int si = 0; si < {{ sc.array_name }}.Length; si++)
            {
                var b = World.CreateBlip({{ sc.array_name }}[si]);
                b.Color = BlipColor.Yellow;
                b.Name  = "{{ step.label }}";
                _scavBlips.Add(b);
            }
        }
        var _scPos{{ step.index }} = Game.Player.Character.Position;
        for (int si = 0; si < {{ sc.array_name }}.Length; si++)
        {
            if (_scavVisited.Contains(si)) continue;
            if (_scPos{{ step.index }}.DistanceTo({{ sc.array_name }}[si]) < {{ "%.1f"|format(sc.radius) }}f)
            {
                _scavVisited.Add(si);
                if (si < _scavBlips.Count && _scavBlips[si] != null)
                {
                    _scavBlips[si].Color = BlipColor.Green;
                    _scavBlips[si].Scale = 0.6f;
                }
                Function.Call(Hash.PLAY_SOUND_FRONTEND, -1,
                    "CHECKPOINT_NORMAL", "HUD_MINI_GAME_SOUNDSET", true);
            }
        }
        if (_scavVisited.Count >= {{ sc.array_name }}.Length)
        {
            foreach (var b in _scavBlips) { if (b != null) b.Delete(); }
            _scavBlips.Clear();
            _scavVisited.Clear();
            GTA.UI.Notification.PostTicker("~g~{{ step.label }}", false);
            _step++;
        }
        else
        {
            GTA.UI.Screen.ShowSubtitle("~y~Collected: ~w~" + _scavVisited.Count
                + " ~s~/ ~w~" + {{ sc.array_name }}.Length + " ~s~(any order)", 200);
        }
{% else %}
#error Unknown step type "{{ step.type }}" in mission template — add a handler in mission.cs.j2
{% endif %}
    }

{% endfor %}
    // -- Spawning -------------------------------------------------------------

    private void SpawnPeds()
    {
{% for ped in peds %}
{% if ped.model != "UNRESOLVED" %}
        // {{ ped.role }}: {{ ped.model }}
        for (int i = 0; i < {{ ped.count }}; i++)
        {
{% if ped.abs_x is not none %}
            // Exact placement from the Mission Editor (extra copies fan out slightly).
            var pos = new Vector3({{ "%.2f"|format(ped.abs_x) }}f, {{ "%.2f"|format(ped.abs_y) }}f, {{ "%.2f"|format(ped.abs_z) }}f)
                      + new Vector3(i * 2.5f, i * 1.5f, 0f);
{% else %}
            var pos = SpawnOrigin + new Vector3({{ "%.1f"|format(ped.base_x) }}f + i * 2.5f,
                                               {{ "%.1f"|format(ped.base_y) }}f + i * 1.5f, 0f);
{% endif %}
            var p = World.CreatePed(new Model("{{ ped.model }}"), pos);
            if (p == null) continue;
            p.IsPersistent = true;
{% if ped.heading is not none %}
            p.Heading = {{ "%.1f"|format(ped.heading) }}f;
{% endif %}
{% if ped.health != 100.0 %}
            p.Health = {{ ped.health|round|int }};
{% endif %}
{% if ped.armor > 0.0 %}
            p.ArmorFloat = {{ "%.1f"|format(ped.armor) }}f;
{% endif %}
{% if ped.weapon_name %}
            // GET_HASH_KEY resolves any weapon string at runtime, including DLC weapons.
            // Split into a local to avoid parser ambiguity with nested generic calls.
            { int _wh = Function.Call<int>(Hash.GET_HASH_KEY, "{{ ped.weapon_name }}");
              Function.Call(Hash.GIVE_WEAPON_TO_PED, p, _wh, {{ ped.ammo }}, false, true); }
{% endif %}
{% if ped.patrol_path_idx is not none %}
            // Patrol path binding — drive the editor-authored route state.
            {
                var _path = EditorPathByIndex({{ ped.patrol_path_idx }});
                if (_path != null && _path.Length > 0)
                {
                    p.Task.RunTo(_path[0], true);
                    _patrols.Add(new PatrolUnit {
                        Ped = p, Path = _path, Mode = PatrolRouteMode.{{ editor_paths[ped.patrol_path_idx].mode_cs }},
                        State = PatrolRouteState.Moving, Wp = 0, Dir = 1 });
                }
            }
{% elif ped.is_hostile %}
            // CanUseCover + CombatAbility must be set BEFORE Task.Combat starts
            // the AI — GTA V's own combat task already seeks cover once these
            // are on, so this is the whole "cover" behavior for this backend.
            p.SetCombatAttribute(CombatAttributes.CanUseCover, true);
            p.CombatAbility = CombatAbility.Average;
            p.Task.Combat(Game.Player.Character);
{% elif ped.role == "ally" %}
            // TaskInvoker.FollowToOffsetOfEntity removed in 3.9 — use native directly
            Function.Call(Hash.TASK_FOLLOW_TO_OFFSET_OF_ENTITY,
                p, Game.Player.Character, 1.0f, -1.0f, 0.0f, 2.0f, -1, 1.0f, true);
{% elif ped.role == "guard" %}
            p.Task.GuardCurrentPosition();
{% elif ped.role == "patrol" %}
            p.Task.WanderAround();
{% endif %}
            _peds.Add(p);
        }
{% endif %}
{% endfor %}
    }

    private void SpawnVehicles()
    {
{% for v in vehicles %}
{% if v.model != "UNRESOLVED" and not v.is_race_opponent %}
        // {{ v.role }}: {{ v.model }}
        for (int i = 0; i < {{ v.count }}; i++)
        {
{% if v.abs_x is not none %}
            var pos = new Vector3({{ "%.2f"|format(v.abs_x) }}f, {{ "%.2f"|format(v.abs_y) }}f, {{ "%.2f"|format(v.abs_z) }}f)
                      + new Vector3(i * 7f, 0f, 0f);
{% else %}
            var pos = SpawnOrigin + new Vector3({{ "%.1f"|format(v.base_x) }}f + i * 7f,
                                               {{ "%.1f"|format(v.base_y) }}f, 0f);
{% endif %}
            var veh = World.CreateVehicle(new Model("{{ v.model }}"), pos);
{% if v.heading is not none %}
            if (veh != null) veh.Heading = {{ "%.1f"|format(v.heading) }}f;
{% endif %}
            if (veh != null) _vehicles.Add(veh);
        }
{% elif v.model != "UNRESOLVED" and v.is_race_opponent %}
        // race_opponent: {{ v.model }} — spawns with AI driver
        for (int i = 0; i < {{ v.count }}; i++)
        {
            var rpos = SpawnOrigin + new Vector3({{ "%.1f"|format(v.base_x) }}f + i * 8f,
                                                {{ "%.1f"|format(v.base_y) }}f + i * 4f, 0f);
            var rveh = World.CreateVehicle(new Model("{{ v.model }}"), rpos);
            if (rveh == null) continue;
            _vehicles.Add(rveh);
            // Spawn AI driver and start driving toward first race checkpoint
            // PedHash.Business01AMM is a known-valid generic civilian in SHVDN3 3.9.0
            var rdriver = World.CreatePed(PedHash.Business01AMM, rpos);
            if (rdriver == null) continue;
            rdriver.IsPersistent = true;
            rdriver.SetIntoVehicle(rveh, VehicleSeat.Driver);
{% if race_checkpoints %}
            // Register the rival so UpdateRivals() can re-path it around the full
            // circuit every tick (one-shot DriveTo only reaches the first point).
            // SHVDN3 3.9.0: DriveTo(Vehicle, Vector3, radius, VehicleDrivingFlags, speed)
            rdriver.Task.DriveTo(rveh, {{ race_checkpoints[0].array_name }}[0],
                5f, (VehicleDrivingFlags)786603, AiSpawnSpeedFor(_aiDifficultyIdx));
            _rivalDrivers.Add(rdriver);
            _rivalCp.Add(0);
{% endif %}
            _peds.Add(rdriver);
        }
{% endif %}
{% endfor %}
    }
