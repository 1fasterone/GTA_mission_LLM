  "scripts": [
    {
      "name": "PlayerController",
      "type": "player",
      "description": "Handles third-person movement, parkour traversal (wall-run, vault), and vehicle switching.",
      "attach_to": "player"
    },
    {
      "name": "CameraManager",
      "type": "camera",
      "description": "Manages Cinemachine virtual cameras for third-person view and lock-on targeting modes."
    },
    {
      "name": "GameManager",
      "type": "game_manager",
      "description": "Central hub managing game state, scoring, lives, and scene transitions between districts."
    },
    {
      "name": "EnemyAI",
      "type": "enemy",
      "description": "Implements NavMesh agents with patrol, chase, and alert states for bounty targets.",
      "attach_to": "systems"
    },
    {
      "name": "BountyTracker",
      "type": "custom",
      "description": "Manages live contracts, tracking multiple bounties simultaneously with visual indicators.",
      "extra_usings": [
        "System.Collections.Generic",
        "UnityEngine"
      ],
      "extra_fields": [
        {
          "name": "_activeContracts",
          "type": "List<string>",
          "default": "new List<string>()"
        },
        {
          "name": "_targetTransforms",
          "type": "Dictionary<string, Transform>",
          "default": "new Dictionary<string, Transform>()"
        }
      ],
      "awake_extra": "",
      "update_extra": "var playerFSM = GameContext.Instance.Get<PlayerFSM>(); if (playerFSM != null) { foreach(var kvp in _targetTransforms) { var target = kvp.Value; float dist = Vector3.Distance(transform.position, target.position); if(dist < 10f && !kvp.Key.Contains(\"Active\")) { kvp.Key += \" Active\"; } } }",
      "fixed_update_extra": "",
      "extra_methods": []
    },
    {
      "name": "DialogueManager",
      "type": "custom",
      "description": "Handles in-world hologram events and switches ambient audio/sky colors on zone transitions.",
      "attach_to": "systems"
    },
    {
      "name": "DistrictManager",
      "type": "custom",
      "description": "Manages district-specific visual identity, lighting changes, and weather effects per zone.",
      "extra_usings": [
        "System.Collections.Generic",
        "UnityEngine"
      ],
      "extra_fields": [
        {
          "name": "_currentZone",
          "type": "string",
          "default": "\"Main\""
        },
        {
          "name": "_skyColor",
          "type": "Color",
          "default": "#0D0D1A"
        }
      ],
      "awake_extra": "",
      "update_extra": "",
      "fixed_update_extra": "",
      "extra_methods": [
        {
          "signature": "public void SwitchZone(string newZone)",
          "body": "_currentZone = newZone; var skyColor = GetSkyColor(newZone); _skyColor = skyColor; GameContext.Instance.Get<LightingDirector>()?.SetAmbientColor(_skyColor);"
        }
      ]
    },
    {
      "name": "VehicleController",
      "type": "custom",
      "description": "Controls rideable hoverbikes with physics-based steering and parkour traversal.",
      "extra_usings": [
        "System.Collections.Generic",
        "UnityEngine"
      ],
      "extra_fields": [
        {
          "name": "_hoverbikeRigidbody",
          "type": "Rigidbody",
          "default": "null"
        },
        {
          "name": "_isHovering",
          "type": "bool",
          "default": "false"
        }
      ],
      "awake_extra": "",
      "update_extra": "if (_hoverbikeRigidbody != null) { _hoverbikeRigidbody.velocity = Vector3.up * 0.5f; }",
      "fixed_update_extra": "",
      "extra_methods": []
    },
    {
      "name": "WeaponSystem",
      "type": "custom",
      "description": "Manages ranged and melee attack combos with cooldowns.",
      "attach_to": "player"
    }
  ],
  "story_beats": [
    {
      "id": "activation_first_boot",
      "label": "Activation: player boots up for the first time in an alley",
      "description": "Player awakens in a dark alley, receiving initial controls and mission briefing.",
      "trigger": "on_start"
    },
    {
      "id": "first_mark_contract",
      "label": "First Mark: player receives the first bounty contract",
      "description": "A hologram appears offering the first bounty contract in the district.",
      "trigger": "on_enter_zone"
    },
    {
      "id": "street_chase_market",
      "label": "Street Chase: player pursues mark through market crowds (on_enemy_death)",
      "description": "High-speed pursuit through crowded markets, engaging enemies and dodging obstacles.",
      "trigger": "manual"
    },
    {
      "id": "betrayal_handler_reveal",
      "label": "Betrayal: handler reveals the player is also a target",
      "description": "Critical plot twist where the handler's true intentions are revealed via timer.",
      "trigger": "on_timer"
    },
    {
      "id": "underground_escape_tunnel",
      "label": "Underground: player escapes into the tunnel district",
      "description": "Player flees into the dark underground tunnels to escape pursuit.",
      "trigger": "on_enter_zone"
    },
    {
      "id": "data_heist_corporate_tower",
      "label": "Data Heist: player steals identity files from corporate tower (on_pickup)",
      "description": "Stealth infiltration of the corporate tower to steal critical data.",
      "trigger": "manual"
    },
    {
      "id": "showdown_programmer",
      "label": "Showdown: final confrontation with the original programmer",
      "description": "Final boss battle against the original programmer in a high-tech arena.",
      "trigger": "manual"
    },
    {
      "id": "escape_skybridge_extraction",
      "label": "Escape: player reaches the sky-bridge extraction point",
      "description": "Player escapes to the rooftop skyway for final extraction and victory.",
      "trigger": "on_enter_zone"
    }
  ],
