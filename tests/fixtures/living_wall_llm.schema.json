      "name": "CascadeSystem",
      "type": "custom",
      "description": "Propagates wake events between neighboring handholds based on proximity noise thresholds.",
      "attach_to": "systems",
      "extra_usings": [
        "System.Collections.Generic"
      ],
      "extra_fields": [
        {
          "name": "wakeThreshold",
          "type": "float",
          "default": "5.0f",
          "header": null,
          "tooltip": null
        }
      ],
      "awake_extra": "",
      "update_extra": "foreach (var hold in HandholdGroup.GetComponentsInChildren<Handhold>()) { if (Vector3.Distance(transform.position, hold.transform.position) < wakeThreshold) hold.WakeUp(); }",
      "fixed_update_extra": "",
      "extra_methods": [],
      "atoms": []
    },
