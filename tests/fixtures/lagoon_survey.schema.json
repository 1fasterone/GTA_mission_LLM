  "platform": "pc",
  "locomotion": "swim",
  "render_pipeline": "URP",
  "unity_version": "6000.0",
  "color_space": "Linear",
  "visual_style": "stylized",
  "scenes": ["Lagoon", "MainMenu"],
  "features": ["cinemachine", "input_system"],
  "packages": [],
  "scripts": [
    {
      "name": "SwimController",
      "type": "player",
      "description": "Buoyancy-driven swim movement with fin kicks and a camera housing."
    },
