    {
      "name": "InputHandler",
      "type": "custom",
      "description": "Granular control mapping for track, delta, sit, and flare poses.",
      "attach_to": "player",
      "extra_usings": [
        "UnityEngine.InputSystem"
      ],
      "extra_fields": [
        {
          "name": "poseMode",
          "type": "string",
          "default": "\"track\"",
          "header": "Pose",
          "tooltip": null
        }
      ],
      "awake_extra": "",
      "update_extra": "if (Keyboard.current.aKey.wasPressedThisFrame) poseMode = \"sit\"; else if (Keyboard.current.dKey.wasPressedThisFrame) poseMode = \"flare\"; else if (Keyboard.current.sKey.wasPressedThisFrame) poseMode = \"delta\";",
