  "scripts": [
    {
      "name": "MaterialPalette",
      "type": "material_palette",
      "description": "Runtime SkyDivePalette palette manager \u2014 creates and caches materials from palette hex colors",
      "attach_to": "systems",
      "extra_usings": [],
      "extra_fields": [],
      "awake_extra": "",
      "update_extra": "",
      "fixed_update_extra": "",
      "extra_methods": [],
      "atoms": []
    },
    {
      "name": "PlayerController",
      "type": "custom",
      "description": "Handles body attitude manipulation, drag scaling relative to angle, and parachute inflation mechanics.",
      "attach_to": "player",
      "extra_usings": [
        "UnityEngine.InputSystem"
      ],
      "extra_fields": [
        {
          "name": "dragMultiplier",
          "type": "float",
          "default": "1.0f",
          "header": "Physics",
          "tooltip": null
        },
        {
          "name": "bodyAngle",
          "type": "float",
          "default": "0.0f",
          "header": "Attitude",
          "tooltip": null
        },
        {
          "name": "velocity",
          "type": "float",
          "default": null,
          "header": null,
          "tooltip": null
        }
      ],
      "awake_extra": "",
      "update_extra": "var input = Input.current; if (input != null) { var targetAngle = 0.0f; if (Keyboard.current.aKey.isPressed) targetAngle -= 5.0f; else if (Keyboard.current.dKey.isPressed) targetAngle += 5.0f; bodyAngle = Mathf.Lerp(bodyAngle, targetAngle, Time.deltaTime * 2.0f); var dragFactor = Mathf.Max(0.1f, 1.0f - (bodyAngle / 90.0f)); velocity *= dragFactor; }",
      "fixed_update_extra": "",
      "extra_methods": [],
      "atoms": []
    },
    {
      "name": "CameraManager",
      "type": "custom",
      "description": "Virtual rigging system to maintain spatial awareness between close-chase and wide-orbit views.",
      "attach_to": "camera",
      "extra_usings": [],
      "extra_fields": [
        {
          "name": "targetOffset",
          "type": "Vector3",
          "default": "new Vector3(0.0f, 2.0f, -5.0f)",
          "header": "Position",
          "tooltip": null
        },
        {
          "name": "zoomLevel",
          "type": "float",
          "default": "1.0f",
          "header": "Zoom",
          "tooltip": null
        }
      ],
      "awake_extra": "",
      "update_extra": "",
      "fixed_update_extra": "",
      "extra_methods": [],
      "atoms": [
        {
          "atom": "Follow",
          "args": {
            "target": "Player",
            "distance": 1.5,
            "speed": 5.0
          },
          "label": "chase player"
        }
      ]
    },
