{
  "project_name": "DropZoneArcade",
  "company_name": "AeroSky Studios",
  "description": "A high-fidelity third-person arcade experience focused on vertical movement, body attitude manipulation, and precise parachute steering within a massive drop zone arena.",
  "game_type": "3D",
  "platform": "pc",
  "locomotion": "fly",
  "render_pipeline": "URP",
  "unity_version": "6000.0",
  "color_space": "Linear",
