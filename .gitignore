# ── Secrets & local config (NEVER commit) ───────────────────────────
# config.yaml holds local machine-specific settings — keep ignored.
.env
config.yaml
.ratings.json
.claude/settings.local.json

# ── Generated output & build artifacts ──────────────────────────────
# dist/ holds distro zips rebuilt by package.ps1; force a release into
# the repo with `git add -f dist/<file>.zip` if you ever want one tracked.
output/
dist/
# Playability eval run logs — regenerated by `python main.py unity-eval`. The
# CASES and their locked floors are tracked; the run output is not.
evals/playability/_runs/

# ── Unity package cache (regenerable via `unity-package-cache fill`) ─
# Verbatim copies of packages.unity.com tarballs, ~1.4 GB for the default
# feature set. Redistributing them is Unity's business, not this repo's.
cache/unity_packages/

# ── RAG ontology corpus + index (regenerable, do not commit) ─────────
# Rebuild with: python -m rag.build
# Index with:   python -m rag.indexer  (Phase 2)
rag/corpus/
rag/index/

# ── Sketchfab live fetch cache (regenerable via `sketchfab-fetch`, per-
# developer/per-project opt-in with a personal API token — unlike the
# curated CC0 Kenney library in Models/, don't commit ad-hoc CC-BY/-SA
# third-party downloads) ─────────────────────────────────────────────
Models/Sketchfab/
lookups/unity/sketchfab_catalog.json

# ── Salvaged generation exports (personal dev artifacts pulled out of a
# throwaway project via `unity-salvage` before deleting it — not repo content)
salvage/

# ── Scratch / redirected logs ───────────────────────────────────────
err.txt
out.txt
*.log

# ── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Node (webui frontend tooling, if any) ───────────────────────────
node_modules/

# ── Editors / IDEs ──────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── OS junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── C# syntax-gate build output (regenerated on first use) ──────────
tools/csharp_syntax_gate/bin/
tools/csharp_syntax_gate/obj/

# ── Personal/experimental drops (not repo content) ───────────────────
Models/FBX format/cromulon/
Models/FBX format/molnia-track/
Models/FBX format/molnia/
Models/FBX format/monaco/
prompts/Gigantinut.txt
prompts/New Text Document.txt
prompts/grandma.txt
prompts/grandmas_antique_shop.txt
prompts/molnia-drag-race.txt
prompts/newring.txt
reviews/
