{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/py_lint.py\"",
            "timeout": 120,
            "statusMessage": "ruff + mypy on edited file"
          }
        ]
      }
    ]
  }
}
