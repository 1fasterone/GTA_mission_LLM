# Copy to `.env` and fill in your own values. Do NOT commit `.env`.
# AnythingLLM is OPTIONAL (RAG asset lookup); leave the key blank to run in
# local-lookup / Basic Mode.
ANYTHINGLLM_API_KEY=
ANYTHINGLLM_BASE_URL=http://localhost:3001
LM_STUDIO_BASE_URL=http://localhost:1234/v1
# Sketchfab is OPTIONAL (sketchfab.enabled: false in config.yaml by default).
# Wins over config.yaml's sketchfab.api_token — never commit a real token.
SKETCHFAB_API_TOKEN=
